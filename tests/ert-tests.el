;;; ert-tests.el --- Regression tests for emacs-config -*- lexical-binding: t; -*-

;; Every test here is a bug that WAS LIVE in this config and is now fixed, or a
;; property that was silently false and is now enforced.  Each carries the issue
;; that introduced the case.
;;
;; WHY THIS EXISTS
;; ---------------
;; The config accumulated defects that no tooling could see, and the reason is
;; uniform: they were *silent*.  `C-c B' corrupted every Hebrew buffer in the
;; session and announced "Bidi: OFF".  `treesit-auto' discarded unsaved changes
;; behind a y/n prompt.  `05-org' replaced `org-latex-packages-alist' wholesale
;; while `02-hebrew-org' added to it, and only a filename digit kept that
;; working.  A byte-compile passes over all of it; `check-modules.sh' passes over
;; all of it.  Neither can see a wrong value or a wrong owner.
;;
;; So this is not coverage for coverage's sake.  Each test is a question that was
;; once unanswerable and now has an answer.
;;
;; NOTE ON STYLE
;; -------------
;; `should' and `should-not' in this Emacs take exactly ONE argument -- there is
;; no failure-message parameter.  The two-argument form fails to macro-expand
;; with "wrong-number-of-arguments (1 . 1) 2".  Failure context is carried in the
;; test name and the file comment instead, so a red run names the property that
;; broke rather than restating the assertion.
;;
;; RUN
;; ---
;;   tools/test.sh                 # all suites
;;   tools/test.sh hebrew bidi     # only tests matching these strings

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'subr-x)

(defconst ert-tests/module-root
  (file-name-as-directory
   (expand-file-name
    "../modules/"
    (file-name-directory (or load-file-name buffer-file-name))))
  "Directory holding the module groups.")

(defun ert-tests/load-modules (&optional groups)
  "Put GROUPS on the load-path and load their modules in filename order.
Groups default to (\"essentials\" \"extras\"), the order init.el uses.

ox-latex is required up front because `org-latex-class' and
`org-latex-classes' only exist once the backend is loaded, and 02-hebrew-org
reaches them through use-package's :hook machinery rather than at load time."
  (require 'ox)
  (require 'ox-latex)
  (let ((groups (or groups '("essentials" "extras"))))
    (dolist (g groups)
      (add-to-list
       'load-path
       (file-name-as-directory (expand-file-name g ert-tests/module-root))))
    (dolist (g groups)
      (dolist (f (directory-files (expand-file-name g ert-tests/module-root) t
                                  "\\`[0-9].*\\.el\\'"))
        (unless (string-suffix-p ".elc" f)
          (load (file-name-sans-extension f) nil t))))))

(defun ert-tests/module-source (name)
  "Return the text of module NAME, read from the tree.
NAME may be bare (\"01-ui\") or group-qualified (\"essentials/01-ui\"); bare names
are looked for in every group, in load order, so a test does not have to know
which half a module ended up in."
  (let* ((parts (string-split name "/"))
         (file (if (= (length parts) 2)
                   (format "%s/%s.el" (car parts) (cadr parts))
                 (format "%%s/%s.el" name)))
         (found (seq-some
                 (lambda (g)
                   (let ((f (expand-file-name (format file g)
                                             ert-tests/module-root)))
                     (and (file-exists-p f) f)))
                 '("essentials" "extras"))))
    (unless found
      (ert-fail (format "no module named %s under %s" name ert-tests/module-root)))
    (with-temp-buffer
      (insert-file-contents found)
      (buffer-string))))

(defun ert-tests/mentions-p (name needle)
  "Non-nil if module NAME's source mentions NEEDLE."
  (let ((case-fold-search t))
    (and (string-match-p needle (ert-tests/module-source name)) t)))

;; ═══════════════════════════════════════════════════════════════════════════
;; Suite: ownership -- one layer owns one fact
;;
;; This class did the most damage and is the least visible.  Load order decided
;; every conflict; a rename or a digit change silently moved the outcome.  #47.
;; ═══════════════════════════════════════════════════════════════════════════

(defgroup ert-ownership nil "One owner per fact." :group 'ert)

(ert-deftest ownership-default-face-is-not-written-by-01-ui nil
  "01-ui must not write the `default' face.
01-ui set family and height, then 99-local-fonts -- generated by nixos-config,
NOT present in this repo -- overwrote both.  Worse, the portable list named
\"JetBrains Mono\", which is not installed here, so it chose DejaVu at height 90
and was then corrected by a file nobody in this repo can read.  #48."
  (ert-tests/load-modules '("essentials"))
  (should-not
   (ert-tests/mentions-p "01-ui" "(set-face-attribute 'default")))

(ert-deftest ownership-pick-font-survives-the-default-face-change nil
  "my/pick-font must still exist after the default face moved out of 01-ui.
extras/00-hebrew uses it to choose the Hebrew fontset, so deleting it with the
default-face block would have broken Hebrew fonts silently."
  (ert-tests/load-modules '("essentials"))
  (should (fboundp 'my/pick-font)))

(ert-deftest ownership-17-terminal-does-not-own-the-tab-strip nil
  "17-terminal must not enable tab-line-mode.
It armed tab-line-mode from shell-mode-hook, so opening a terminal replaced the
workspace tab-bar mid-session.  Unlike every other ownership conflict this one
was LIVE, because a mode hook fires long after load.  #49."
  (ert-tests/load-modules '("essentials"))
  (should-not (ert-tests/mentions-p "17-terminal" "tab-line-mode")))

(ert-deftest ownership-latex-package-list-is-additive nil
  "org-latex-packages-alist must contain fontspec, babel, bigfoot and enumitem.
05-org did (setq org-latex-packages-alist '((\"\" \"fontspec\" t))) -- replacing
the whole list -- while extras/02-hebrew-org add-to-list'd the rest on top of
it.  Correct only because 05 sorts before 02; Hebrew export silently loses its
font if that digit ever changes.  #37 and #47."
  (ert-tests/load-modules)
  (should (assq "" org-latex-packages-alist))
  (should (cl-some (lambda (p) (equal (cadr p) "babel")) org-latex-packages-alist))
  (should (cl-some (lambda (p) (equal (cadr p) "bigfoot")) org-latex-packages-alist))
  (should (cl-some (lambda (p) (equal (cadr p) "enumitem")) org-latex-packages-alist)))

(ert-deftest ownership-00-core-does-not-reset-read-process-output-max nil
  "00-core must not set read-process-output-max itself.
early-init sets it to 4 MiB; 00-org set it back to 1 MiB.  Emacs' own default is
64 KiB, so the sequence was 64 KiB -> 4 MiB -> 1 MiB, and for an LSP client
streaming publishDiagnostics that is 4x the read events per response.  #12."
  (should-not
   (string-match-p "(setq[^\n]*read-process-output-max"
                   (ert-tests/module-source "00-core"))))

;; ═══════════════════════════════════════════════════════════════════════════
;; Suite: buffer-locality -- setq where setq-local was meant
;;
;; Both bugs were invisible from the buffer you acted in, and both were
;; announced by a cheerful message.
;; ═══════════════════════════════════════════════════════════════════════════

(defgroup ert-bidi nil "Bidi state must not leak between buffers." :group 'ert)

(ert-deftest bidi-display-reordering-is-not-buffer-local nil
  "bidi-display-reordering is genuinely NOT buffer-local in Emacs 30.
This pins the fact the fix depends on.  If a future Emacs makes it
buffer-local, my/toggle-bidi-reordering's setq would become correct by accident
and this guard is what tells us the setq-local is no longer needed.  #32."
  (skip-unless (boundp 'bidi-display-reordering))
  (should-not (local-variable-p 'bidi-display-reordering)))

(ert-deftest bidi-toggle-does-not-change-the-global-default nil
  "my/toggle-bidi-reordering must not alter the global default.
C-c B used (setq bidi-display-reordering ...) on a variable that is not
buffer-local, so one keystroke in one buffer made every other Hebrew buffer in
the session render in logical order.  #32."
  (ert-tests/load-modules '("extras"))
  (let ((buf (generate-new-buffer "ert-bidi-victim"))
        (before (default-value 'bidi-display-reordering)))
    (unwind-protect
        (with-current-buffer buf
          (setq-local bidi-display-reordering t)
          (my/toggle-bidi-reordering))
      (should (eq (default-value 'bidi-display-reordering) before))
      (kill-buffer buf))))

;; ═══════════════════════════════════════════════════════════════════════════
;; Suite: data safety -- nothing may discard unsaved work unattended
;; ═══════════════════════════════════════════════════════════════════════════

(defgroup ert-safety nil "Unattended data loss." :group 'ert)

(ert-deftest safety-auto-save-is-enabled nil
  "auto-save and lockfiles must both be non-nil.
All three were off against Emacs' t/t/t defaults.  A crash loses every unsaved
buffer, and a font-rendering SIGSEGV is already on the record.  #38."
  (ert-tests/load-modules '("essentials"))
  (should auto-save-default)
  (should create-lockfiles))

(ert-deftest safety-treesit-does-not-prompt-to-install nil
  "treesit-auto-install must not be 'prompt.
Its install path runs (revert-buffer nil t) -- noconfirm = t -- so opening a
file, typing, and answering y to \"install this grammar?\" discards the typing.
On any non-Nix machine missing a grammar, which is the portable case this
config targets.  #35."
  ;; Asserted on the SOURCE, not the live value: 08-typst configures treesit-auto
  ;; through use-package's :config, which defers until the package is actually
  ;; loaded -- so treesit-auto-install is legitimately void in a batch test that
  ;; never opens a file.  Reading the source is what this property actually is:
  ;; a value in the tree, not a value in a session.
  (let ((case-fold-search t))
    (should-not
     (string-match-p "(setq[ \t\n]+treesit-auto-install[ \t\n]+'prompt"
                     (ert-tests/module-source "08-typst")))
    (should
     (string-match-p "(setq[ \t\n]+treesit-auto-install[ \t\n]+nil"
                     (ert-tests/module-source "08-typst")))))

;; ═══════════════════════════════════════════════════════════════════════════
;; Suite: capability gating -- no hook without a capability test
;;
;; The config's own stated rule, init.el:185: gate on CAPABILITY, not operating
;; system.  12-programming never applied it.
;; ═══════════════════════════════════════════════════════════════════════════

(defgroup ert-capability nil "Per-mode features are gated on the tool." :group 'ert)

(ert-deftest capability-java-is-not-hooked-twice nil
  "java-mode-hook must not carry eglot-ensure.
Two conflicting hooks.  eglot-ensure errors during find-file when jdtls is
absent, and run-hooks aborts on the first error, so eglot-java-mode never ran
either.  With jdtls present, eglot-java-mode ran eglot-java--ensure inside the
hook and did a synchronous ~100MB download that switch-to-buffers a tar file
mid-find-file.  #31."
  (ert-tests/load-modules '("essentials"))
  (should-not
   (assq 'eglot-ensure (and (boundp 'java-mode-hook) java-mode-hook))))

(ert-deftest capability-eglot-java-is-gated-on-the-binary nil
  "12-programming must gate eglot-java with an executable-find.
Without the gate, eglot-java--ensure downloads ~100MB synchronously inside the
mode hook.  #31."
  (should (ert-tests/mentions-p "12-programming" ":if (executable-find")))

(ert-deftest capability-rustfmt-is-gated nil
  "rust-format-on-save must not be on without rustfmt installed.
Every save of a .rs file signalled \"rustfmt: command not found\".  #39."
  (ert-tests/load-modules '("essentials"))
  (when (and (boundp 'rust-format-on-save) rust-format-on-save)
    (should (executable-find "rustfmt"))))

;; ═══════════════════════════════════════════════════════════════════════════
;; Suite: exporting -- Hebrew Org must produce a PDF
;;
;; This guards the regression that blocked real work: an 8-level, 239-footnote
;; shiur that would not compile.
;; ═══════════════════════════════════════════════════════════════════════════

(defgroup ert-export nil "Hebrew Org -> LaTeX." :group 'ert)

(ert-deftest export-article-hebrew-declares-font-and-list-depth nil
  "The class must declare a Hebrew font, raise list depth, and robustify footnote.
It was registered but never SELECTED -- no .org file carried #+LATEX_CLASS, so
Org exported plain article with no Hebrew font at all.  #33."
  (ert-tests/load-modules)
  (should (assoc "article-hebrew" org-latex-classes))
  (let ((tmpl (nth 1 (assoc "article-hebrew" org-latex-classes))))
    (should (string-match-p "\\\\babelfont" tmpl))
    (should (string-match-p "renewlist" tmpl))
    (should (string-match-p "robustify" tmpl))))

(ert-deftest export-hebrew-buffers-default-to-the-hebrew-class nil
  "A Hebrew buffer with no explicit class must get article-hebrew.
Verified against a real document: before, the exported .tex contained no
\\babelfont line at all and bold Hebrew died as \"Missing character: There is
no (U+05D4) in font ec-lmbx10\".  #33.

Asserted through the hook's return value rather than by reading
`org-latex-class': that is an org EXPORT OPTION (ox-latex.el:123), not a
variable -- it is bound per-export and is void outside one, so reading it here
was always going to be a void-variable error."
  (ert-tests/load-modules)
  (with-temp-buffer
    (org-mode)
    (insert "* " (string #x05E0 #x05D1 #x05DC #x05D8 #x05D9 #x05DD) "\n")
    (should (eq (my/org--default-latex-class 'latex) t))))

(ert-deftest export-english-buffers-are-not-forced-to-hebrew nil
  "A buffer with no Hebrew must keep Org's own default class.
The auto-selection must not capture English documents.  This is #41's bug in
reverse: every prose mode was forced RTL unconditionally."
  (ert-tests/load-modules)
  (with-temp-buffer
    (org-mode)
    (insert "* Plain English heading\n")
    (should-not (my/org--default-latex-class 'latex))))

(ert-deftest export-non-latex-backends-are-untouched nil
  "The class hook must fire only for the LaTeX backend."
  (ert-tests/load-modules)
  (with-temp-buffer
    (org-mode)
    (insert "* " (string #x05E9 #x05DC #x05D5 #x05DD) "\n")
    (should-not (my/org--default-latex-class 'html))))

;; ═══════════════════════════════════════════════════════════════════════════
;; Suite: niqqud -- the search that is the whole point
;; ═══════════════════════════════════════════════════════════════════════════

(defgroup ert-niqqud nil "Niqqud-insensitive search over pointed text." :group 'ert)

;; Built from codepoints, not literals.  Hebrew in a source file is ambiguous to
;; read (vowel points and final forms are visually near-identical), so a failing
;; assertion here should be reproducible from the numbers alone.
(defconst ert-niqqud/unpointed (string #x05D7 #x05DC #x05E7 #x05D5)
  "HALAM-LAMED-QOF-VAV, spelled חלקו with no vowel points.")

(defconst ert-niqqud/pointed
  (string #x05D7 #x05B0              ; HET + SHEVA
          #x05DC #x05B3              ; LAMED + HIRIQ
          #x05E7 #x05B8              ; QOF + QAMATS
          #x05D5 #x05BC)             ; VAV + DAGESH/holam
  "The same four letters, each carrying one niqqud point.

Every codepoint here is inside U+0591-U+05C7, which is the whole Hebrew
combining block except U+05BE (maqaf, a punctuation mark, not a point).  Building
this from numbers rather than literals matters: Hebrew points are visually
indistinguishable in most terminals, so a literal makes a failing assertion
unreproducible.  An earlier version of this test used U+05D0 by mistake -- a
Hebrew SYMBOL, not a point -- and failed against correct code.")

(ert-deftest niqqud-unpointed-query-matches-pointed-text nil
  "An unpointed query must match pointed text.
C-c s over 29,040 footnotes in the real library depends on this.  It is the
best code in the repo and among the easiest things to break."
  (ert-tests/load-modules)
  (let ((case-fold-search t))
    (should (string-match-p (seforim--inject-niqqud ert-niqqud/unpointed)
                            ert-niqqud/pointed))))

(ert-deftest niqqud-pointed-query-matches-unpointed-text nil
  "Pointed text pasted into the query must still work.
seforim--inject-niqqud drops niqqud already present in the pattern before
re-inserting the optional class, so C-c s accepts a copied pointed fragment."
  (ert-tests/load-modules)
  (let ((case-fold-search t))
    (should (string-match-p (seforim--inject-niqqud ert-niqqud/pointed)
                            ert-niqqud/unpointed))))

(ert-deftest niqqud-isearch-is-bound-inside-the-library nil
  "C-c s must reach seforim-isearch-forward wherever seforim-mode is on.
Bound in extras/13-seforim-extras and auto-enabled from find-file-hook for files
under the library base.

Asserted the way a user reaches it -- `key-binding' on C-c s in a buffer with the
mode on -- rather than by inspecting the keymap.  Two wrong turns are recorded
because the next reader will have them too:

  - `seforim-inbuffer-niqqud-key' holds the string \"s\", NOT \"C-c s\".
    `(kbd \"C-c s\")' is (kbd \"C-c\") concatenated with \"s\", and `C-c' is a
    prefix, so the defcustom value is just the final key.
  - The binding is NOT on global-map, NOT on `seforim-mode''s `mode-keymap'
    property (nil), and NOT reachable via `current-local-map' in a buffer whose
    major mode sets no local map (also nil).  Chasing those three is how an
    earlier version of this test failed against entirely correct code."
  (ert-tests/load-modules)
  (with-temp-buffer
    (fundamental-mode)
    (seforim-mode 1)
    (should (eq seforim-mode t))
    (should (eq (key-binding (kbd "C-c s")) #'seforim-isearch-forward))))

;; ═══════════════════════════════════════════════════════════════════════════
;; Suite: hygiene -- invariants about the tree itself
;; ═══════════════════════════════════════════════════════════════════════════

(defgroup ert-hygiene nil "Properties the module tree must have." :group 'ert)

(ert-deftest hygiene-all-modules-load-cleanly nil
  "Every module must load without error, in load order.
The failure this config already suffered once: 1,569 seforim lines stopped
loading after a renumber and nothing said so.  #6.

init.el's `my/load-errors' is deliberately not consulted: it is set by the
loader, which a batch test does not run.  Asserting on it here would test init.el,
not the modules."
  (condition-case err
      (ert-tests/load-modules)
    (error (ert-fail (error-message-string err)))))

(ert-deftest hygiene-no-stale-byte-compiled-modules nil
  "No .elc in the tree may be newer than the .el it came from, and none may be orphaned.
A stale .elc is preferred by `load' over the .el, so a module silently runs old
code.  This bit for real: an 18-tabs.elc left over from an earlier tangle made
23-hydras fail with (void-variable hydra-tabs) while byte-compiling and
check-modules.sh both passed over it.  Nix builds do not hit this -- the store is
rebuilt from the git tree -- but a writable checkout does, and that is every
portable install.  #6."
  (dolist (g '("essentials" "extras"))
    (dolist (el (directory-files (expand-file-name g ert-tests/module-root) t
                                 "\\.elc\\'"))
      (let ((src (file-name-sans-extension el)))
        (should (file-exists-p src))
        (when (file-exists-p src)
          (should-not (file-newer-than-file-p el src)))))))

(defun ert-tests/provided-feature (file)
  "Return the feature FILE's (provide 'x) form names, in order."
  (with-temp-buffer
    (insert-file-contents file)
    (goto-char (point-min))
    (let ((out))
      (while (re-search-forward "^([ \t]*)(provide '\\([A-Za-z0-9_-]+\\)" nil t)
        (push (match-string 2) out))
      (nreverse out))))

(ert-deftest hygiene-no-module-provides-the-same-feature-twice nil
  "No two modules may provide the same feature.
check-modules.sh enforces this statically; this asserts it at runtime, where a
stale .elc or a shadowed store path could still smuggle one in.

Anchored at line start with a `match-string 2' capture.  An earlier version
read (match-string 1 (buffer-string)) over an unanchored regex, which also
matched `(provide ...` inside ert-deftest bodies and hydra key tables -- and
reported a phantom duplicate of `nil' that does not exist."
  (ert-tests/load-modules)
  (let ((seen (make-hash-table :test #'equal))
        dup)
    (dolist (g '("essentials" "extras"))
      (dolist (f (directory-files (expand-file-name g ert-tests/module-root) t
                                  "\\`[0-9].*\\.el\\'"))
        (unless (string-suffix-p ".elc" f)
          (dolist (feat (ert-tests/provided-feature f))
            (when (gethash feat seen)
              (push (list feat f (gethash feat seen)) dup))
            (puthash feat f seen)))))
    (should-not dup)))

(provide 'ert-tests)
;;; ert-tests.el ends here