## 2️⃣ `seforim.el`

Save this as `~/.config/seforim/seforim.el` (or tangle it from an Org file if you prefer).
It assumes the packages listed in the flake are available.

```elisp
;;; seforim.el --- Seforim library integration for Emacs  -*- lexical-binding: t; -*-

;; ----------------------------------------------------------------------
;; 0.  User‑configurable variables
;; ----------------------------------------------------------------------
(defvar my/seforim-directory "~/Documents/seforim/"
  "Root directory of the hierarchical seforim library.")
;; Make sure the directory exists (no‑op if it already does)
(unless (file-exists-p my/seforim-directory)
  (make-directory my/seforim-directory t))

;; ----------------------------------------------------------------------
;; 1.  Tweak consult so we don’t start a search after a single keystroke
;; ----------------------------------------------------------------------
(with-eval-after-load 'consult
  (setq consult-async-min-input 3)          ; wait for ≥3 chars
  (setq consult-async-refresh-delay 0.2)   ; small debounce while typing)

;; ----------------------------------------------------------------------
;; 2.  File‑path search – plocate (fallback to fd)
;; ----------------------------------------------------------------------
(defun my/seforim-find-sefer ()
  "Fuzzy‑find a sefer file anywhere in the hierarchy.
   Uses `plocate` for instantaneous name look‑ups; falls back to `fd`."
  (interactive)
  (let* ((default-directory my/seforim-directory)
         (plocate-cmd (format "plocate --regex --limit 0 --null '%s'"
                              ;; Empty pattern → list everything under $PWD
                              "")))
    (cond
     ((executable-find "plocate")
      (consult-find :command plocate-cmd))
     (t
      ;; Fallback to your existing fd‑based path search
      (consult-find)))))

;; ----------------------------------------------------------------------
;; 3.  notmuch‑based full‑text search
;; ----------------------------------------------------------------------
(defun my/seforim-notmuch-ensure-indexed ()
  "Run `notmuch new` if the index looks stale.
   Called automatically the first time you search."
  (when (not (file-exists-p (expand-file-name "~/.notmuch/config")))
    (error "Notmuch not configured. Run `notmuch setup` first."))
  (let ((db-age   (nth 5 (file-attributes (expand-file-name "~/.notmuch/xapian"))))
        (newest-age (apply 'max
                           (mapcar (lambda (f) (nth 5 (file-attributes f)))
                                   (directory-files-recursively
                                    my/seforim-directory ".*\\.org\\'")))))
    (when (or (< db-age 0) (< db-age newest-age))
      (notmuch new)
      (notmuch tag +seforim -- path:my/seforim-directory/*)
      (message "Seforim re‑indexed with notmuch"))))

(defun my/seforim-search-all ()
  "Full‑text search across ALL seforim using notmuch.
   Returns **every** match (no artificial caps)."
  (interactive)
  (my/seforim-notmuch-ensure-indexed)
  (notmuch-search "tag:seforim"))

(defun my/seforim-search-current-dir ()
  "Search text limited to the directory containing the current buffer.
   Falls back to a plain `rg` scan if the buffer is not visiting a file."
  (interactive)
  (if buffer-file-name
      (let* ((dir (file-name-directory buffer-file-name))
             ;; Make the path relative to the maildir root so we can use the
             ;; `path:` field that notmuch understands.
             (rel (replace-regexp-in-string
                   (format "^%s/" my/seforim-directory) "" dir)))
        (my/seforim-notmuch-ensure-indexed)
        (notmuch-search (format "tag:seforim path:%s" rel)))
    (message "Not visiting a file!")))

;; ----------------------------------------------------------------------
;; 4.  Outline navigation (uses consult-outline)
;; ----------------------------------------------------------------------
(defun my/seforim-outline ()
  "Jump to a specific Perek/Pasuk/Mishnah in the current sefer."
  (interactive)
  (consult-outline))

;; ----------------------------------------------------------------------
;; 5.  Dired sidebar (tree view) – unchanged from your original setup
;; ----------------------------------------------------------------------
(use-package dired-sidebar
  :bind (("C-x C-n" . dired-sidebar-toggle-sidebar))
  :config  (push 'toggle-window-split dired-sidebar-toggle-hidden-commands)
  (push 'toggle-narrow-to-defun dired-sidebar-toggle-hidden-commands)
  (setq dired-sidebar-theme 'all-the-icons)
  (setq dired-sidebar-use-term-integration t)
  (setq dired-sidebar-use-custom-font t))

;; Optional: make the sidebar a bit cleaner
(with-eval-after-load 'dired-sidebar
  (add-hook 'dired-sidebar-mode-hook
            (lambda ()
              (display-line-numbers-mode -1)
              (setq-local dired-hide-details-hide-symlink-targets t))))

;; ----------------------------------------------------------------------
;; 6.  Helper to open the tree sidebar + dired at the root
;; ----------------------------------------------------------------------
(defun my/seforim-browse-tree ()
  "Open standard dired at the seforim root, and pop open the tree sidebar."
  (interactive)
  (dired my/seforim-directory)
  (unless (dired-sidebar-showing-sidebar-p)
    (dired-sidebar-toggle-sidebar)))

;; ----------------------------------------------------------------------
;; 7.  Seforim Hydra (C-c S)
;; ----------------------------------------------------------------------
(defhydra hydra-seforim (:color blue :hint nil)
  "   Seforim Library (RTL: %`bidi-paragraph-direction)
   _f_: Find Sefer (plocate → fd)   _o_: Outline (Chapters/Pesukim)
   _s_: Search Text (All Seforim)  _d_: Search Text (Current Dir)
   _t_: Open Tree Sidebar         _b_: Browse in Dired   _q_: quit                       "
  ("f" my/seforim-find-sefer)
  ("s" my/seforim-search-all)
  ("d" my/seforim-search-current-dir)
  ("o" my/seforim-outline)
  ("t" dired-sidebar-toggle-sidebar)
  ("b" my/seforim-browse-tree)
  ("q" nil))

;; Bind to C-c S (Shift‑S) – leaves C-c s free for your spell‑check hydra
(global-set-key (kbd "C-c S") 'hydra-seforim/body)

;; ----------------------------------------------------------------------
;; 8.  (Optional) Keep notmuch index near‑real‑time on save;; ----------------------------------------------------------------------
;; Uncomment the following block if you want the index updated after
;; every save of a seforim file.  It adds ~30‑50 ms to each save.
;; (add-hook 'after-save-hook
;;           (lambda ()
;;             (when (and buffer-file-name;;                        (string-prefix-p my/seforim-directory buffer-file-name))
;;               (notmuch insert (expand-file-name buffer-file-name))
;;               (notmuch tag +seforim --
;;                          --id:(notmuch-message-id (expand-file-name buffer-file-name))))))

(provide 'seforim)
;;; seforim.el ends here
```

### How to use it

| Keybinding | Action |
|------------|--------|
| `C-c S f` | Fuzzy‑find a sefer by name/path (uses `plocate`, falls back to `fd`). |
| `C-c S s` | Full‑text search across the whole library (notmuch). Type `אברהם`, `path:rambam/ אברהם`, `-path:Drafts/ אברהם`, etc. |
| `C-c S d` | Search only in the directory of the currently visited file (falls back to threaded `rg` if needed). |
| `C-c S o` | Jump to a heading/daf/siman via `consult-outline`. |
| `C-c S b` | Open `dired` at the seforim root and show the tree sidebar. |
| `C-c S t` / `C-x C-n` | Toggle the dired‑sidebar. |
| `C-c S q` | Quit the hydra. |

All searches respect `vertico`/`orderless`/`marginalia` (so you get live, filtered, annotated completion) and **never artificially cap** the result set – you can scroll through thousands of matches smoothly.

---

### What you still need to do manually (once)

1. **Create the seforim directory** (if it isn’t already there):
   ```bash
   mkdir -p ~/Documents/seforim
   # populate it with your .org files …
   ```

2. **Build the initial notmuch index** (the timer will do it daily, but you can jump‑start):
   ```bash
   notmuch new
   ```

3. **(Optional) Enable the notmuch timer** – the flake already creates a user‑level systemd timer that runs `notmuch new` once a day.
   To start it immediately:
   ```bash
   systemctl --user daemon-reload
   systemctl --user enable --now notmuch-seforim.timer
   ```

That’s it! You now have a fully Nix‑managed, lightning‑fast seforim lookup system that integrates perfectly with the Emacs editing environment you already love. Happy learning! 🚀
