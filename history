        echo \"    sudo nixos-rebuild switch --flake .#minimal\"
        echo \"\"
      '';
    };

    # Formatter for 'nix fmt'
    formatter.${system} = nixpkgs.legacyPackages.${system}.nixpkgs-fmt;
  };
