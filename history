  (define-key org-mode-map (kbd \"C-c f r\") #'my/insert-rich-footnote-org))
#+end_src" "* Rich Footnotes System

Full document capability inside footnotes: unlimited headings, lists, tables, nested footnotes.

** Documentation

*** Overview

This system provides rich content (headings, lists, tables) inside footnotes for:
- LaTeX (bigfoot + custom commands)
- Typst (native support)
- ConTeXt (native support)
- Org-mode (preprocessor converts to export format)
- Pandoc (via ox-pandoc)

*** Usage Quick Reference

| System  | Simple Footnote      | Rich Footnote                    |
|---------+----------------------+----------------------------------|
| LaTeX   | =\\footnote{}=        | =\\rfootnote{}= or =\\footnoteB{}= |
| Typst   | =#footnote[]=        | =#footnote[...rich content...]=  |
| ConTeXt | =\\footnote{}=        | =\\startfootnote= ... =\\stopfootnote= |
| Org     | =[fn:1]=             | Auto-detected or =#+BEGIN_RICHFN= |

*** LaTeX Rich Footnotes

Basic (level 1):
#+begin_example
\\rfootnote{
  \\fnheading{Title}
  \\begin{fnlist}
    \\item First
    \\item Second
  \\end{fnlist}
  \\begin{fntable}{|c|c|}
    \\hline
    A & B \\\\
    \\hline
  \\end{fntable}
}
#+end_example

Nested (level 2+):
#+begin_example
\\rfootnote{
  Text\\rfootnotemark[B].
  \\rfootnotetext[B]{
    Nested content with \\fnheading{Heading}
  }
}
#+end_example

Available levels: (none), B, C, D, E, F, G, H, I, J

*** Typst Rich Footnotes

#+begin_example
#footnote[
  = Heading Level 1
  == Heading Level 2
  
  - List item 1
    - Nested item
  - List item 2
  
  #table(
    columns: 2,
    [Header 1], [Header 2],
    [Cell 1], [Cell 2],
  )
  
  #footnote[Nested footnote]
]
#+end_example

*** ConTeXt Rich Footnotes

#+begin_example
\\startfootnote
\\subject{Heading}

\\startitemize
\\item First item
\\item Second item
\\stopitemize

\\starttabulate[|c|c|]
\\NC Header 1 \\NC Header 2 \\NC\\NR
\\NC Cell 1 \\NC Cell 2 \\NC\\NR
\\stoptabulate

\\startfootnote
Nested footnote
\\stopfootnote
\\stopfootnote
#+end_example

*** Org Rich Footnotes

**** Automatic Detection
Just write normal org syntax in footnote definitions:

#+begin_example
[fn:1] This footnote has rich content:

* Heading

- List item 1
- List item 2

| Col A | Col B |
|-------+-------|
| 1     | 2     |
#+end_example

The preprocessor auto-detects and converts on export.

**** Explicit Block (for complex cases)

#+begin_example
#+BEGIN_RICHFN 1
* Heading in Footnote

- Item with *bold*
- Item with /italic/

| Table | Here |
|-------+------|
| A     | B    |

#+BEGIN_RICHFN 2
Nested footnote content
#+END_RICHFN
#+END_RICHFN
#+end_example

** LaTeX Preamble

#+begin_src emacs-lisp
(defvar my/latex-rich-footnotes-preamble
  \"% ══════════════════════════════════════════════════════════════
% RICH FOOTNOTES SYSTEM
% ══════════════════════════════════════════════════════════════

% Base: bigfoot for nesting
\\\\usepackage{bigfoot}
\\\\DeclareNewFootnote{default}
\\\\DeclareNewFootnote{B}
\\\\DeclareNewFootnote{C}
\\\\DeclareNewFootnote{D}
\\\\DeclareNewFootnote{E}
\\\\DeclareNewFootnote{F}
\\\\DeclareNewFootnote{G}
\\\\DeclareNewFootnote{H}
\\\\DeclareNewFootnote{I}
\\\\DeclareNewFootnote{J}

% Tables in footnotes
\\\\usepackage{tabularx}
\\\\usepackage{booktabs}
\\\\usepackage{multirow}
\\\\usepackage{makecell}

% Table environment for footnotes
\\\\newenvironment{fntable}[1][]{%
  \\\\begin{center}%
  \\\\begin{tabular}{#1}%
}{%
  \\\\end{tabular}%
  \\\\end{center}%
}

% Flexible table for footnotes
\\\\newenvironment{fntablex}[1][]{%
  \\\\begin{center}%
  \\\\begin{tabularx}{\\\\linewidth}{#1}%
}{%
  \\\\end{tabularx}%
  \\\\end{center}%
}

% Lists in footnotes (unlimited depth)
\\\\usepackage{enumitem}
\\\\setlistdepth{20}
\\\\renewlist{itemize}{itemize}{20}
\\\\renewlist{enumerate}{enumerate}{20}

% List styles for each level
\\\\setlist[itemize,1]{label=\\\\textbullet}
\\\\setlist[itemize,2]{label=\\\\textendash}
\\\\setlist[itemize,3]{label=\\\\textasteriskcentered}
\\\\setlist[itemize,4]{label=\\\\textperiodcentered}
\\\\setlist[itemize,5]{label=\\\\textbullet}
\\\\setlist[itemize,6]{label=\\\\textendash}
\\\\setlist[itemize,7]{label=\\\\textasteriskcentered}
\\\\setlist[itemize,8]{label=\\\\textperiodcentered}

% Footnote list environment
\\\\newenvironment{fnlist}{\\\\begin{itemize}[nosep,leftmargin=*]}{\\\\end{itemize}}
\\\\newenvironment{fnenum}{\\\\begin{enumerate}[nosep,leftmargin=*]}{\\\\end{enumerate}}

% Headings in footnotes
\\\\newcommand{\\\\fnheading}[1]{\\\\textbf{\\\\large #1}\\\\par\\\\smallskip}
\\\\newcommand{\\\\fnsubheading}[1]{\\\\textbf{#1}\\\\par\\\\smallskip}
\\\\newcommand{\\\\fnsubsubheading}[1]{\\\\textit{\\\\textbf{#1}}\\\\par\\\\smallskip}

% 10 levels of headings in footnotes
\\\\newcommand{\\\\fnhi}[1]{\\\\textbf{\\\\Large #1}\\\\par\\\\medskip}
\\\\newcommand{\\\\fnhii}[1]{\\\\textbf{\\\\large #1}\\\\par\\\\smallskip}
\\\\newcommand{\\\\fnhiii}[1]{\\\\textbf{#1}\\\\par\\\\smallskip}
\\\\newcommand{\\\\fnhiv}[1]{\\\\textbf{\\\\small #1}\\\\par}
\\\\newcommand{\\\\fnhv}[1]{\\\\textit{\\\\textbf{#1}}\\\\par}
\\\\newcommand{\\\\fnhvi}[1]{\\\\textit{#1}\\\\par}
\\\\newcommand{\\\\fnhvii}[1]{\\\\underline{#1}\\\\par}
\\\\newcommand{\\\\fnhviii}[1]{\\\\textsc{#1}\\\\par}
\\\\newcommand{\\\\fnhix}[1]{--- #1 ---\\\\par}
\\\\newcommand{\\\\fnhx}[1]{#1:\\\\par}

% Rich footnote shortcuts (same as regular but clearer intent)
\\\\let\\\\rfootnote\\\\footnote
\\\\let\\\\rfootnoteB\\\\footnoteB
\\\\let\\\\rfootnoteC\\\\footnoteC
\\\\let\\\\rfootnoteD\\\\footnoteD
\\\\let\\\\rfootnoteE\\\\footnoteE
\\\\let\\\\rfootnoteF\\\\footnoteF
\\\\let\\\\rfootnoteG\\\\footnoteG
\\\\let\\\\rfootnoteH\\\\footnoteH
\\\\let\\\\rfootnoteI\\\\footnoteI
\\\\let\\\\rfootnoteJ\\\\footnoteJ

% Marks and texts for nesting
\\\\let\\\\rfootnotemark\\\\footnotemark
\\\\let\\\\rfootnotemarkB\\\\footnotemarkB
\\\\let\\\\rfootnotemarkC\\\\footnotemarkC
\\\\let\\\\rfootnotemarkD\\\\footnotemarkD
\\\\let\\\\rfootnotemarkE\\\\footnotemarkE

\\\\let\\\\rfootnotetext\\\\footnotetext
\\\\let\\\\rfootnotetextB\\\\footnotetextB
\\\\let\\\\rfootnotetextC\\\\footnotetextC
\\\\let\\\\rfootnotetextD\\\\footnotetextD
\\\\let\\\\rfootnotetextE\\\\footnotetextE

% Captioned table in footnote
\\\\newenvironment{fntablecap}[2][]{%
  \\\\begin{center}%
  \\\\textbf{#2}\\\\\\\\[2pt]%
  \\\\begin{tabular}{#1}%
}{%
  \\\\end{tabular}%
  \\\\end{center}%
}
\"
  \"LaTeX preamble for rich footnotes with full document capability.\")
#+end_src

** Typst Preamble

#+begin_src emacs-lisp
(defvar my/typst-rich-footnotes-preamble
  \"#let fn-heading(level, body) = {
  let sizes = (1.4em, 1.2em, 1.1em, 1em, 1em, 0.9em, 0.9em, 0.85em, 0.85em, 0.8em)
  let size = sizes.at(calc.min(level - 1, 9))
  let styles = (
    strong,
    strong,
    strong,
    emph,
    emph,
    it => underline(emph(it)),
    underline,
    smallcaps,
    it => [— #it —],
    it => [#it:],
  )
  let style = styles.at(calc.min(level - 1, 9))
  block(text(size: size, style(body)))
}

#let fn-h1(body) = fn-heading(1, body)
#let fn-h2(body) = fn-heading(2, body)
#let fn-h3(body) = fn-heading(3, body)
#let fn-h4(body) = fn-heading(4, body)
#let fn-h5(body) = fn-heading(5, body)
#let fn-h6(body) = fn-heading(6, body)
#let fn-h7(body) = fn-heading(7, body)
#let fn-h8(body) = fn-heading(8, body)
#let fn-h9(body) = fn-heading(9, body)
#let fn-h10(body) = fn-heading(10, body)

// Rich footnote with full content support
#let rfn(body) = footnote(body)

// Nested footnote counter
#let fn-level = state(\\\"fn-level\\\", 0)

// Table with caption in footnote
#let fn-table-cap(caption, ..args) = {
  block[
    #strong(caption)
    #table(..args)
  ]
}

// Numbered list in footnote
#let fn-enum(..items) = enum(..items)

// Bullet list in footnote  
#let fn-list(..items) = list(..items)
\"
  \"Typst preamble for rich footnotes.\")

(defun my/insert-typst-rich-footnotes-preamble ()
  \"Insert Typst rich footnotes preamble.\"
  (interactive)
  (insert my/typst-rich-footnotes-preamble))
