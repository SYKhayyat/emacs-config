\\\\definestartstop[fntable][
  before={%
    \\\\incrementcounter[fntablecounter]%
    \\\\blank[small]%
    \\\\doiftext{\\\\getvalue{fntablecaption}}{%
      {\\\\bf Table \\\\convertedcounter[fntablecounter]:} \\\\getvalue{fntablecaption}%
      \\\\blank[small]%
    }%
    \\\\starttabulate%
  },
  after={\\\\stoptabulate\\\\blank[small]}
]

\\\\def\\\\fntablecaption#1{\\\\setvalue{fntablecaption}{#1}}

