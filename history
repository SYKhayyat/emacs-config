** Org Preprocessor

#+begin_src emacs-lisp
;;; ═══════════════════════════════════════════════════════════════════════════
;;; ORG RICH FOOTNOTES PREPROCESSOR
;;; ═══════════════════════════════════════════════════════════════════════════

(defvar my/richfn-debug nil \"Enable debug messages for rich footnotes.\")

(defun my/richfn--log (fmt &rest args)
  \"Log message if debugging enabled.\"
  (when my/richfn-debug
    (apply #'message (concat \"RichFN: \" fmt) args)))

(defun my/richfn--count-stars (str)
  \"Count leading stars in STR.\"
  (if (string-match \"^\\\\(\\\\*+\\\\)\" str)
      (length (match-string 1 str))
    0))

(defun my/richfn--has-rich-content-p (text)
  \"Check if TEXT contains rich org content.\"
  (and text
       (string-match-p
        (rx (or
             ;; Headings
             (seq bol (+ \"*\") \" \")
             ;; Unordered lists
             (seq bol (* space) (any \"-+*\") \" \")
             ;; Ordered lists
             (seq bol (* space) (+ digit) (any \".)\") \" \")
             ;; Description lists
             (seq bol (* space) \"- \" (* nonl) \" :: \")
             ;; Tables
             (seq bol (* space) \"|\")
             ;; Code blocks
             (seq bol \"#+begin_src\")
             ;; Nested footnote references
             (seq \"[fn:\")))
        text)))

(defun my/richfn--get-footnote-definitions ()
  \"Get all footnote definitions as alist of (id . (start end content)).\"
  (let ((footnotes nil))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward \"^\\\\[fn:\\\\([^]]+\\\\)\\\\][ \\t]*\" nil t)
        (let* ((id (match-string 1))
               (start (match-beginning 0))
               (content-start (match-end 0))
               (end (save-excursion
                      (if (re-search-forward \"^\\\\[fn:\\\\|\\\\'\" nil t)
                          (match-beginning 0)
                        (point-max))))
               (content (string-trim
                         (buffer-substring-no-properties content-start end))))
          (push (list id start end content) footnotes))))
    (nreverse footnotes)))

(defun my/richfn--parse-rich-blocks ()
  \"Parse #+BEGIN_RICHFN blocks.\"
  (let ((blocks nil))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward \"^[ \\t]*#\\\\+BEGIN_RICHFN[ \\t]+\\\\([^ \\t\\n]+\\\\)\" nil t)
        (let* ((id (match-string 1))
               (block-start (match-beginning 0))
               (content-start (1+ (line-end-position)))
               (block-end (when (re-search-forward \"^[ \\t]*#\\\\+END_RICHFN\" nil t)
                            (match-end 0)))
               (content-end (match-beginning 0))
               (content (when block-end
                          (string-trim
                           (buffer-substring-no-properties content-start content-end)))))
          (when content
            (push (list id block-start block-end content) blocks)))))
    (nreverse blocks)))

(defun my/richfn--org-to-latex (text)
  \"Convert org TEXT to LaTeX for footnote.\"
  (with-temp-buffer
    (insert text)
    
    ;; Convert headings (20 levels)
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\(\\\\*+\\\\) \\\\(.*\\\\)$\" nil t)
      (let ((level (length (match-string 1)))
            (title (match-string 2)))
        (replace-match (format \"\\\\\\\\fnh{%d}{%s}\" level title) t t)))
    
    ;; Convert description lists first (before regular lists)
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\([ \\t]*\\\\)- \\\\([^:]+\\\\) :: \\\\(.*\\\\)$\" nil t)
      (let ((indent (match-string 1))
            (term (match-string 2))
            (desc (match-string 3)))
        (replace-match (format \"%s\\\\\\\\item[%s] %s\" indent term desc) t t)))
    
    ;; Track list state for wrapping
    (let ((in-itemize nil)
          (in-enumerate nil))
      
      ;; Convert unordered lists
      (goto-char (point-min))
      (while (re-search-forward \"^\\\\([ \\t]*\\\\)\\\\([-+*]\\\\) \\\\(.*\\\\)$\" nil t)
        (let ((indent (match-string 1))
              (content (match-string 3)))
          (replace-match (format \"%s\\\\\\\\item %s\" indent content) t t)))
      
      ;; Convert ordered lists
      (goto-char (point-min))
      (while (re-search-forward \"^\\\\([ \\t]*\\\\)\\\\([0-9]+\\\\)[.)] \\\\(.*\\\\)$\" nil t)
        (let ((indent (match-string 1))
              (content (match-string 3)))
          (replace-match (format \"%s\\\\\\\\item %s\" indent content) t t))))
    
    ;; Wrap consecutive \\\\item lines in environments
    (goto-char (point-min))
    (while (re-search-forward \"\\\\(\\\\\\\\item.*\\n\\\\)+\" nil t)
      (let ((items (match-string 0))
            (start (match-beginning 0))
            (end (match-end 0)))
        (delete-region start end)
        (goto-char start)
        (insert \"\\\\begin{fnitemize}\\n\" items \"\\\\end{fnitemize}\\n\")))
    
    ;; Convert tables
    (goto-char (point-min))
    (when (re-search-forward \"^[ \\t]*|\" nil t)
      (goto-char (point-min))
      (my/richfn--convert-tables-to-latex))
    
    ;; Convert code blocks
    (goto-char (point-min))
    (while (re-search-forward \"^#\\\\+begin_src\\\\(?: \\\\([^ \\t\\n]+\\\\)\\\\)?[ \\t]*\\n\\\\(\\\\(?:.*\\n\\\\)*?\\\\)#\\\\+end_src\" nil t)
      (let ((lang (or (match-string 1) \"\"))
            (code (match-string 2)))
        (replace-match (format \"\\\\\\\\begin{fncode}[%s]\\n%s\\\\\\\\end{fncode}\" lang code) t t)))
    
    ;; Convert inline code
    (goto-char (point-min))
    (while (re-search-forward \"~\\\\([^~]+\\\\)~\" nil t)
      (replace-match \"\\\\\\\\fnc{\\\\1}\" t nil))
    (goto-char (point-min))
    (while (re-search-forward \"=\\\\([^=]+\\\\)=\" nil t)
      (replace-match \"\\\\\\\\fnc{\\\\1}\" t nil))
    
    ;; Convert nested footnote references
    (goto-char (point-min))
    (while (re-search-forward \"\\\\[fn:\\\\([^]]+\\\\)\\\\]\" nil t)
      (let ((ref (match-string 1)))
        ;; Use next available level
        (replace-match (format \"\\\\\\\\rfnmark{B}\\\\\\\\rfntext{B}{%s}\" ref) t t)))
    
    (buffer-string)))

(defun my/richfn--convert-tables-to-latex ()
  \"Convert org tables to LaTeX in current buffer.\"
  (let ((table-start nil)
        (table-lines nil)
        (col-count 0))
    (while (re-search-forward \"^[ \\t]*|\\\\(.*\\\\)|[ \\t]*$\" nil t)
      (let* ((line (match-string 1))
             (cells (split-string line \"|\"))
             (is-sep (string-match-p \"^[-+]+$\" (string-trim (car cells)))))
        (unless table-start
          (setq table-start (match-beginning 0)))
        (if is-sep
            (push 'separator table-lines)
          (setq col-count (max col-count (length cells)))
          (push cells table-lines))))
    
    (when table-lines
      (setq table-lines (nreverse table-lines))
      (let ((latex-table
             (concat
              (format \"\\\\begin{fntab}{|%s|}\\n\\\\hline\\n\"
                      (mapconcat (lambda (_) \"l\") (number-sequence 1 col-count) \"|\"))
              (mapconcat
               (lambda (row)
                 (if (eq row 'separator)
                     \"\\\\hline\"
                   (concat (mapconcat #'string-trim row \" & \") \" \\\\\\\\\")))
               table-lines
               \"\\n\")
              \"\\n\\\\hline\\n\\\\end{fntab}\")))
        (delete-region table-start (point))
        (goto-char table-start)
        (insert latex-table)))))

(defun my/richfn--org-to-typst (text)
  \"Convert org TEXT to Typst for footnote.\"
  (with-temp-buffer
    (insert text)
    
    ;; Convert headings
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\(\\\\*+\\\\) \\\\(.*\\\\)$\" nil t)
      (let ((level (length (match-string 1)))
            (title (match-string 2)))
        (replace-match (format \"#fnh(%d)[%s]\" level title) t t)))
    
    ;; Lists work natively in Typst, just need to clean up
    
    ;; Convert tables
    (goto-char (point-min))
    (when (re-search-forward \"^[ \\t]*|\" nil t)
      (goto-char (point-min))
      (my/richfn--convert-tables-to-typst))
    
    ;; Convert code blocks
    (goto-char (point-min))
    (while (re-search-forward \"^#\\\\+begin_src\\\\(?: \\\\([^ \\t\\n]+\\\\)\\\\)?[ \\t]*\\n\\\\(\\\\(?:.*\\n\\\\)*?\\\\)#\\\\+end_src\" nil t)
      (let ((lang (or (match-string 1) \"\"))
            (code (string-trim (match-string 2))))
        (replace-match (format \"#fn-code(lang: \\\"%s\\\", ```\\n%s\\n```)\" lang code) t t)))
    
    ;; Convert inline code
    (goto-char (point-min))
    (while (re-search-forward \"~\\\\([^~]+\\\\)~\" nil t)
      (replace-match \"#fnc[\\\\1]\" t nil))
    (goto-char (point-min))
    (while (re-search-forward \"=\\\\([^=]+\\\\)=\" nil t)
      (replace-match \"#fnc[\\\\1]\" t nil))
    
    ;; Convert nested footnotes
    (goto-char (point-min))
    (while (re-search-forward \"\\\\[fn:\\\\([^]]+\\\\)\\\\]\" nil t)
      (replace-match \"#rfn[\\\\1]\" t t))
    
    (buffer-string)))

(defun my/richfn--convert-tables-to-typst ()
  \"Convert org tables to Typst in current buffer.\"
  (let ((table-start nil)
        (table-lines nil)
        (col-count 0))
    (while (re-search-forward \"^[ \\t]*|\\\\(.*\\\\)|[ \\t]*$\" nil t)
      (let* ((line (match-string 1))
             (cells (split-string line \"|\"))
             (is-sep (string-match-p \"^[-+]+$\" (string-trim (car cells)))))
        (unless table-start
          (setq table-start (match-beginning 0)))
        (unless is-sep
          (setq col-count (max col-count (length cells)))
          (push cells table-lines))))
    
    (when table-lines
      (setq table-lines (nreverse table-lines))
      (let ((typst-table
             (concat
              (format \"#table(\\n  columns: %d,\\n\" col-count)
              (mapconcat
               (lambda (row)
                 (mapconcat
                  (lambda (cell) (format \"  [%s],\" (string-trim cell)))
                  row
                  \"\\n\"))
               table-lines
               \"\\n\")
              \"\\n)\")))
        (delete-region table-start (point))
        (goto-char table-start)
        (insert typst-table)))))

(defun my/richfn--org-to-context (text)
  \"Convert org TEXT to ConTeXt for footnote.\"
  (with-temp-buffer
    (insert text)
    
    ;; Convert headings
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\(\\\\*+\\\\) \\\\(.*\\\\)$\" nil t)
      (let ((level (length (match-string 1)))
            (title (match-string 2)))
        (replace-match (format \"\\\\\\\\fnh[%d]{%s}\" level title) t t)))
    
    ;; Convert lists
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\([ \\t]*\\\\)[-+*] \\\\(.*\\\\)$\" nil t)
      (replace-match \"\\\\1\\\\\\\\item \\\\2\" t nil))
    
    ;; Wrap items
    (goto-char (point-min))
    (while (re-search-forward \"\\\\(\\\\\\\\item.*\\n\\\\)+\" nil t)
      (let ((items (match-string 0))
            (start (match-beginning 0))
            (end (match-end 0)))
        (delete-region start end)
        (goto-char start)
        (insert \"\\\\startfnitemize\\n\" items \"\\\\stopfnitemize\\n\")))
    
    ;; Convert tables
    (goto-char (point-min))
    (when (re-search-forward \"^[ \\t]*|\" nil t)
      (goto-char (point-min))
      (my/richfn--convert-tables-to-context))
    
    ;; Convert code blocks
    (goto-char (point-min))
    (while (re-search-forward \"^#\\\\+begin_src\\\\(?: \\\\([^ \\t\\n]+\\\\)\\\\)?[ \\t]*\\n\\\\(\\\\(?:.*\\n\\\\)*?\\\\)#\\\\+end_src\" nil t)
      (let ((code (match-string 2)))
        (replace-match (format \"\\\\\\\\startfncode\\n%s\\\\\\\\stopfncode\" code) t t)))
    
    ;; Convert inline code
    (goto-char (point-min))
    (while (re-search-forward \"~\\\\([^~]+\\\\)~\" nil t)
      (replace-match \"\\\\\\\\fnc{\\\\1}\" t nil))
    (goto-char (point-min))
    (while (re-search-forward \"=\\\\([^=]+\\\\)=\" nil t)
      (replace-match \"\\\\\\\\fnc{\\\\1}\" t nil))
    
    ;; Convert nested footnotes
    (goto-char (point-min))
    (while (re-search-forward \"\\\\[fn:\\\\([^]]+\\\\)\\\\]\" nil t)
      (replace-match \"\\\\\\\\RFNB{\\\\1}\" t t))
    
    (buffer-string)))

(defun my/richfn--convert-tables-to-context ()
  \"Convert org tables to ConTeXt in current buffer.\"
  (let ((table-start nil)
        (table-lines nil))
    (while (re-search-forward \"^[ \\t]*|\\\\(.*\\\\)|[ \\t]*$\" nil t)
      (let* ((line (match-string 1))
             (cells (split-string line \"|\"))
             (is-sep (string-match-p \"^[-+]+$\" (string-trim (car cells)))))
        (unless table-start
          (setq table-start (match-beginning 0)))
        (unless is-sep
          (push cells table-lines))))
    
    (when table-lines
      (setq table-lines (nreverse table-lines))
      (let ((context-table
             (concat
              \"\\\\starttabulate[|l|l|l|l|l|]\\n\"
              (mapconcat
               (lambda (row)
                 (concat \"\\\\NC \"
                         (mapconcat #'string-trim row \" \\\\NC \")
                         \" \\\\NC\\\\NR\"))
               table-lines
               \"\\n\")
              \"\\n\\\\stoptabulate\")))
        (delete-region table-start (point))
        (goto-char table-start)
        (insert context-table)))))

(defun my/richfn--org-to-html (text)
  \"Convert org TEXT to HTML for footnote.\"
  (with-temp-buffer
    (insert text)
    
    ;; Convert headings
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\(\\\\*+\\\\) \\\\(.*\\\\)$\" nil t)
      (let ((level (min 6 (length (match-string 1))))
            (title (match-string 2)))
        (replace-match (format \"<h%d>%s</h%d>\" level title level) t t)))
    
    ;; Convert lists
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\([ \\t]*\\\\)[-+*] \\\\(.*\\\\)$\" nil t)
      (replace-match \"\\\\1<li>\\\\2</li>\" t nil))
    
    ;; Wrap items
    (goto-char (point-min))
    (while (re-search-forward \"\\\\(<li>.*</li>\\n\\\\)+\" nil t)
      (let ((items (match-string 0))
            (start (match-beginning 0))
            (end (match-end 0)))
        (delete-region start end)
        (goto-char start)
        (insert \"<ul>\\n\" items \"</ul>\\n\")))
    
    ;; Convert tables
    (goto-char (point-min))
    (when (re-search-forward \"^[ \\t]*|\" nil t)
      (goto-char (point-min))
      (my/richfn--convert-tables-to-html))
    
    ;; Convert code blocks
    (goto-char (point-min))
    (while (re-search-forward \"^#\\\\+begin_src\\\\(?: \\\\([^ \\t\\n]+\\\\)\\\\)?[ \\t]*\\n\\\\(\\\\(?:.*\\n\\\\)*?\\\\)#\\\\+end_src\" nil t)
      (let ((lang (or (match-string 1) \"\"))
            (code (match-string 2)))
        (replace-match (format \"<pre><code class=\\\"%s\\\">%s</code></pre>\" lang code) t t)))
    
    ;; Convert inline code
    (goto-char (point-min))
    (while (re-search-forward \"~\\\\([^~]+\\\\)~\" nil t)
      (replace-match \"<code>\\\\1</code>\" t nil))
    (goto-char (point-min))
    (while (re-search-forward \"=\\\\([^=]+\\\\)=\" nil t)
      (replace-match \"<code>\\\\1</code>\" t nil))
    
    (buffer-string)))

(defun my/richfn--convert-tables-to-html ()
  \"Convert org tables to HTML in current buffer.\"
  (let ((table-start nil)
        (table-lines nil))
    (while (re-search-forward \"^[ \\t]*|\\\\(.*\\\\)|[ \\t]*$\" nil t)
      (let* ((line (match-string 1))
             (cells (split-string line \"|\"))
             (is-sep (string-match-p \"^[-+]+$\" (string-trim (car cells)))))
        (unless table-start
          (setq table-start (match-beginning 0)))
        (unless is-sep
          (push cells table-lines))))
    
    (when table-lines
      (setq table-lines (nreverse table-lines))
      (let ((html-table
             (concat
              \"<table>\\n\"
              (mapconcat
               (lambda (row)
                 (concat \"  <tr>\"
                         (mapconcat
                          (lambda (cell) (format \"<td>%s</td>\" (string-trim cell)))
                          row
                          \"\")
                         \"</tr>\"))
               table-lines
               \"\\n\")
              \"\\n</table>\")))
        (delete-region table-start (point))
        (goto-char table-start)
        (insert html-table)))))

(defun my/richfn--get-converter (backend)
  \"Get converter function for BACKEND.\"
  (pcase backend
    ((or 'latex 'beamer) #'my/richfn--org-to-latex)
    ('html #'my/richfn--org-to-html)
    ('pandoc #'my/richfn--org-to-latex)
    (_ #'my/richfn--org-to-latex)))

(defun my/richfn-preprocess-buffer (backend)
  \"Preprocess rich footnotes before export to BACKEND.\"
  (my/richfn--log \"Preprocessing for backend: %s\" backend)
  
  (let ((converter (my/richfn--get-converter backend)))
    
    ;; Process explicit RICHFN blocks first
    (let ((blocks (my/richfn--parse-rich-blocks)))
      (my/richfn--log \"Found %d RICHFN blocks\" (length blocks))
      
      ;; Process in reverse to maintain positions
      (dolist (block (nreverse blocks))
        (let ((id (nth 0 block))
              (start (nth 1 block))
              (end (nth 2 block))
              (content (nth 3 block)))
          (my/richfn--log \"Processing block: %s\" id)
          (let ((converted (funcall converter content)))
            ;; Delete the block
            (delete-region start end)
            ;; Find or create footnote definition
            (save-excursion
              (goto-char (point-min))
              (if (re-search-forward (format \"^\\\\[fn:%s\\\\]\" (regexp-quote id)) nil t)
                  ;; Replace existing
                  (let ((def-start (match-beginning 0))
                        (def-end (save-excursion
                                   (if (re-search-forward \"^\\\\[fn:\\\\|\\\\'\" nil t)
                                       (match-beginning 0)
                                     (point-max)))))
                    (delete-region def-start def-end)
                    (goto-char def-start)
                    (insert (format \"[fn:%s] %s\\n\" id converted)))
                ;; Create new at end
                (goto-char (point-max))
                (insert (format \"\\n[fn:%s] %s\\n\" id converted))))))))
    
    ;; Auto-detect rich content in remaining footnotes
    (let ((footnotes (my/richfn--get-footnote-definitions)))
      (my/richfn--log \"Found %d footnotes to check\" (length footnotes))
      
      ;; Process in reverse
      (dolist (fn (nreverse footnotes))
        (let ((id (nth 0 fn))
              (start (nth 1 fn))
              (end (nth 2 fn))
              (content (nth 3 fn)))
          (when (my/richfn--has-rich-content-p content)
            (my/richfn--log \"Auto-converting footnote: %s\" id)
            (let ((converted (funcall converter content)))
              (delete-region start end)
              (goto-char start)
              (insert (format \"[fn:%s] %s\\n\" id converted)))))))))

;; Register preprocessor
(with-eval-after-load 'ox
  (add-hook 'org-export-before-processing-functions #'my/richfn-preprocess-buffer))

;; Also handle pandoc
(with-eval-after-load 'ox-pandoc
  (advice-add 'org-pandoc-export-to-pandoc
              :before
              (lambda (&rest _)
                (my/richfn-preprocess-buffer 'pandoc))))
#+end_src

