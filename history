    let target = \"./library\";

    fs::create_dir_all(data_dir).ok();
    fs::create_dir_all(target).ok();

    if Path::new(&repo_dir).exists() {
        let _ = Command::new(\"git\")
            .current_dir(&repo_dir)
            .args([\"pull\", \"--depth=1\"])
            .output();
    } else {
        let output = Command::new(\"git\")
            .args([
                \"clone\",
                \"--depth=1\",
                \"https://github.com/Sivan22/otzaria-library.git\",
                &repo_dir,
            ])
            .output()
            .map_err(|e| e.to_string())?;
        if !output.status.success() {
            return Err(\"Git clone failed. Is git installed?\".to_string());
        }
    }

    let source = format!(\"{}/אוצריא\", repo_dir);
    if Path::new(&source).exists() {
        let _ = Command::new(\"cp\")
            .args([\"-r\", \"-T\", &source, target])
            .output();
    }

    Ok(\"Official library imported successfully!\".to_string())
}

