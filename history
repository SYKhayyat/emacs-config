#+begin_src emacs-lisp
(defvar my/typst-rich-footnotes-preamble
  \"// ══════════════════════════════════════════════════════════════════════════════
// RICH FOOTNOTES SYSTEM
// ══════════════════════════════════════════════════════════════════════════════

// Headings (20 levels)
#let fnh(level, body) = {
  let styles = (
    (size: 1.3em, weight: \\\"bold\\\"),
    (size: 1.2em, weight: \\\"bold\\\"),
    (size: 1.1em, weight: \\\"bold\\\"),
    (size: 1em, weight: \\\"bold\\\"),
    (size: 1em, weight: \\\"bold\\\", style: \\\"italic\\\"),
    (size: 1em, style: \\\"italic\\\"),
    (size: 0.95em, weight: \\\"bold\\\"),
    (size: 0.95em),
    (size: 0.9em, weight: \\\"bold\\\"),
    (size: 0.9em),
    (size: 0.85em, weight: \\\"bold\\\"),
    (size: 0.85em),
    (size: 0.8em, weight: \\\"bold\\\"),
    (size: 0.8em),
    (size: 0.75em, weight: \\\"bold\\\"),
    (size: 0.75em),
    (size: 0.7em, weight: \\\"bold\\\"),
    (size: 0.7em),
    (size: 0.65em, weight: \\\"bold\\\"),
    (size: 0.65em),
  )
  let idx = calc.min(level - 1, 19)
  let s = styles.at(idx)
  block(text(
    size: s.at(\\\"size\\\", default: 1em),
    weight: s.at(\\\"weight\\\", default: \\\"regular\\\"),
    style: s.at(\\\"style\\\", default: \\\"normal\\\"),
    body
  ))
}

// Rich footnote alias
#let rfn(body) = footnote(body)

// Table with caption
#let fn-table-counter = counter(\\\"fn-table\\\")

#let fn-table(caption: none, ..args) = {
  fn-table-counter.step()
  block[
    #if caption != none [
      *Table #fn-table-counter.display():* #caption
      #v(0.3em)
    ]
    #table(..args)
  ]
}

// Code block
#let fn-code(lang: none, body) = {
  block(
    fill: luma(245),
    inset: 5pt,
    radius: 2pt,
    width: 100%,
    raw(body.text, lang: lang, block: true)
  )
}

// Inline code
#let fnc(body) = raw(body)
\"
  \"Typst preamble for rich footnotes.\")

(defun my/insert-typst-rich-footnotes-preamble ()
  \"Insert Typst rich footnotes preamble.\"
  (interactive)
  (insert my/typst-rich-footnotes-preamble)
  (message \"Inserted Typst rich footnotes preamble.\"))
#+end_src

