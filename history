  _2_: \\\\footnotemarkB   _3_: \\\\footnotemarkC   _4_: \\\\footnotemarkD   _5_: \\\\footnotemarkE
  _b_: ← Back   _q_: quit
  \"
      (\"2\" my/insert-footnotemark-level-2)
