** Helper Functions

#+begin_src emacs-lisp
(defun my/insert-rich-footnote-latex ()
  \"Insert LaTeX rich footnote template.\"
  (interactive)
  (insert \"\\\\rfn{%
  \\\\fnh{1}{Heading}
  
  \\\\begin{fnitemize}
    \\\\item First
    \\\\begin{fnitemize}
      \\\\item Nested
    \\\\end{fnitemize}
  \\\\end{fnitemize}
  
  \\\\begin{fnenumerate}
    \\\\item Numbered
  \\\\end{fnenumerate}
  
  \\\\begin{fntab}{|l|l|}[Caption]
    \\\\hline
    A & B \\\\\\\\
    \\\\hline
    \\\\multicolumn{2}{|c|}{Merged} \\\\\\\\
    \\\\hline
  \\\\end{fntab}
  
  \\\\begin{fncode}[python]
def f():
    pass
  \\\\end{fncode}
}\")
  (search-backward \"Heading\"))

(defun my/insert-rich-footnote-latex-nested ()
  \"Insert nested LaTeX rich footnote.\"
  (interactive)
  (insert \"\\\\rfn{%
  Content\\\\rfnmark{B}.
  \\\\rfntext{B}{%
    Nested\\\\rfnmark{C}.
    \\\\rfntext{C}{Third level.}
  }
}\")
  (search-backward \"Content\"))

(defun my/insert-rich-footnote-typst ()
  \"Insert Typst rich footnote template.\"
  (interactive)
  (insert \"#rfn[
  #fnh(1)[Heading]
  
  - Item 1
    - Nested
  
  #fn-table(
    caption: \\\"Caption\\\",
    columns: 2,
    [A], [B],
    table.cell(colspan: 2)[Merged],
  )
  
  #fn-code(lang: \\\"python\\\")[```
def f():
    pass
```]
]\")
  (search-backward \"Heading\"))

(defun my/insert-rich-footnote-context ()
  \"Insert ConTeXt rich footnote template.\"
  (interactive)
  (insert \"\\\\startRFN
\\\\fnh{1}{Heading}

\\\\startitemize[packed]
\\\\item First
\\\\startitemize[packed]
\\\\item Nested
\\\\stopitemize
\\\\stopitemize

\\\\starttabulate[|l|l|]
\\\\NC A \\\\NC B \\\\NC\\\\NR
\\\\stoptabulate

\\\\startfncode
def f():
    pass
\\\\stopfncode
\\\\stopRFN\")
  (search-backward \"Heading\"))

(defun my/insert-rich-footnote-org ()
  \"Insert Org rich footnote block.\"
  (interactive)
  (let ((id (read-string \"Footnote ID: \" \"1\")))
    (insert (format \"#+BEGIN_RICHFN %s
* Heading

- Item 1
  - Nested

#+CAPTION: My Table
| A | B |
|---+---|
| 1 | 2 |

#+begin_src python
def f():
    pass
#+end_src
#+END_RICHFN

[fn:%s]\" id id))
    (search-backward \"Heading\")))

(defun my/insert-rich-footnote-org-inline ()
  \"Insert auto-detected rich footnote.\"
  (interactive)
  (let ((id (read-string \"Footnote ID: \" \"1\")))
    (insert (format \"[fn:%s]\" id))
    (save-excursion
      (goto-char (point-max))
      (insert (format \"

[fn:%s]
* Heading

- Item

| A | B |
|---+---|
| 1 | 2 |
\" id)))))
#+end_src

** Hydra

#+begin_src emacs-lisp
(with-eval-after-load 'hydra
  (defhydra hydra-rich-footnotes (:color blue :hint nil)
    \"
Rich Footnotes
Insert:   _l_: LaTeX    _L_: LaTeX nested  _t_: Typst   _c_: ConTeXt
          _o_: Org block   _O_: Org inline
Preamble: _p_: LaTeX    _T_: Typst         _C_: ConTeXt
Debug:    _d_: toggle
\"
    (\"l\" my/insert-rich-footnote-latex)
    (\"L\" my/insert-rich-footnote-latex-nested)
    (\"t\" my/insert-rich-footnote-typst)
    (\"c\" my/insert-rich-footnote-context)
    (\"o\" my/insert-rich-footnote-org)
    (\"O\" my/insert-rich-footnote-org-inline)
    (\"p\" my/insert-latex-rich-footnotes-preamble)
    (\"T\" my/insert-typst-rich-footnotes-preamble)
    (\"C\" my/insert-context-rich-footnotes-preamble)
    (\"d\" (progn (setq my/richfn-debug (not my/richfn-debug))
                (message \"Debug: %s\" my/richfn-debug)))
    (\"q\" nil))
  
  (global-set-key (kbd \"C-c F\") #'hydra-rich-footnotes/body))

(with-eval-after-load 'latex
  (define-key LaTeX-mode-map (kbd \"C-c F\") #'hydra-rich-footnotes/body))

(with-eval-after-load 'typst-ts-mode
  (when (boundp 'typst-ts-mode-map)
    (define-key typst-ts-mode-map (kbd \"C-c F\") #'hydra-rich-footnotes/body)))

(with-eval-after-load 'org
  (define-key org-mode-map (kbd \"C-c F\") #'hydra-rich-footnotes/body))
#+end_src" "* Rich Footnotes System

Full document capability inside footnotes: unlimited headings, lists, tables (with merging), nested footnotes, code blocks, description lists.

** Packages

#+begin_src emacs-lisp
(use-package ox-pandoc
  :after org
  :config
  (setq org-pandoc-options '((standalone . t)))
  (setq org-pandoc-options-for-latex-pdf '((pdf-engine . \"lualatex\"))))
#+end_src

** Documentation

*** Overview

This system provides rich content inside footnotes for:
- LaTeX (bigfoot + custom environments)
- Typst (native + helpers)
- ConTeXt (native + helpers)  
- Org-mode (preprocessor auto-converts on export)
- Pandoc (PDF, DOCX, HTML via ox-pandoc)

All support:
- 20 levels of headings
- 20 levels of nested lists (itemize, enumerate, description)
- Tables with colspan/rowspan, captions, numbering
- Code blocks
- Nested footnotes (10 levels)

*** Quick Reference

| System  | Rich Footnote Command/Block                    |
|---------+------------------------------------------------|
| LaTeX   | =\\rfn{...}= or =\\rfnB{...}= etc.               |
| Typst   | =#rfn[...]= or native =#footnote[...]=         |
| ConTeXt | =\\startRFN= ... =\\stopRFN=                     |
| Org     | Auto-detected, or =#+BEGIN_RICHFN id= block    |

*** LaTeX Usage

**** Simple rich footnote:
#+begin_example latex
\\rfn{
  \\fnh{1}{Main Heading}
  
  \\begin{fnitemize}
    \\item First item
    \\begin{fnitemize}
      \\item Nested item
    \\end{fnitemize}
  \\end{fnitemize}
  
  \\begin{fntab}{|l|l|}{Table Caption}
    \\hline
    A & B \\\\
    \\hline
    \\multicolumn{2}{|c|}{Merged} \\\\
    \\hline
  \\end{fntab}
  
  \\begin{fncode}{python}
  def hello():
      print(\"Hello\")
  \\end{fncode}
}
#+end_example

**** Nested footnotes:
#+begin_example latex
\\rfn{
  Main content\\rfnmark{B}.
  \\rfntext{B}{
    Second level\\rfnmark{C}.
    \\rfntext{C}{Third level.}
  }
}
#+end_example

**** Heading levels (1-20):
=\\fnh{1}{...}= through =\\fnh{20}{...}=

**** List types:
- =\\begin{fnitemize}= ... =\\end{fnitemize}= (bullets)
- =\\begin{fnenumerate}= ... =\\end{fnenumerate}= (numbered)
- =\\begin{fndescription}= ... =\\end{fndescription}= (description)

*** Typst Usage

#+begin_example typst
#rfn[
  #fnh(1)[Main Heading]
  
  - List item 1
    - Nested item
  
  #fn-table(
    caption: \"My Table\",
    columns: 2,
    [A], [B],
    table.cell(colspan: 2)[Merged],
  )
  
  #fn-code(\"python\", `
  def hello():
      print(\"Hello\")
  `)
  
  #rfn[Nested footnote]
]
#+end_example

*** ConTeXt Usage

#+begin_example context
\\startRFN
\\fnh[1]{Main Heading}

\\startfnitemize
\\item First item
\\startfnitemize
\\item Nested
\\stopfnitemize
\\stopfnitemize

\\startfntable[caption={My Table}]
\\NC A \\NC B \\NC\\NR
\\NC \\use{2}{Merged} \\NC\\NR
\\stopfntable

\\startfncode[python]
def hello():
    print(\"Hello\")
\\stopfncode

\\startRFN
Nested footnote
\\stopRFN
\\stopRFN
#+end_example

*** Org Usage

**** Automatic detection:
Just write org syntax in footnote definitions:

#+begin_example org
Text with footnote[fn:1].

[fn:1] 
* Heading in Footnote

- List item 1
  - Nested item
- List item 2

| Col A | Col B |
|-------+-------|
| 1     | 2     |

#+begin_src python
def hello():
    print(\"Hello\")
#+end_src

Another footnote reference[fn:2].

[fn:2] Nested footnote content.
#+end_example

**** Explicit block (for complex cases):

#+begin_example org
#+BEGIN_RICHFN myid
* Heading

- List

| Table |

#+BEGIN_RICHFN nested1
Nested footnote
#+END_RICHFN

#+END_RICHFN

Reference with [fn:myid] in text.
#+end_example

** LaTeX Preamble

#+begin_src emacs-lisp
(defvar my/latex-rich-footnotes-preamble
  \"% ══════════════════════════════════════════════════════════════════════════════
% RICH FOOTNOTES SYSTEM - Full document capability in footnotes
% ══════════════════════════════════════════════════════════════════════════════

% ──────────────────────────────────────────────────────────────────────────────
% NESTED FOOTNOTES (10 levels: default, B-J)
% ──────────────────────────────────────────────────────────────────────────────
\\\\usepackage{bigfoot}
\\\\DeclareNewFootnote{default}
\\\\DeclareNewFootnote{B}
\\\\DeclareNewFootnote{C}
\\\\DeclareNewFootnote{D}
\\\\DeclareNewFootnote{E}
\\\\DeclareNewFootnote{F}
\\\\DeclareNewFootnote{G}
\\\\DeclareNewFootnote{H}
\\\\DeclareNewFootnote{I}
\\\\DeclareNewFootnote{J}

% Shortcuts
\\\\newcommand{\\\\rfn}[1]{\\\\footnote{#1}}
\\\\newcommand{\\\\rfnB}[1]{\\\\footnoteB{#1}}
\\\\newcommand{\\\\rfnC}[1]{\\\\footnoteC{#1}}
\\\\newcommand{\\\\rfnD}[1]{\\\\footnoteD{#1}}
\\\\newcommand{\\\\rfnE}[1]{\\\\footnoteE{#1}}
\\\\newcommand{\\\\rfnF}[1]{\\\\footnoteF{#1}}
\\\\newcommand{\\\\rfnG}[1]{\\\\footnoteG{#1}}
\\\\newcommand{\\\\rfnH}[1]{\\\\footnoteH{#1}}
\\\\newcommand{\\\\rfnI}[1]{\\\\footnoteI{#1}}
\\\\newcommand{\\\\rfnJ}[1]{\\\\footnoteJ{#1}}

% Marks and texts for manual nesting
\\\\newcommand{\\\\rfnmark}[1]{\\\\csname footnotemark#1\\\\endcsname}
\\\\newcommand{\\\\rfntext}[2]{\\\\csname footnotetext#1\\\\endcsname{#2}}

% ──────────────────────────────────────────────────────────────────────────────
% HEADINGS IN FOOTNOTES (20 levels)
% ──────────────────────────────────────────────────────────────────────────────
\\\\usepackage{xparse}

\\\\ExplSyntaxOn
\\\\NewDocumentCommand{\\\\fnh}{m m}{
  \\\\int_case:nnF {#1} {
    {1}  {\\\\par\\\\medskip{\\\\bfseries\\\\Large #2}\\\\par\\\\smallskip}
    {2}  {\\\\par\\\\smallskip{\\\\bfseries\\\\large #2}\\\\par\\\\smallskip}
    {3}  {\\\\par\\\\smallskip{\\\\bfseries #2}\\\\par\\\\smallskip}
    {4}  {\\\\par{\\\\bfseries\\\\small #2}\\\\par}
    {5}  {\\\\par{\\\\bfseries\\\\itshape #2}\\\\par}
    {6}  {\\\\par{\\\\itshape #2}\\\\par}
    {7}  {\\\\par{\\\\scshape #2}\\\\par}
    {8}  {\\\\par\\\\underline{#2}\\\\par}
    {9}  {\\\\par{\\\\sffamily\\\\bfseries\\\\footnotesize #2}\\\\par}
    {10} {\\\\par{\\\\sffamily\\\\footnotesize #2}\\\\par}
    {11} {\\\\par{\\\\ttfamily\\\\bfseries\\\\footnotesize #2}\\\\par}
    {12} {\\\\par{\\\\ttfamily\\\\footnotesize #2}\\\\par}
    {13} {\\\\par\\\\textemdash\\\\ {\\\\bfseries #2}\\\\ \\\\textemdash\\\\par}
    {14} {\\\\par\\\\textbullet\\\\ {\\\\bfseries #2}\\\\par}
    {15} {\\\\par[{\\\\bfseries #2}]\\\\par}
    {16} {\\\\par\\\\{{\\\\itshape #2}\\\\}\\\\par}
    {17} {\\\\par({\\\\small #2})\\\\par}
    {18} {\\\\par$\\\\triangleright$\\\\ #2\\\\par}
    {19} {\\\\par$\\\\diamond$\\\\ #2\\\\par}
    {20} {\\\\par#2:\\\\par}
  }{\\\\par{\\\\bfseries #2}\\\\par}
}
\\\\ExplSyntaxOff

% ──────────────────────────────────────────────────────────────────────────────
% LISTS IN FOOTNOTES (20 levels)
% ──────────────────────────────────────────────────────────────────────────────
\\\\usepackage{enumitem}
\\\\setlistdepth{20}

% Itemize (bullets)
\\\\newlist{fnitemize}{itemize}{20}
\\\\setlist[fnitemize]{nosep, leftmargin=*, labelindent=0pt}
\\\\setlist[fnitemize,1]{label=\\\\textbullet}
\\\\setlist[fnitemize,2]{label=\\\\textendash}
\\\\setlist[fnitemize,3]{label=\\\\textasteriskcentered}
\\\\setlist[fnitemize,4]{label=\\\\textperiodcentered}
\\\\setlist[fnitemize,5]{label=\\\\textopenbullet}
\\\\setlist[fnitemize,6]{label=\\\\textbullet}
\\\\setlist[fnitemize,7]{label=\\\\textendash}
\\\\setlist[fnitemize,8]{label=\\\\textasteriskcentered}
\\\\setlist[fnitemize,9]{label=\\\\textperiodcentered}
\\\\setlist[fnitemize,10]{label=\\\\textopenbullet}
\\\\setlist[fnitemize,11]{label=\\\\textbullet}
\\\\setlist[fnitemize,12]{label=\\\\textendash}
\\\\setlist[fnitemize,13]{label=\\\\textasteriskcentered}
\\\\setlist[fnitemize,14]{label=\\\\textperiodcentered}
\\\\setlist[fnitemize,15]{label=\\\\textopenbullet}
\\\\setlist[fnitemize,16]{label=\\\\textbullet}
\\\\setlist[fnitemize,17]{label=\\\\textendash}
\\\\setlist[fnitemize,18]{label=\\\\textasteriskcentered}
\\\\setlist[fnitemize,19]{label=\\\\textperiodcentered}
\\\\setlist[fnitemize,20]{label=\\\\textopenbullet}

% Enumerate (numbered)
\\\\newlist{fnenumerate}{enumerate}{20}
\\\\setlist[fnenumerate]{nosep, leftmargin=*, labelindent=0pt}
\\\\setlist[fnenumerate,1]{label=\\\\arabic*.}
\\\\setlist[fnenumerate,2]{label=\\\\alph*.}
\\\\setlist[fnenumerate,3]{label=\\\\roman*.}
\\\\setlist[fnenumerate,4]{label=\\\\Alph*.}
\\\\setlist[fnenumerate,5]{label=\\\\Roman*.}
\\\\setlist[fnenumerate,6]{label=(\\\\arabic*)}
\\\\setlist[fnenumerate,7]{label=(\\\\alph*)}
\\\\setlist[fnenumerate,8]{label=(\\\\roman*)}
\\\\setlist[fnenumerate,9]{label=[\\\\arabic*]}
\\\\setlist[fnenumerate,10]{label=[\\\\alph*]}
\\\\setlist[fnenumerate,11]{label=\\\\arabic*)}
\\\\setlist[fnenumerate,12]{label=\\\\alph*)}
\\\\setlist[fnenumerate,13]{label=\\\\roman*)}
\\\\setlist[fnenumerate,14]{label=\\\\Alph*)}
\\\\setlist[fnenumerate,15]{label=\\\\Roman*)}
\\\\setlist[fnenumerate,16]{label=\\\\arabic*-}
\\\\setlist[fnenumerate,17]{label=\\\\alph*-}
\\\\setlist[fnenumerate,18]{label=\\\\roman*-}
\\\\setlist[fnenumerate,19]{label=\\\\Alph*-}
\\\\setlist[fnenumerate,20]{label=\\\\Roman*-}

% Description
\\\\newlist{fndescription}{description}{20}
\\\\setlist[fndescription]{nosep, leftmargin=!, labelindent=0pt, style=nextline}

% ──────────────────────────────────────────────────────────────────────────────
% TABLES IN FOOTNOTES (with colspan, rowspan, captions, numbering)
% ──────────────────────────────────────────────────────────────────────────────
\\\\usepackage{tabularx}
\\\\usepackage{booktabs}
\\\\usepackage{multirow}
\\\\usepackage{makecell}
\\\\usepackage{caption}

\\\\newcounter{fntablecounter}

% Simple table: \\\\begin{fntab}{cols}{caption} ... \\\\end{fntab}
\\\\NewDocumentEnvironment{fntab}{m O{}}{%
  \\\\par\\\\smallskip
  \\\\refstepcounter{fntablecounter}%
  \\\\IfValueTF{#2}{%
    \\\\noindent\\\\textbf{Table~\\\\thefntablecounter:} #2\\\\par\\\\smallskip
  }{}%
  \\\\centering
  \\\\begin{tabular}{#1}%
}{%
  \\\\end{tabular}%
  \\\\par\\\\smallskip
}

% Flexible width table
\\\\NewDocumentEnvironment{fntabx}{m O{}}{%
  \\\\par\\\\smallskip
  \\\\refstepcounter{fntablecounter}%
  \\\\IfValueTF{#2}{%
    \\\\noindent\\\\textbf{Table~\\\\thefntablecounter:} #2\\\\par\\\\smallskip
  }{}%
  \\\\centering
  \\\\begin{tabularx}{\\\\linewidth}{#1}%
}{%
  \\\\end{tabularx}%
  \\\\par\\\\smallskip
}

% ──────────────────────────────────────────────────────────────────────────────
% CODE BLOCKS IN FOOTNOTES
% ──────────────────────────────────────────────────────────────────────────────
\\\\usepackage{listings}
\\\\lstset{
  basicstyle=\\\\ttfamily\\\\footnotesize,
  breaklines=true,
  frame=single,
  framesep=2pt,
  xleftmargin=2pt,
  xrightmargin=2pt
}

\\\\NewDocumentEnvironment{fncode}{O{}}{%
  \\\\par\\\\smallskip
  \\\\lstset{language=#1}%
  \\\\begin{lstlisting}%
}{%
  \\\\end{lstlisting}%
  \\\\par\\\\smallskip
}

% Inline code
\\\\newcommand{\\\\fnc}[1]{\\\\texttt{#1}}
\"
  \"LaTeX preamble for rich footnotes with full document capability.\")

(defun my/insert-latex-rich-footnotes-preamble ()
  \"Insert LaTeX rich footnotes preamble.\"
  (interactive)
  (insert my/latex-rich-footnotes-preamble)
  (message \"LaTeX rich footnotes preamble inserted.\"))
#+end_src

** Typst Preamble

#+begin_src emacs-lisp
(defvar my/typst-rich-footnotes-preamble
  \"// ══════════════════════════════════════════════════════════════════════════════
// RICH FOOTNOTES SYSTEM - Full document capability in footnotes
// ══════════════════════════════════════════════════════════════════════════════

// ──────────────────────────────────────────────────────────────────────────────
// HEADINGS IN FOOTNOTES (20 levels)
// ──────────────────────────────────────────────────────────────────────────────
#let fnh(level, body) = {
  let configs = (
    (size: 1.3em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 1.2em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 1.1em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 1em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 1em, weight: \\\"bold\\\", style: \\\"italic\\\"),
    (size: 1em, weight: \\\"regular\\\", style: \\\"italic\\\"),
    (size: 0.95em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 0.95em, weight: \\\"regular\\\", style: \\\"normal\\\"),
    (size: 0.9em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 0.9em, weight: \\\"regular\\\", style: \\\"italic\\\"),
    (size: 0.85em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 0.85em, weight: \\\"regular\\\", style: \\\"normal\\\"),
    (size: 0.8em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 0.8em, weight: \\\"regular\\\", style: \\\"normal\\\"),
    (size: 0.75em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 0.75em, weight: \\\"regular\\\", style: \\\"normal\\\"),
    (size: 0.7em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 0.7em, weight: \\\"regular\\\", style: \\\"normal\\\"),
    (size: 0.65em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 0.65em, weight: \\\"regular\\\", style: \\\"normal\\\"),
  )
  let idx = calc.min(level - 1, 19)
  let cfg = configs.at(idx)
  block(text(size: cfg.size, weight: cfg.weight, style: cfg.style, body))
}

// Shortcuts
#let fnh1(body) = fnh(1, body)
#let fnh2(body) = fnh(2, body)
#let fnh3(body) = fnh(3, body)
#let fnh4(body) = fnh(4, body)
#let fnh5(body) = fnh(5, body)
#let fnh6(body) = fnh(6, body)
#let fnh7(body) = fnh(7, body)
#let fnh8(body) = fnh(8, body)
#let fnh9(body) = fnh(9, body)
#let fnh10(body) = fnh(10, body)

// ──────────────────────────────────────────────────────────────────────────────
// RICH FOOTNOTE (alias for clarity)
// ──────────────────────────────────────────────────────────────────────────────
#let rfn(body) = footnote(body)

// ──────────────────────────────────────────────────────────────────────────────
// TABLES WITH CAPTION IN FOOTNOTES
// ──────────────────────────────────────────────────────────────────────────────
#let fn-table-counter = counter(\\\"fn-table\\\")

#let fn-table(caption: none, ..args) = {
  fn-table-counter.step()
  block[
    #if caption != none [
      #strong[Table #fn-table-counter.display():] #caption
      #v(0.3em)
    ]
    #table(..args)
  ]
}

// ──────────────────────────────────────────────────────────────────────────────
// CODE BLOCKS IN FOOTNOTES
// ──────────────────────────────────────────────────────────────────────────────
#let fn-code(lang: none, body) = {
  block(
    fill: luma(245),
    inset: 4pt,
    radius: 2pt,
    width: 100%,
    if lang != none {
      raw(body, lang: lang, block: true)
    } else {
      raw(body, block: true)
    }
  )
}

// Inline code
#let fnc(body) = raw(body)

// ──────────────────────────────────────────────────────────────────────────────
// DESCRIPTION LIST
// ──────────────────────────────────────────────────────────────────────────────
#let fn-desc(..items) = {
  for (term, desc) in items.pos() {
    block[#strong(term): #desc]
  }
}
\"
  \"Typst preamble for rich footnotes.\")

(defun my/insert-typst-rich-footnotes-preamble ()
  \"Insert Typst rich footnotes preamble.\"
  (interactive)
  (insert my/typst-rich-footnotes-preamble)
  (message \"Typst rich footnotes preamble inserted.\"))
#+end_src

