#+begin_src emacs-lisp
(use-package ox-pandoc
  :after org
  :config
  (setq org-pandoc-options '((standalone . t)))
  (setq org-pandoc-options-for-latex-pdf '((pdf-engine . \"lualatex\")))
  
  ;; Create temp preamble file for pandoc
  (defvar my/richfn-pandoc-preamble-file nil)
  
  (defun my/richfn-ensure-pandoc-preamble ()
    \"Ensure pandoc preamble file exists.\"
    (unless (and my/richfn-pandoc-preamble-file
                 (file-exists-p my/richfn-pandoc-preamble-file))
      (setq my/richfn-pandoc-preamble-file
            (make-temp-file \"richfn-preamble\" nil \".tex\"))
      (with-temp-file my/richfn-pandoc-preamble-file
        (insert my/latex-rich-footnotes-preamble)))
    my/richfn-pandoc-preamble-file)
  
  (defun my/richfn-pandoc-preprocess (&rest _)
    \"Preprocess for pandoc export.\"
    (my/richfn-preprocess-buffer 'latex))
  
  ;; Advice pandoc export functions
  (advice-add 'org-pandoc-export-to-latex-pdf :before #'my/richfn-pandoc-preprocess)
  (advice-add 'org-pandoc-export-as-latex :before #'my/richfn-pandoc-preprocess)
  
  ;; Add preamble to pandoc options
  (setq org-pandoc-options-for-latex-pdf
        `((pdf-engine . \"lualatex\")
          (include-in-header . ,(my/richfn-ensure-pandoc-preamble)))))
