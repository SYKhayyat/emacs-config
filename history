** Helper Functions

#+begin_src emacs-lisp
;;; ═══════════════════════════════════════════════════════════════════════════
;;; RICH FOOTNOTE INSERTION HELPERS
;;; ═══════════════════════════════════════════════════════════════════════════

(defun my/insert-rich-footnote-latex ()
  \"Insert a LaTeX rich footnote template.\"
  (interactive)
  (insert \"\\\\rfn{%
  \\\\fnh{1}{Heading}
  
  \\\\begin{fnitemize}
    \\\\item First item
    \\\\begin{fnitemize}
      \\\\item Nested item
    \\\\end{fnitemize}
  \\\\end{fnitemize}
  
  \\\\begin{fnenumerate}
    \\\\item Numbered item
  \\\\end{fnenumerate}
  
  \\\\begin{fntab}{|l|l|}[Caption]
    \\\\hline
    Header 1 & Header 2 \\\\\\\\
    \\\\hline
    Cell 1 & Cell 2 \\\\\\\\
    \\\\multicolumn{2}{|c|}{Merged cell} \\\\\\\\
    \\\\hline
  \\\\end{fntab}
  
  \\\\begin{fncode}[python]
def example():
    pass
  \\\\end{fncode}
}\")
  (search-backward \"Heading\")
  (message \"Rich LaTeX footnote inserted.\"))

(defun my/insert-rich-footnote-latex-nested ()
  \"Insert nested LaTeX rich footnote.\"
  (interactive)
  (insert \"\\\\rfn{%
  Main content\\\\rfnmark{B}.
  
  \\\\fnh{1}{Heading}
  
  \\\\begin{fnitemize}
    \\\\item Item with nested ref\\\\rfnmark{C}
  \\\\end{fnitemize}
  
  \\\\rfntext{B}{%
    Second level.
    \\\\fnh{2}{Nested Heading}
    \\\\begin{fnitemize}
      \\\\item Nested list
    \\\\end{fnitemize}
  }%
  \\\\rfntext{C}{Third level content.}%
}\")
  (search-backward \"Main content\")
  (message \"Nested rich LaTeX footnote inserted.\"))

(defun my/insert-rich-footnote-typst ()
  \"Insert a Typst rich footnote template.\"
  (interactive)
  (insert \"#rfn[
  #fnh(1)[Heading]
  
  - List item 1
    - Nested item
  - List item 2
  
  + Numbered item 1
  + Numbered item 2
  
  #fn-table(
    caption: \\\"My Table\\\",
    columns: 2,
    [Header 1], [Header 2],
    [Cell 1], [Cell 2],
    table.cell(colspan: 2)[Merged],
  )
  
  #fn-code(lang: \\\"python\\\", ```
  def example():
      pass
  ```)
  
  #rfn[Nested footnote]
]\")
  (search-backward \"Heading\")
  (message \"Rich Typst footnote inserted.\"))

(defun my/insert-rich-footnote-context ()
  \"Insert a ConTeXt rich footnote template.\"
  (interactive)
  (insert \"\\\\startRFN
\\\\fnh[1]{Heading}

\\\\startfnitemize
\\\\item First item
\\\\startfnitemize
\\\\item Nested item
\\\\stopfnitemize
\\\\stopfnitemize

\\\\fntablecaption{My Table}
\\\\startfntable
\\\\NC Header 1 \\\\NC Header 2 \\\\NC\\\\NR
\\\\NC Cell 1 \\\\NC Cell 2 \\\\NC\\\\NR
\\\\NC \\\\use{2}{Merged} \\\\NC\\\\NR
\\\\stopfntable

\\\\startfncode
def example():
    pass
\\\\stopfncode

\\\\startRFN
Nested footnote
\\\\stopRFN
\\\\stopRFN\")
  (search-backward \"Heading\")
  (message \"Rich ConTeXt footnote inserted.\"))

(defun my/insert-rich-footnote-org ()
  \"Insert an Org rich footnote block.\"
  (interactive)
  (let ((id (read-string \"Footnote ID: \" \"1\")))
    (insert (format \"#+BEGIN_RICHFN %s
* Heading

- List item 1
  - Nested item
- List item 2

1. Numbered item 1
2. Numbered item 2

- Term :: Description

| Header 1 | Header 2 |
|----------+----------|
| Cell 1   | Cell 2   |

#+begin_src python
def example():
    pass
#+end_src

Nested footnote[fn:%s-nested].

#+BEGIN_RICHFN %s-nested
Nested footnote content.
#+END_RICHFN
#+END_RICHFN

Reference: [fn:%s]\" id id id id))
    (search-backward \"Heading\")
    (message \"Rich Org footnote block inserted. Reference with [fn:%s].\" id)))

(defun my/insert-rich-footnote-org-auto ()
  \"Insert auto-detected rich footnote in Org.\"
  (interactive)
  (let ((id (read-string \"Footnote ID: \" \"1\")))
    (save-excursion
      (goto-char (point-max))
      (insert (format \"

[fn:%s]
* Heading

- List item 1
  - Nested item
- List item 2

| Col A | Col B |
|-------+-------|
| 1     | 2     |
\" id)))
    (insert (format \"[fn:%s]\" id))
    (message \"Auto-detected rich footnote created. Definition at end of buffer.\")))
#+end_src

