\"\"\"
html2org_combined.py — Convert HTML (including HTML inside .txt files) to Org mode
with a clickable in-buffer TOC.

Usage:
  python3 html2org_combined.py <input_dir> [output_dir]

- Recursively converts: *.html, *.htm, *.txt
- Output is .org with preserved directory structure (if output_dir provided)
- TOC links target headings via CUSTOM_ID properties (works in-buffer)
\"\"\"

import re
import sys
from pathlib import Path
from html.parser import HTMLParser


# ─── Small utilities ─────────────────────────────────────────────────────────

_ws_re = re.compile(r\"\\s+\")


def normalize_ws(s: str) -> str:
    return _ws_re.sub(\" \", s).strip()


# ─── Parser ─────────────────────────────────────────────────────────────────

class GemaraHTMLParser(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.stack: list[str] = []

        self.out: list[str] = []  # output chunks
        self.headings: list[dict] = []  # {level, text, id}

        self._heading_level: int | None = None
        self._heading_buf: list[str] = []

        self._sec_counter = 0

    # ----- output helpers -----

    def _append(self, s: str) -> None:
        if s:
            self.out.append(s)

    def _append_newlines(self, n: int = 1) -> None:
        \"\"\"Append up to 2 consecutive newlines overall (cap runs).\"\"\"
        if n <= 0:
            return

        if not self.out:
            self.out.append(\"\\n\" * min(n, 2))
            return

        tail = self.out[-1]
        existing = 0
        i = len(tail) - 1
        while i >= 0 and tail[i] == \"\\n\":
            existing += 1
            i -= 1

        existing = min(existing, 2)
        want = min(n, 2)
        add = max(0, want - existing)
        if add:
            self.out.append(\"\\n\" * add)

    def _append_text_with_spacing(self, s: str) -> None:
        \"\"\"Append text; add a space if tags split tokens.\"\"\"
        if not s:
            return
        if not self.out:
            self.out.append(s)
            return

        prev = self.out[-1]
        prev_last = prev[-1] if prev else \"\"
        next_first = s[0]

        needs_space = (
            prev_last
            and prev_last not in (\" \", \"\\n\", \"\\t\")
            and next_first not in (\" \", \"\\n\", \"\\t\", \".\", \",\", \":\", \";\", \"!\", \"?\", \")\", \"]\")
            and (prev_last.isalnum() or prev_last in (\"*\", \"/\", \"_\"))
        )

        self.out.append((\" \" if needs_space else \"\") + s)

    def _inline_markup(self, text: str) -> str:
        \"\"\"Wrap text with the active Org markers (bold/italic/underline).\"\"\"
        if \"pre\" in self.stack:
            return text

        bold = any(t in self.stack for t in (\"strong\", \"b\"))
        italic = any(t in self.stack for t in (\"em\", \"i\"))
        underline = \"u\" in self.stack

        prefix = \"\"
        suffix = \"\"
        if bold:
            prefix += \"*\"
            suffix = \"*\" + suffix
        if italic:
            prefix += \"/\"
            suffix = \"/\" + suffix
        if underline:
            prefix += \"_\"
            suffix = \"_\" + suffix

        return f\"{prefix}{text}{suffix}\"

    # ----- TOC helpers -----

    def _next_sec_id(self) -> str:
        self._sec_counter += 1
        return f\"sec-{self._sec_counter:04d}\"

    # ----- HTMLParser callbacks -----

    def handle_starttag(self, tag, attrs):
        tag = tag.lower()
        self.stack.append(tag)

        if tag in (\"script\", \"style\"):
            return

        # Headings: buffer text until closing tag
        if tag in (\"h1\", \"h2\", \"h3\", \"h4\", \"h5\", \"h6\"):
            self._heading_level = int(tag[1])
            self._heading_buf = []
            return

        # Block-ish handling
        if tag == \"br\":
            self._append_newlines(1)
        elif tag == \"p\":
            self._append_newlines(2)
        elif tag in (\"div\", \"section\", \"article\"):
            self._append_newlines(1)
        elif tag == \"hr\":
            self._append_newlines(1)
            self._append(\"-----\")
            self._append_newlines(2)
        elif tag == \"li\":
            depth = sum(1 for t in self.stack if t in (\"ul\", \"ol\")) - 1
            indent = \"  \" * max(depth, 0)
            self._append_newlines(1)
            self._append(f\"{indent}- \")

    def handle_endtag(self, tag):
        tag = tag.lower()

        # Pop stack to this tag (tolerate broken nesting)
        while self.stack:
            t = self.stack.pop()
            if t == tag:
                break

        if tag in (\"script\", \"style\"):
            return

        # Finish heading
        if tag in (\"h1\", \"h2\", \"h3\", \"h4\", \"h5\", \"h6\") and self._heading_level is not None:
            text = normalize_ws(\"\".join(self._heading_buf))
            level = self._heading_level
            sec_id = self._next_sec_id()

            self.headings.append({\"level\": level, \"text\": text, \"id\": sec_id})

            stars = \"*\" * level
            self._append_newlines(2)
            self._append(f\"{stars} {text}\\n\")
            self._append(\":PROPERTIES:\\n\")
            self._append(f\":CUSTOM_ID: {sec_id}\\n\")
            self._append(\":END:\\n\")
            self._append_newlines(1)

            self._heading_level = None
            self._heading_buf = []
            return

        # End of blocks
        if tag == \"p\":
            self._append_newlines(2)
        elif tag in (\"div\", \"section\", \"article\", \"blockquote\"):
            self._append_newlines(1)
        elif tag == \"li\":
            self._append_newlines(1)

    def handle_data(self, data):
        if not data:
            return

        if any(t in self.stack for t in (\"script\", \"style\")):
            return

        # Heading text collection (no org markup inside)
        if self._heading_level is not None:
            self._heading_buf.append(data)
            return

        if \"pre\" in self.stack:
            self._append(data)
            return

        text = normalize_ws(data)
        if not text:
            return

        text = self._inline_markup(text)
        self._append_text_with_spacing(text)

    # ----- Org assembly -----

    def build_toc(self) -> str:
        if not self.headings:
            return \"\"

        min_level = min(h[\"level\"] for h in self.headings)
        lines = [\"* תוכן עניינים\\n\"]
        for h in self.headings:
            indent = \"  \" * (h[\"level\"] - min_level)
            lines.append(f\"{indent}- [[#{h['id']}][{h['text']}]]\\n\")
        return \"\".join(lines) + \"\\n\"

    def get_org(self, fallback_title: str = \"\") -> str:
        title = fallback_title
        if self.headings and self.headings[0][\"text\"]:
            title = self.headings[0][\"text\"]

        header = (
            f\"#+TITLE: {title}\\n\"
            f\"#+LANGUAGE: he\\n\"
            f\"#+OPTIONS: toc:nil num:nil\\n\\n\"
        )

        body = \"\".join(self.out)
        body = re.sub(r\"\\n{3,}\", \"\\n\\n\", body).strip() + \"\\n\"
        return header + self.build_toc() + body


# ─── Conversion ──────────────────────────────────────────────────────────────

def convert_file(input_path: Path, output_path: Path) -> None:
    html = input_path.read_text(encoding=\"utf-8\", errors=\"replace\")
    parser = GemaraHTMLParser()
    parser.feed(html)
    parser.close()

    org = parser.get_org(fallback_title=input_path.stem)

    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(org, encoding=\"utf-8\")
    print(f\"  ✔  {input_path}  →  {output_path}\")


def main() -> None:
    if len(sys.argv) not in (2, 3):
        print(\"Usage:\\n  python3 html2org_combined.py <input_dir> [output_dir]\")
        sys.exit(1)

    input_dir = Path(sys.argv[1])
    output_dir = Path(sys.argv[2]) if len(sys.argv) == 3 else None

    if not input_dir.is_dir():
        print(f\"Error: '{input_dir}' is not a directory.\")
        sys.exit(1)

    input_files = sorted(
        list(input_dir.rglob(\"*.html\"))
        + list(input_dir.rglob(\"*.htm\"))
        + list(input_dir.rglob(\"*.txt\"))
    )

    if not input_files:
        print(f\"No .html/.htm/.txt files found in '{input_dir}'.\")
        sys.exit(0)

    print(f\"Found {len(input_files)} file(s). Converting...\\n\")

    for f in input_files:
        if output_dir:
            out = output_dir / f.relative_to(input_dir).with_suffix(\".org\")
        else:
            out = f.with_suffix(\".org\")
        convert_file(f, out)

    print(f\"\\nDone! {len(input_files)} file(s) converted.\")


if __name__ == \"__main__\":
    main()" "#!/usr/bin/env python3
\"\"\"
Convert HTML Gemara files to Org mode with an automatic, clickable TOC.
Usage: python3 html2org_combined.py <input_dir> [output_dir]

If output_dir is omitted, .org files are written beside the source files.
The script also processes *.txt files that contain HTML markup.
\"\"\"

import sys
import re
from pathlib import Pathfrom html.parser import HTMLParser


# ----------------------------------------------------------------------
# Org‑mode HTML parser
# ----------------------------------------------------------------------
class OrgHTMLParser(HTMLParser):
    \"\"\"
    Walks the HTML tree, builds Org markup and records headings for a TOC.
    \"\"\"

    # mapping of HTML tags to Org formatting markers
    _FORMAT_TAGS = {
        'b': 'bold',
        'strong': 'bold',
        'i': 'italic',
        'em': 'italic',
        'u': 'underline',
    }

    def __init__(self):
        super().__init__()
        # ----- output pieces ------------------------------------------------
        self.org_parts: list[str] = []          # final Org body (without TOC)
        # ----- heading collection for TOC ----------------------------------
        self.headings: list[tuple[int, str]] = []   # (level, plain_text)
        # ----- formatting state (bold / italic / underline) ----------------
        self.fmt = {'bold': 0, 'italic': 0, 'underline': 0}
        # ----- tag stack (only needed to know when we leave a heading) -----        self.tag_stack: list[str] = []
        # ----- heading‑specific buffers -------------------------------------        self.in_heading = False
        self.heading_level = 0
        self.heading_org: list[str] = []   # Org‑markup inside the heading
        self.heading_plain: list[str] = [] # plain text for the TOC link    # ------------------------------------------------------------------
    # Helper: apply current formatting to a piece of data
    # ------------------------------------------------------------------
    def _apply_fmt(self, data: str) -> str:
        \"\"\"Wrap *data* with the active Org markers (bold, italic, underline).\"\"\"
        # order: bold → italic → underline (Org allows nesting)
        if self.fmt['bold']:
            data = f\"*{data}*\"
        if self.fmt['italic']:
            data = f\"/{data}/\"
        if self.fmt['underline']:
            data = f\"_{data}_\"
        return data

    # ------------------------------------------------------------------
    # HTMLParser callbacks
    # ------------------------------------------------------------------
    def handle_starttag(self, tag: str, attrs):
        tag_lc = tag.lower()
        self.tag_stack.append(tag_lc)

        # ---- formatting tags ------------------------------------------------
        if tag_lc in self._FORMAT_TAGS:
            self.fmt[self._FORMAT_TAGS[tag_lc]] += 1
            return

        # ---- block tags that affect layout ----------------------------------
        if tag_lc == 'br':
            self._add('\\n')
            return
        if tag_lc == 'p':
            # a paragraph starts with a blank line
            self._add('\\n\\n')
            return

        # ---- headings -------------------------------------------------------
        m = re.fullmatch(r'h([1-6])', tag_lc)
        if m:
            self.in_heading = True
            self.heading_level = int(m.group(1))
            self.heading_org = []      # reset buffers for this heading
            self.heading_plain = []
            return

        # ---- other tags (div, span, big, small, etc.) are ignored ------------
        # they neither affect formatting nor layout in our Org output.

    def handle_endtag(self, tag: str):
        tag_lc = tag.lower()
        if not self.tag_stack or self.tag_stack[-1] != tag_lc:
            # malformed HTML – try to recover by popping until we find it
            try:
                idx = self.tag_stack[::-1].index(tag_lc)
                self.tag_stack = self.tag_stack[:-idx-1]
            except ValueError:
                pass
        else:
            self.tag_stack.pop()

        # ---- undo formatting -------------------------------------------------
        if tag_lc in self._FORMAT_TAGS:
            fmt_key = self._FORMAT_TAGS[tag_lc]
            if self.fmt[fmt_key] > 0:
                self.fmt[fmt_key] -= 1
            return

        # ---- block tags ------------------------------------------------------
        if tag_lc == 'p':
            # closing a paragraph – nothing extra needed
            return
        if tag_lc == 'br':
            # already handled in starttag
            return

        # ---- heading finished ------------------------------------------------
        m = re.fullmatch(r'h([1-6])', tag_lc)
        if m and self.in_heading:
            level = int(m.group(1))
            plain = ''.join(self.heading_plain).strip()
            org_body = ''.join(self.heading_org).strip()
            if org_body:                     # avoid empty headings
                self.org_parts.append('*' * level + ' ' + org_body)
                self.headings.append((level, plain))
            # reset heading state
            self.in_heading = False
            self.heading_level = 0
            self.heading_org = []
            self.heading_plain = []
            return

        # ---- other tags (div, span, etc.) – nothing to do --------------------
        # they simply close; any layout effect was already handled at start.

    def handle_data(self, data: str):
        if not data:
            return

        # ---- inside a heading? ------------------------------------------------
        if self.in_heading:
            # plain text for the TOC link
            self.heading_plain.append(data)
            # Org‑markup version (with possible bold/italic/underline)
            formatted = self._apply_fmt(data)
            self.heading_org.append(formatted)
            return

        # ---- normal body text -------------------------------------------------        formatted = self._apply_fmt(data)
        self.org_parts.append(formatted)

    # ------------------------------------------------------------------
    # Small wrapper to keep the code tidy
    # ------------------------------------------------------------------
    def _add(self, txt: str):
        self.org_parts.append(txt)
        if self.in_heading:
            self.heading_org.append(txt)
            self.heading_plain.append(txt)   # newline is part of plain text as well


# ----------------------------------------------------------------------
# TOC builder (same logic as option 2, but using the collected headings)
# ----------------------------------------------------------------------
def build_toc(headings: list[tuple[int, str]]) -> str:
    if not headings:
        return \"\"
    lines = [\"* תוכן עניינים\\n\"]
    min_level = min(l for l, _ in headings)
    for level, text in headings:
        indent = \"  \" * (level - min_level)
        lines.append(f\"{indent}- [[*{text}][{text}]]\\n\")
    return \"\".join(lines) + \"\\n\"


# ----------------------------------------------------------------------
# Conversion routine (single file)
# ----------------------------------------------------------------------
def convert_html_to_org(html_text: str) -> str:
    parser = OrgHTMLParser()
    parser.feed(html_text)

    body = \"\".join(parser.org_parts).strip()

    # Collapse three or more blank lines to two (Org likes at most one blank line)
    body = re.sub(r\"\\n{3,}\", \"\\n\\n\", body)

    toc = build_toc(parser.headings)

    return toc + body + \"\\n\"


# ----------------------------------------------------------------------
# File I/O & CLI
# ----------------------------------------------------------------------
def convert_file(in_path: Path, out_path: Path):
    text = in_path.read_text(encoding=\"utf-8\")
    org = convert_html_to_org(text)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(org, encoding=\"utf-8\")
    print(f\"  ✔  {in_path}  →  {out_path}\")


def main():
    if len(sys.argv) < 2 or len(sys.argv) > 3:
        print(\"Usage:\")
        print(\"  python3 html2org_combined.py <input_dir> [output_dir]\")
        sys.exit(1)

    input_dir = Path(sys.argv[1])
    output_dir = Path(sys.argv[2]) if len(sys.argv) == 3 else None

    if not input_dir.is_dir():
        print(f\"Error: '{input_dir}' is not a directory.\")
        sys.exit(1)

    # Accept both .html/.htm and .txt files (the latter may contain HTML)
    patterns = [\"*.html\", \"*.htm\", \"*.txt\"]
    files = []
    for pat in patterns:
        files.extend(input_dir.rglob(pat))

    if not files:
        print(f\"No input files found in '{input_dir}'.\")
        sys.exit(0)

    print(f\"Found {len(files)} file(s). Converting...\\n\")
    for in_file in files:
        if output_dir:
            rel = in_file.relative_to(input_dir)
            out_file = output_dir / rel.with_suffix(\".org\")
        else:
            out_file = in_file.with_suffix(\".org\")
        convert_file(in_file, out_file)

    print(f\"\\nDone! {len(files)} file(s) converted.\")
    print(\"\\nIn Emacs open any .org file:\")
    print(\"  • Click on a TOC entry to jump to that heading\")
    print(\"  • Or press C-c C-x b for an interactive TOC buffer\")


