** Helper Functions

#+begin_src emacs-lisp
;;; ═══════════════════════════════════════════════════════════════
;;; RICH FOOTNOTE INSERTION HELPERS
;;; ═══════════════════════════════════════════════════════════════

(defun my/insert-rich-footnote-latex ()
  \"Insert a LaTeX rich footnote template.\"
  (interactive)
  (insert \"\\\\rfootnote{%
  \\\\fnhi{Heading}
  
  \\\\begin{fnlist}
    \\\\item First item
    \\\\item Second item
  \\\\end{fnlist}
  
  \\\\begin{fntable}{|l|l|}
    \\\\hline
    Header 1 & Header 2 \\\\\\\\
    \\\\hline
    Cell 1 & Cell 2 \\\\\\\\
    \\\\hline
  \\\\end{fntable}
}\")
  (search-backward \"Heading\")
  (message \"Rich footnote inserted. Edit content.\"))

(defun my/insert-rich-footnote-typst ()
  \"Insert a Typst rich footnote template.\"
  (interactive)
  (insert \"#footnote[
  = Heading
  
  - First item
  - Second item
  
  #table(
    columns: 2,
    [Header 1], [Header 2],
    [Cell 1], [Cell 2],
  )
]\")
  (search-backward \"Heading\")
  (message \"Rich footnote inserted. Edit content.\"))

(defun my/insert-rich-footnote-context ()
  \"Insert a ConTeXt rich footnote template.\"
  (interactive)
  (insert \"\\\\startfootnote
\\\\fnheadi{Heading}

\\\\startitemize
\\\\item First item
\\\\item Second item
\\\\stopitemize

\\\\starttabulate[|l|l|]
\\\\NC Header 1 \\\\NC Header 2 \\\\NC\\\\NR
\\\\NC Cell 1 \\\\NC Cell 2 \\\\NC\\\\NR
\\\\stoptabulate
\\\\stopfootnote\")
  (search-backward \"Heading\")
  (message \"Rich footnote inserted. Edit content.\"))

(defun my/insert-rich-footnote-org ()
  \"Insert an Org rich footnote block.\"
  (interactive)
  (let ((id (read-string \"Footnote ID: \" \"1\")))
    (insert (format \"#+BEGIN_RICHFN %s
* Heading

- First item
- Second item

| Header 1 | Header 2 |
|----------+----------|
| Cell 1   | Cell 2   |

#+END_RICHFN

Reference it with [fn:%s] in your text.\" id id))
    (search-backward \"Heading\")
    (message \"Rich footnote block inserted. Edit content, reference with [fn:%s].\" id)))

(defun my/insert-nested-rich-footnote-latex ()
  \"Insert a nested rich footnote template for LaTeX.\"
  (interactive)
  (insert \"\\\\rfootnote{%
  Main footnote content.\\\\rfootnotemarkB{}
  
  \\\\fnhi{Heading in Footnote}
  
  \\\\begin{fnlist}
    \\\\item Item with nested reference\\\\rfootnotemarkC{}
  \\\\end{fnlist}
  
  \\\\rfootnotetextB{%
    Second level footnote.
    \\\\fnhii{Nested Heading}
  }%
  \\\\rfootnotetextC{Third level footnote.}%
}\")
  (search-backward \"Main footnote\")
  (message \"Nested rich footnote inserted.\"))

(defun my/insert-latex-rich-preamble ()
  \"Insert LaTeX rich footnotes preamble.\"
  (interactive)
  (insert my/latex-rich-footnotes-preamble))
#+end_src

