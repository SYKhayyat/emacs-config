  (use-package undo-tree
    :diminish undo-tree-mode
    :config
    (global-undo-tree-mode)

    ;; Save undo history between sessions
    (setq undo-tree-auto-save-history t)
    (setq undo-tree-history-directory-alist
          '((\".\" . \"~/.emacs.d/undo-tree-history/\")))

