                      (string-trim
                       (shell-command-to-string
                        (format \"du -sh '%s' 2>/dev/null | cut -f1\"
                                seforim-directory))))))

    (insert \"\\n[q] close\\n\")
    (goto-char (point-min))
    (local-set-key (kbd \"q\") #'quit-window)
    (display-buffer (current-buffer))))
