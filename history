#+begin_src emacs-lisp
;;; ═══════════════════════════════════════════════════════════════════════════
;;; ORG RICH FOOTNOTES PREPROCESSOR
;;; ═══════════════════════════════════════════════════════════════════════════

(defvar my/richfn-debug nil \"Enable debug messages for rich footnotes.\")

(defun my/richfn--log (fmt &rest args)
  \"Log message if debugging enabled.\"
  (when my/richfn-debug
    (apply #'message (concat \"RichFN: \" fmt) args)))

(defun my/richfn--has-rich-content-p (text)
  \"Check if TEXT contains rich org content.\"
  (and text
       (string-match-p
        (rx (or
             (seq bol (+ \"*\") \" \")
             (seq bol (* space) (any \"-+\") \" \")
             (seq bol (* space) (+ digit) (any \".)\") \" \")
             (seq bol (* space) \"|\")
             (seq bol (* space) \"#+begin_src\")
             (seq bol (* space) \"#+BEGIN_SRC\")
             (seq \"[fn:\")))
        text)))

(defun my/richfn--get-footnote-definitions ()
  \"Get all footnote definitions as alist of (id start end content).\"
  (let ((footnotes nil))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward \"^\\\\[fn:\\\\([^]]+\\\\)\\\\][ \\t]*\" nil t)
        (let* ((id (match-string-no-properties 1))
               (start (match-beginning 0))
               (content-start (point))
               (end (save-excursion
                      (if (re-search-forward \"^\\\\[fn:\\\\|^\\\\*+ \\\\|\\\\'\" nil t)
                          (match-beginning 0)
                        (point-max))))
               (content (string-trim
                         (buffer-substring-no-properties content-start end))))
          (push (list id start end content) footnotes))))
    (nreverse footnotes)))

(defun my/richfn--parse-rich-blocks ()
  \"Parse #+BEGIN_RICHFN blocks. Returns list of (id start end content).\"
  (let ((blocks nil))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward \"^[ \\t]*#\\\\+BEGIN_RICHFN[ \\t]+\\\\([^ \\t\\n]+\\\\)\" nil t)
        (let* ((id (match-string-no-properties 1))
               (block-start (line-beginning-position))
               (content-start (1+ (line-end-position)))
               (depth 1)
               (block-end nil)
               (content-end nil))
          ;; Find matching END_RICHFN (handle nesting)
          (while (and (> depth 0)
                      (re-search-forward \"^[ \\t]*#\\\\+\\\\(BEGIN\\\\|END\\\\)_RICHFN\" nil t))
            (if (string= (match-string 1) \"BEGIN\")
                (setq depth (1+ depth))
              (setq depth (1- depth))
              (when (= depth 0)
                (setq content-end (line-beginning-position))
                (setq block-end (line-end-position)))))
          (when block-end
            (let ((content (string-trim
                            (buffer-substring-no-properties content-start content-end))))
              (push (list id block-start block-end content) blocks))))))
    (nreverse blocks)))

(defun my/richfn--org-to-latex (text)
  \"Convert org TEXT to LaTeX for footnote.\"
  (with-temp-buffer
    (insert text)
    
    ;; Process nested RICHFN blocks first (recursive)
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+BEGIN_RICHFN[ \\t]+\\\\([^ \\t\\n]+\\\\)\" nil t)
      (let* ((nested-id (match-string-no-properties 1))
             (nested-start (line-beginning-position))
             (content-start (1+ (line-end-position)))
             (depth 1)
             (nested-end nil)
             (content-end nil))
        (while (and (> depth 0)
                    (re-search-forward \"^[ \\t]*#\\\\+\\\\(BEGIN\\\\|END\\\\)_RICHFN\" nil t))
          (if (string= (match-string 1) \"BEGIN\")
              (setq depth (1+ depth))
            (setq depth (1- depth))
            (when (= depth 0)
              (setq content-end (line-beginning-position))
              (setq nested-end (1+ (line-end-position))))))
        (when nested-end
          (let* ((nested-content (buffer-substring-no-properties content-start content-end))
                 (converted (my/richfn--org-to-latex nested-content)))
            (delete-region nested-start nested-end)
            (goto-char nested-start)
            (insert (format \"\\\\rfnmark{B}\\\\rfntext{B}{%s}\" converted))))))
    
    ;; Convert headings (20 levels)
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\(\\\\*+\\\\) \\\\(.*\\\\)$\" nil t)
      (let ((level (min 20 (length (match-string 1))))
            (title (match-string 2)))
        (replace-match (format \"\\\\\\\\fnh{%d}{%s}\" level title) t t)))
    
    ;; Convert description lists
    (goto-char (point-min))
    (let ((in-desc nil)
          (desc-regions nil))
      (while (re-search-forward \"^\\\\([ \\t]*\\\\)- \\\\([^:\\n]+\\\\) :: \\\\(.*\\\\)$\" nil t)
        (let ((indent (match-string 1))
              (term (match-string 2))
              (desc (match-string 3))
              (start (match-beginning 0)))
          (unless in-desc
            (setq in-desc start))
          (replace-match (format \"%s\\\\\\\\item[%s] %s\" indent term desc) t t)))
      ;; Wrap description items
      (goto-char (point-min))
      (while (re-search-forward \"\\\\(\\\\\\\\item\\\\[[^]]*\\\\].*\\n\\\\)+\" nil t)
        (let ((items (match-string 0))
              (start (match-beginning 0))
              (end (match-end 0)))
          (delete-region start end)
          (goto-char start)
          (insert \"\\\\begin{fndescription}\\n\" items \"\\\\end{fndescription}\\n\"))))
    
    ;; Convert unordered lists
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\([ \\t]*\\\\)[-+] \\\\(.*\\\\)$\" nil t)
      (let ((indent (match-string 1))
            (content (match-string 2)))
        (replace-match (format \"%s\\\\\\\\item %s\" indent content) t t)))
    
    ;; Convert ordered lists
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\([ \\t]*\\\\)[0-9]+[.)] \\\\(.*\\\\)$\" nil t)
      (let ((indent (match-string 1))
            (content (match-string 2)))
        (replace-match (format \"%s\\\\\\\\itemenum %s\" indent content) t t)))
    
    ;; Wrap unordered items
    (goto-char (point-min))
    (while (re-search-forward \"\\\\(^[ \\t]*\\\\\\\\item [^\\n]*\\n\\\\)+\" nil t)
      (let ((items (match-string 0))
            (start (match-beginning 0))
            (end (match-end 0)))
        (delete-region start end)
        (goto-char start)
        (insert \"\\\\begin{fnitemize}\\n\" items \"\\\\end{fnitemize}\\n\")))
    
    ;; Wrap ordered items
    (goto-char (point-min))
    (while (re-search-forward \"\\\\(^[ \\t]*\\\\\\\\itemenum [^\\n]*\\n\\\\)+\" nil t)
      (let ((items (replace-regexp-in-string \"\\\\\\\\itemenum\" \"\\\\\\\\item\" (match-string 0)))
            (start (match-beginning 0))
            (end (match-end 0)))
        (delete-region start end)
        (goto-char start)
        (insert \"\\\\begin{fnenumerate}\\n\" items \"\\\\end{fnenumerate}\\n\")))
    
    ;; Convert tables
    (goto-char (point-min))
    (my/richfn--convert-org-tables-latex)
    
    ;; Convert code blocks
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+\\\\(begin_src\\\\|BEGIN_SRC\\\\)\\\\(?: \\\\([^ \\t\\n]+\\\\)\\\\)?[^\\n]*\\n\\\\(\\\\(?:.*\\n\\\\)*?\\\\)[ \\t]*#\\\\+\\\\(end_src\\\\|END_SRC\\\\)\" nil t)
      (let ((lang (or (match-string 2) \"\"))
            (code (match-string 3)))
        (replace-match (format \"\\\\\\\\begin{fncode}[%s]\\n%s\\\\\\\\end{fncode}\" lang code) t t)))
    
    ;; Convert inline code
    (goto-char (point-min))
    (while (re-search-forward \"~\\\\([^~\\n]+\\\\)~\" nil t)
      (replace-match \"\\\\\\\\fnc{\\\\1}\" t nil))
    (goto-char (point-min))
    (while (re-search-forward \"=\\\\([^=\\n]+\\\\)=\" nil t)
      (replace-match \"\\\\\\\\fnc{\\\\1}\" t nil))
    
    ;; Convert footnote references
    (goto-char (point-min))
    (while (re-search-forward \"\\\\[fn:\\\\([^]]+\\\\)\\\\]\" nil t)
      (replace-match \"\\\\\\\\rfnmark{B}\" t t))
    
    (buffer-string)))

(defun my/richfn--convert-org-tables-latex ()
  \"Convert all org tables in buffer to LaTeX.\"
  (goto-char (point-min))
  (while (re-search-forward \"^[ \\t]*|\" nil t)
    (let ((table-start (line-beginning-position))
          (rows nil)
          (col-count 0)
          (caption nil))
      ;; Check for caption above table
      (save-excursion
        (forward-line -1)
        (when (looking-at \"^[ \\t]*#\\\\+\\\\(CAPTION\\\\|caption\\\\):[ \\t]*\\\\(.*\\\\)$\")
          (setq caption (match-string 2))
          (setq table-start (line-beginning-position))))
      ;; Parse table rows
      (goto-char table-start)
      (when caption (forward-line 1))
      (while (looking-at \"^[ \\t]*|\\\\(.*\\\\)|[ \\t]*$\")
        (let* ((line (match-string 1))
               (cells (split-string line \"|\"))
               (is-sep (and cells (string-match-p \"^[-+]+$\" (string-trim (car cells))))))
          (unless is-sep
            (setq col-count (max col-count (length cells)))
            (push (mapcar #'string-trim cells) rows)))
        (forward-line 1))
      (let ((table-end (point)))
        (setq rows (nreverse rows))
        ;; Build LaTeX table
        (let ((latex
               (concat
                (if caption
                    (format \"\\\\begin{fntab}{|%s|}[%s]\\n\"
                            (mapconcat (lambda (_) \"l\") (number-sequence 1 col-count) \"|\")
                            caption)
                  (format \"\\\\begin{fntab}{|%s|}\\n\"
                          (mapconcat (lambda (_) \"l\") (number-sequence 1 col-count) \"|\")))
                \"\\\\hline\\n\"
                (mapconcat
                 (lambda (row)
                   (concat (mapconcat #'identity row \" & \") \" \\\\\\\\\"))
                 rows
                 \"\\n\")
                \"\\n\\\\hline\\n\\\\end{fntab}\\n\")))
          (delete-region table-start table-end)
          (goto-char table-start)
          (insert latex))))))

(defun my/richfn--org-to-typst (text)
  \"Convert org TEXT to Typst for footnote.\"
  (with-temp-buffer
    (insert text)
    
    ;; Process nested RICHFN blocks
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+BEGIN_RICHFN[ \\t]+\\\\([^ \\t\\n]+\\\\)\" nil t)
      (let* ((nested-start (line-beginning-position))
             (content-start (1+ (line-end-position)))
             (depth 1)
             (nested-end nil)
             (content-end nil))
        (while (and (> depth 0)
                    (re-search-forward \"^[ \\t]*#\\\\+\\\\(BEGIN\\\\|END\\\\)_RICHFN\" nil t))
          (if (string= (match-string 1) \"BEGIN\")
              (setq depth (1+ depth))
            (setq depth (1- depth))
            (when (= depth 0)
              (setq content-end (line-beginning-position))
              (setq nested-end (1+ (line-end-position))))))
        (when nested-end
          (let* ((nested-content (buffer-substring-no-properties content-start content-end))
                 (converted (my/richfn--org-to-typst nested-content)))
            (delete-region nested-start nested-end)
            (goto-char nested-start)
            (insert (format \"#footnote[%s]\" converted))))))
    
    ;; Convert headings
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\(\\\\*+\\\\) \\\\(.*\\\\)$\" nil t)
      (let ((level (min 20 (length (match-string 1))))
            (title (match-string 2)))
        (replace-match (format \"#fnh(%d)[%s]\" level title) t t)))
    
    ;; Lists work natively in Typst
    
    ;; Convert tables
    (goto-char (point-min))
    (my/richfn--convert-org-tables-typst)
    
    ;; Convert code blocks
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+\\\\(begin_src\\\\|BEGIN_SRC\\\\)\\\\(?: \\\\([^ \\t\\n]+\\\\)\\\\)?[^\\n]*\\n\\\\(\\\\(?:.*\\n\\\\)*?\\\\)[ \\t]*#\\\\+\\\\(end_src\\\\|END_SRC\\\\)\" nil t)
      (let ((lang (or (match-string 2) \"\"))
            (code (string-trim-right (match-string 3))))
        (if (string= lang \"\")
            (replace-match (format \"#fn-code[```\\n%s```]\" code) t t)
          (replace-match (format \"#fn-code(lang: \\\"%s\\\")[```%s\\n%s```]\" lang lang code) t t))))
    
    ;; Convert inline code
    (goto-char (point-min))
    (while (re-search-forward \"~\\\\([^~\\n]+\\\\)~\" nil t)
      (replace-match \"`\\\\1`\" t nil))
    (goto-char (point-min))
    (while (re-search-forward \"=\\\\([^=\\n]+\\\\)=\" nil t)
      (replace-match \"`\\\\1`\" t nil))
    
    ;; Convert footnote references
    (goto-char (point-min))
    (while (re-search-forward \"\\\\[fn:\\\\([^]]+\\\\)\\\\]\" nil t)
      (replace-match \"#footnote[]\" t t))
    
    (buffer-string)))

(defun my/richfn--convert-org-tables-typst ()
  \"Convert all org tables in buffer to Typst.\"
  (goto-char (point-min))
  (while (re-search-forward \"^[ \\t]*|\" nil t)
    (let ((table-start (line-beginning-position))
          (rows nil)
          (col-count 0)
          (caption nil))
      ;; Check for caption
      (save-excursion
        (forward-line -1)
        (when (looking-at \"^[ \\t]*#\\\\+\\\\(CAPTION\\\\|caption\\\\):[ \\t]*\\\\(.*\\\\)$\")
          (setq caption (match-string 2))
          (setq table-start (line-beginning-position))))
      ;; Parse rows
      (goto-char table-start)
      (when caption (forward-line 1))
      (while (looking-at \"^[ \\t]*|\\\\(.*\\\\)|[ \\t]*$\")
        (let* ((line (match-string 1))
               (cells (split-string line \"|\"))
               (is-sep (and cells (string-match-p \"^[-+]+$\" (string-trim (car cells))))))
          (unless is-sep
            (setq col-count (max col-count (length cells)))
            (push (mapcar #'string-trim cells) rows)))
        (forward-line 1))
      (let ((table-end (point)))
        (setq rows (nreverse rows))
        (let ((typst
               (concat
                (if caption
                    (format \"#fn-table(caption: \\\"%s\\\",\\n  columns: %d,\\n\" caption col-count)
                  (format \"#fn-table(\\n  columns: %d,\\n\" col-count))
                (mapconcat
                 (lambda (row)
                   (mapconcat (lambda (cell) (format \"  [%s],\" cell)) row \"\\n\"))
                 rows
                 \"\\n\")
                \"\\n)\\n\")))
          (delete-region table-start table-end)
          (goto-char table-start)
          (insert typst))))))

(defun my/richfn--org-to-context (text)
  \"Convert org TEXT to ConTeXt for footnote.\"
  (with-temp-buffer
    (insert text)
    
    ;; Process nested RICHFN blocks
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+BEGIN_RICHFN[ \\t]+\\\\([^ \\t\\n]+\\\\)\" nil t)
      (let* ((nested-start (line-beginning-position))
             (content-start (1+ (line-end-position)))
             (depth 1)
             (nested-end nil)
             (content-end nil))
        (while (and (> depth 0)
                    (re-search-forward \"^[ \\t]*#\\\\+\\\\(BEGIN\\\\|END\\\\)_RICHFN\" nil t))
          (if (string= (match-string 1) \"BEGIN\")
              (setq depth (1+ depth))
            (setq depth (1- depth))
            (when (= depth 0)
              (setq content-end (line-beginning-position))
              (setq nested-end (1+ (line-end-position))))))
        (when nested-end
          (let* ((nested-content (buffer-substring-no-properties content-start content-end))
                 (converted (my/richfn--org-to-context nested-content)))
            (delete-region nested-start nested-end)
            (goto-char nested-start)
            (insert (format \"\\\\startRFNB %s \\\\stopRFNB\" converted))))))
    
    ;; Convert headings
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\(\\\\*+\\\\) \\\\(.*\\\\)$\" nil t)
      (let ((level (min 20 (length (match-string 1))))
            (title (match-string 2)))
        (replace-match (format \"\\\\\\\\fnh{%d}{%s}\" level title) t t)))
    
    ;; Convert lists
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\([ \\t]*\\\\)[-+] \\\\(.*\\\\)$\" nil t)
      (replace-match \"\\\\1\\\\\\\\item \\\\2\" t nil))
    
    ;; Wrap items
    (goto-char (point-min))
    (while (re-search-forward \"\\\\(^[ \\t]*\\\\\\\\item [^\\n]*\\n\\\\)+\" nil t)
      (let ((items (match-string 0))
            (start (match-beginning 0))
            (end (match-end 0)))
        (delete-region start end)
        (goto-char start)
        (insert \"\\\\startitemize[packed]\\n\" items \"\\\\stopitemize\\n\")))
    
    ;; Convert tables
    (goto-char (point-min))
    (my/richfn--convert-org-tables-context)
    
    ;; Convert code blocks
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+\\\\(begin_src\\\\|BEGIN_SRC\\\\)\\\\(?: \\\\([^ \\t\\n]+\\\\)\\\\)?[^\\n]*\\n\\\\(\\\\(?:.*\\n\\\\)*?\\\\)[ \\t]*#\\\\+\\\\(end_src\\\\|END_SRC\\\\)\" nil t)
      (let ((code (match-string 3)))
        (replace-match (format \"\\\\\\\\startfncode\\n%s\\\\\\\\stopfncode\" code) t t)))
    
    ;; Convert inline code
    (goto-char (point-min))
    (while (re-search-forward \"~\\\\([^~\\n]+\\\\)~\" nil t)
      (replace-match \"\\\\\\\\fnc{\\\\1}\" t nil))
    (goto-char (point-min))
    (while (re-search-forward \"=\\\\([^=\\n]+\\\\)=\" nil t)
      (replace-match \"\\\\\\\\fnc{\\\\1}\" t nil))
    
    ;; Convert footnote references
    (goto-char (point-min))
    (while (re-search-forward \"\\\\[fn:\\\\([^]]+\\\\)\\\\]\" nil t)
      (replace-match \"\\\\\\\\RFNB{}\" t t))
    
    (buffer-string)))

(defun my/richfn--convert-org-tables-context ()
  \"Convert all org tables in buffer to ConTeXt.\"
  (goto-char (point-min))
  (while (re-search-forward \"^[ \\t]*|\" nil t)
    (let ((table-start (line-beginning-position))
          (rows nil)
          (col-count 0)
          (caption nil))
      ;; Check for caption
      (save-excursion
        (forward-line -1)
        (when (looking-at \"^[ \\t]*#\\\\+\\\\(CAPTION\\\\|caption\\\\):[ \\t]*\\\\(.*\\\\)$\")
          (setq caption (match-string 2))
          (setq table-start (line-beginning-position))))
      ;; Parse rows
      (goto-char table-start)
      (when caption (forward-line 1))
      (while (looking-at \"^[ \\t]*|\\\\(.*\\\\)|[ \\t]*$\")
        (let* ((line (match-string 1))
               (cells (split-string line \"|\"))
               (is-sep (and cells (string-match-p \"^[-+]+$\" (string-trim (car cells))))))
          (unless is-sep
            (setq col-count (max col-count (length cells)))
            (push (mapcar #'string-trim cells) rows)))
        (forward-line 1))
      (let ((table-end (point)))
        (setq rows (nreverse rows))
        (let ((context
               (concat
                (when caption (format \"{\\\\bf %s}\\\\blank[small]\\n\" caption))
                (format \"\\\\starttabulate[|%s|]\\n\"
                        (mapconcat (lambda (_) \"l\") (number-sequence 1 col-count) \"|\"))
                (mapconcat
                 (lambda (row)
                   (concat \"\\\\NC \" (mapconcat #'identity row \" \\\\NC \") \" \\\\NC\\\\NR\"))
                 rows
                 \"\\n\")
                \"\\n\\\\stoptabulate\\n\")))
          (delete-region table-start table-end)
          (goto-char table-start)
          (insert context))))))

(defun my/richfn--org-to-html (text)
  \"Convert org TEXT to HTML for footnote.\"
  (with-temp-buffer
    (insert text)
    
    ;; Process nested RICHFN blocks
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+BEGIN_RICHFN[ \\t]+\\\\([^ \\t\\n]+\\\\)\" nil t)
      (let* ((nested-start (line-beginning-position))
             (content-start (1+ (line-end-position)))
             (depth 1)
             (nested-end nil)
             (content-end nil))
        (while (and (> depth 0)
                    (re-search-forward \"^[ \\t]*#\\\\+\\\\(BEGIN\\\\|END\\\\)_RICHFN\" nil t))
          (if (string= (match-string 1) \"BEGIN\")
              (setq depth (1+ depth))
            (setq depth (1- depth))
            (when (= depth 0)
              (setq content-end (line-beginning-position))
              (setq nested-end (1+ (line-end-position))))))
        (when nested-end
          (let* ((nested-content (buffer-substring-no-properties content-start content-end))
                 (converted (my/richfn--org-to-html nested-content)))
            (delete-region nested-start nested-end)
            (goto-char nested-start)
            (insert (format \"<span class=\\\"nested-footnote\\\">%s</span>\" converted))))))
    
    ;; Convert headings
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\(\\\\*+\\\\) \\\\(.*\\\\)$\" nil t)
      (let ((level (min 6 (length (match-string 1))))
            (title (match-string 2)))
        (replace-match (format \"<h%d>%s</h%d>\" level title level) t t)))
    
    ;; Convert lists
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\([ \\t]*\\\\)[-+] \\\\(.*\\\\)$\" nil t)
      (replace-match \"\\\\1<li>\\\\2</li>\" t nil))
    
    (goto-char (point-min))
    (while (re-search-forward \"\\\\(<li>.*</li>\\n\\\\)+\" nil t)
      (let ((items (match-string 0))
            (start (match-beginning 0))
            (end (match-end 0)))
        (delete-region start end)
        (goto-char start)
        (insert \"<ul>\\n\" items \"</ul>\\n\")))
    
    ;; Convert tables
    (goto-char (point-min))
    (my/richfn--convert-org-tables-html)
    
    ;; Convert code blocks
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+\\\\(begin_src\\\\|BEGIN_SRC\\\\)\\\\(?: \\\\([^ \\t\\n]+\\\\)\\\\)?[^\\n]*\\n\\\\(\\\\(?:.*\\n\\\\)*?\\\\)[ \\t]*#\\\\+\\\\(end_src\\\\|END_SRC\\\\)\" nil t)
      (let ((lang (or (match-string 2) \"\"))
            (code (match-string 3)))
        (replace-match (format \"<pre><code class=\\\"language-%s\\\">%s</code></pre>\" lang code) t t)))
    
    ;; Convert inline code
    (goto-char (point-min))
    (while (re-search-forward \"~\\\\([^~\\n]+\\\\)~\" nil t)
      (replace-match \"<code>\\\\1</code>\" t nil))
    (goto-char (point-min))
    (while (re-search-forward \"=\\\\([^=\\n]+\\\\)=\" nil t)
      (replace-match \"<code>\\\\1</code>\" t nil))
    
    (buffer-string)))

(defun my/richfn--convert-org-tables-html ()
  \"Convert all org tables in buffer to HTML.\"
  (goto-char (point-min))
  (while (re-search-forward \"^[ \\t]*|\" nil t)
    (let ((table-start (line-beginning-position))
          (rows nil)
          (caption nil))
      ;; Check for caption
      (save-excursion
        (forward-line -1)
        (when (looking-at \"^[ \\t]*#\\\\+\\\\(CAPTION\\\\|caption\\\\):[ \\t]*\\\\(.*\\\\)$\")
          (setq caption (match-string 2))
          (setq table-start (line-beginning-position))))
      ;; Parse rows
      (goto-char table-start)
      (when caption (forward-line 1))
      (while (looking-at \"^[ \\t]*|\\\\(.*\\\\)|[ \\t]*$\")
        (let* ((line (match-string 1))
               (cells (split-string line \"|\"))
               (is-sep (and cells (string-match-p \"^[-+]+$\" (string-trim (car cells))))))
          (unless is-sep
            (push (mapcar #'string-trim cells) rows)))
        (forward-line 1))
      (let ((table-end (point)))
        (setq rows (nreverse rows))
        (let ((html
               (concat
                \"<table>\\n\"
                (when caption (format \"<caption>%s</caption>\\n\" caption))
                (mapconcat
                 (lambda (row)
                   (concat \"<tr>\"
                           (mapconcat (lambda (cell) (format \"<td>%s</td>\" cell)) row \"\")
                           \"</tr>\"))
                 rows
                 \"\\n\")
                \"\\n</table>\\n\")))
          (delete-region table-start table-end)
          (goto-char table-start)
          (insert html))))))

(defun my/richfn--get-converter (backend)
  \"Get converter function for BACKEND.\"
  (pcase backend
    ((or 'latex 'beamer) #'my/richfn--org-to-latex)
    ('html #'my/richfn--org-to-html)
    (_ #'my/richfn--org-to-latex)))

(defun my/richfn-preprocess-buffer (backend)
  \"Preprocess rich footnotes before export to BACKEND.\"
  (my/richfn--log \"Preprocessing for backend: %s\" backend)
  
  (let ((converter (my/richfn--get-converter backend)))
    
    ;; Process explicit RICHFN blocks
    (let ((blocks (my/richfn--parse-rich-blocks)))
      (my/richfn--log \"Found %d RICHFN blocks\" (length blocks))
      (dolist (block (nreverse blocks))
        (let ((id (nth 0 block))
              (start (nth 1 block))
              (end (nth 2 block))
              (content (nth 3 block)))
          (my/richfn--log \"Processing block: %s\" id)
          (let ((converted (funcall converter content)))
            (delete-region start (1+ end))
            (save-excursion
              (goto-char (point-max))
              (insert (format \"\\n[fn:%s] %s\\n\" id converted)))))))
    
    ;; Auto-detect rich content in footnotes
    (let ((footnotes (my/richfn--get-footnote-definitions)))
      (my/richfn--log \"Checking %d footnotes\" (length footnotes))
      (dolist (fn (nreverse footnotes))
        (let ((id (nth 0 fn))
              (start (nth 1 fn))
              (end (nth 2 fn))
              (content (nth 3 fn)))
          (when (my/richfn--has-rich-content-p content)
            (my/richfn--log \"Converting footnote: %s\" id)
            (let ((converted (funcall converter content)))
              (delete-region start end)
              (goto-char start)
              (insert (format \"[fn:%s] %s\\n\" id converted)))))))))

;; Register with org export
(with-eval-after-load 'ox
  (add-hook 'org-export-before-processing-hook #'my/richfn-preprocess-buffer))
#+end_src

** Pandoc Integration

#+begin_src emacs-lisp
(use-package ox-pandoc
  :after org
  :config
  (setq org-pandoc-options '((standalone . t)))
  (setq org-pandoc-options-for-latex-pdf '((pdf-engine . \"lualatex\")))
  
  ;; Create temp preamble file for pandoc
  (defvar my/richfn-pandoc-preamble-file nil)
  
  (defun my/richfn-ensure-pandoc-preamble ()
    \"Ensure pandoc preamble file exists.\"
    (unless (and my/richfn-pandoc-preamble-file
                 (file-exists-p my/richfn-pandoc-preamble-file))
      (setq my/richfn-pandoc-preamble-file
            (make-temp-file \"richfn-preamble\" nil \".tex\"))
      (with-temp-file my/richfn-pandoc-preamble-file
        (insert my/latex-rich-footnotes-preamble)))
    my/richfn-pandoc-preamble-file)
  
  (defun my/richfn-pandoc-preprocess (&rest _)
    \"Preprocess for pandoc export.\"
    (my/richfn-preprocess-buffer 'latex))
  
  ;; Advice pandoc export functions
  (advice-add 'org-pandoc-export-to-latex-pdf :before #'my/richfn-pandoc-preprocess)
  (advice-add 'org-pandoc-export-as-latex :before #'my/richfn-pandoc-preprocess)
  
  ;; Add preamble to pandoc options
  (setq org-pandoc-options-for-latex-pdf
        `((pdf-engine . \"lualatex\")
          (include-in-header . ,(my/richfn-ensure-pandoc-preamble)))))
#+end_src

** LaTeX Preamble

#+begin_src emacs-lisp
(defvar my/latex-rich-footnotes-preamble
  \"% ══════════════════════════════════════════════════════════════════════════════
% RICH FOOTNOTES SYSTEM
% ══════════════════════════════════════════════════════════════════════════════

% ──────────────────────────────────────────────────────────────────────────────
% NESTED FOOTNOTES (10 levels)
% ──────────────────────────────────────────────────────────────────────────────
\\\\usepackage{bigfoot}
\\\\DeclareNewFootnote{default}
\\\\DeclareNewFootnote{B}
\\\\DeclareNewFootnote{C}
\\\\DeclareNewFootnote{D}
\\\\DeclareNewFootnote{E}
\\\\DeclareNewFootnote{F}
\\\\DeclareNewFootnote{G}
\\\\DeclareNewFootnote{H}
\\\\DeclareNewFootnote{I}
\\\\DeclareNewFootnote{J}

\\\\newcommand{\\\\rfn}[1]{\\\\footnote{#1}}
\\\\newcommand{\\\\rfnB}[1]{\\\\footnoteB{#1}}
\\\\newcommand{\\\\rfnC}[1]{\\\\footnoteC{#1}}
\\\\newcommand{\\\\rfnD}[1]{\\\\footnoteD{#1}}
\\\\newcommand{\\\\rfnE}[1]{\\\\footnoteE{#1}}
\\\\newcommand{\\\\rfnF}[1]{\\\\footnoteF{#1}}
\\\\newcommand{\\\\rfnG}[1]{\\\\footnoteG{#1}}
\\\\newcommand{\\\\rfnH}[1]{\\\\footnoteH{#1}}
\\\\newcommand{\\\\rfnI}[1]{\\\\footnoteI{#1}}
\\\\newcommand{\\\\rfnJ}[1]{\\\\footnoteJ{#1}}

\\\\newcommand{\\\\rfnmark}[1]{\\\\csname footnotemark#1\\\\endcsname}
\\\\newcommand{\\\\rfntext}[2]{\\\\csname footnotetext#1\\\\endcsname{#2}}

% ──────────────────────────────────────────────────────────────────────────────
% HEADINGS (20 levels)
% ──────────────────────────────────────────────────────────────────────────────
\\\\usepackage{xparse}

\\\\NewDocumentCommand{\\\\fnh}{m m}{%
  \\\\ifcase#1\\\\relax
  \\\\or\\\\par\\\\medskip{\\\\bfseries\\\\Large #2}\\\\par\\\\smallskip% 1
  \\\\or\\\\par\\\\smallskip{\\\\bfseries\\\\large #2}\\\\par\\\\smallskip% 2
  \\\\or\\\\par\\\\smallskip{\\\\bfseries #2}\\\\par\\\\smallskip% 3
  \\\\or\\\\par{\\\\bfseries\\\\small #2}\\\\par% 4
  \\\\or\\\\par{\\\\bfseries\\\\itshape #2}\\\\par% 5
  \\\\or\\\\par{\\\\itshape #2}\\\\par% 6
  \\\\or\\\\par{\\\\scshape #2}\\\\par% 7
  \\\\or\\\\par\\\\underline{#2}\\\\par% 8
  \\\\or\\\\par{\\\\sffamily\\\\bfseries\\\\footnotesize #2}\\\\par% 9
  \\\\or\\\\par{\\\\sffamily\\\\footnotesize #2}\\\\par% 10
  \\\\or\\\\par{\\\\ttfamily\\\\bfseries\\\\footnotesize #2}\\\\par% 11
  \\\\or\\\\par{\\\\ttfamily\\\\footnotesize #2}\\\\par% 12
  \\\\or\\\\par---\\\\ {\\\\bfseries #2}\\\\ ---\\\\par% 13
  \\\\or\\\\par$\\\\bullet$\\\\ {\\\\bfseries #2}\\\\par% 14
  \\\\or\\\\par[{\\\\bfseries #2}]\\\\par% 15
  \\\\or\\\\par\\\\{{\\\\itshape #2}\\\\}\\\\par% 16
  \\\\or\\\\par({\\\\small #2})\\\\par% 17
  \\\\or\\\\par$\\\\triangleright$\\\\ #2\\\\par% 18
  \\\\or\\\\par$\\\\diamond$\\\\ #2\\\\par% 19
  \\\\or\\\\par#2:\\\\par% 20
  \\\\else\\\\par{\\\\bfseries #2}\\\\par% fallback
  \\\\fi
}

% ──────────────────────────────────────────────────────────────────────────────
% LISTS (20 levels)
% ──────────────────────────────────────────────────────────────────────────────
\\\\usepackage{enumitem}
\\\\usepackage{textcomp}
\\\\setlistdepth{20}

\\\\newlist{fnitemize}{itemize}{20}
\\\\setlist[fnitemize]{nosep,leftmargin=*,labelindent=0pt}
\\\\setlist[fnitemize,1]{label=\\\\textbullet}
\\\\setlist[fnitemize,2]{label=\\\\textendash}
\\\\setlist[fnitemize,3]{label=\\\\guilsinglright}
\\\\setlist[fnitemize,4]{label=\\\\textperiodcentered}
\\\\setlist[fnitemize,5]{label=\\\\textbullet}
\\\\setlist[fnitemize,6]{label=\\\\textendash}
\\\\setlist[fnitemize,7]{label=\\\\guilsinglright}
\\\\setlist[fnitemize,8]{label=\\\\textperiodcentered}
\\\\setlist[fnitemize,9]{label=\\\\textbullet}
\\\\setlist[fnitemize,10]{label=\\\\textendash}
\\\\setlist[fnitemize,11]{label=\\\\guilsinglright}
\\\\setlist[fnitemize,12]{label=\\\\textperiodcentered}
\\\\setlist[fnitemize,13]{label=\\\\textbullet}
\\\\setlist[fnitemize,14]{label=\\\\textendash}
\\\\setlist[fnitemize,15]{label=\\\\guilsinglright}
\\\\setlist[fnitemize,16]{label=\\\\textperiodcentered}
\\\\setlist[fnitemize,17]{label=\\\\textbullet}
\\\\setlist[fnitemize,18]{label=\\\\textendash}
\\\\setlist[fnitemize,19]{label=\\\\guilsinglright}
\\\\setlist[fnitemize,20]{label=\\\\textperiodcentered}

\\\\newlist{fnenumerate}{enumerate}{20}
\\\\setlist[fnenumerate]{nosep,leftmargin=*,labelindent=0pt}
\\\\setlist[fnenumerate,1]{label=\\\\arabic*.}
\\\\setlist[fnenumerate,2]{label=\\\\alph*.}
\\\\setlist[fnenumerate,3]{label=\\\\roman*.}
\\\\setlist[fnenumerate,4]{label=\\\\Alph*.}
\\\\setlist[fnenumerate,5]{label=\\\\Roman*.}
\\\\setlist[fnenumerate,6]{label=(\\\\arabic*)}
\\\\setlist[fnenumerate,7]{label=(\\\\alph*)}
\\\\setlist[fnenumerate,8]{label=(\\\\roman*)}
\\\\setlist[fnenumerate,9]{label=[\\\\arabic*]}
\\\\setlist[fnenumerate,10]{label=[\\\\alph*]}
\\\\setlist[fnenumerate,11]{label=\\\\arabic*)}
\\\\setlist[fnenumerate,12]{label=\\\\alph*)}
\\\\setlist[fnenumerate,13]{label=\\\\roman*)}
\\\\setlist[fnenumerate,14]{label=\\\\Alph*)}
\\\\setlist[fnenumerate,15]{label=\\\\Roman*)}
\\\\setlist[fnenumerate,16]{label=\\\\arabic*-}
\\\\setlist[fnenumerate,17]{label=\\\\alph*-}
\\\\setlist[fnenumerate,18]{label=\\\\roman*-}
\\\\setlist[fnenumerate,19]{label=\\\\Alph*-}
\\\\setlist[fnenumerate,20]{label=\\\\Roman*-}

\\\\newlist{fndescription}{description}{20}
\\\\setlist[fndescription]{nosep,leftmargin=!,labelindent=0pt,style=nextline}

% ──────────────────────────────────────────────────────────────────────────────
% TABLES (with caption, numbering, multicolumn/multirow)
% ──────────────────────────────────────────────────────────────────────────────
\\\\usepackage{tabularx}
\\\\usepackage{booktabs}
\\\\usepackage{multirow}
\\\\usepackage{makecell}

\\\\newcounter{fntablecounter}

\\\\NewDocumentEnvironment{fntab}{m O{}}{%
  \\\\par\\\\smallskip
  \\\\refstepcounter{fntablecounter}%
  \\\\ifx\\\\relax#2\\\\relax\\\\else
    \\\\noindent\\\\textbf{Table~\\\\thefntablecounter:} #2\\\\par\\\\smallskip
  \\\\fi
  \\\\centering
  \\\\begin{tabular}{#1}%
}{%
  \\\\end{tabular}%
  \\\\par\\\\smallskip
}

\\\\NewDocumentEnvironment{fntabx}{m O{}}{%
  \\\\par\\\\smallskip
  \\\\refstepcounter{fntablecounter}%
  \\\\ifx\\\\relax#2\\\\relax\\\\else
    \\\\noindent\\\\textbf{Table~\\\\thefntablecounter:} #2\\\\par\\\\smallskip
  \\\\fi
  \\\\centering
  \\\\begin{tabularx}{\\\\linewidth}{#1}%
}{%
  \\\\end{tabularx}%
  \\\\par\\\\smallskip
}

% ──────────────────────────────────────────────────────────────────────────────
% CODE BLOCKS
% ──────────────────────────────────────────────────────────────────────────────
\\\\usepackage{listings}
\\\\lstset{
  basicstyle=\\\\ttfamily\\\\footnotesize,
  breaklines=true,
  frame=single,
  framesep=2pt,
  xleftmargin=2pt,
  xrightmargin=2pt,
  aboveskip=4pt,
  belowskip=4pt
}

\\\\NewDocumentEnvironment{fncode}{O{}}{%
  \\\\par\\\\smallskip
  \\\\lstset{language=#1}%
  \\\\begin{lstlisting}%
}{%
  \\\\end{lstlisting}%
  \\\\par\\\\smallskip
}

\\\\newcommand{\\\\fnc}[1]{\\\\texttt{#1}}
\"
  \"LaTeX preamble for rich footnotes.\")

(defun my/insert-latex-rich-footnotes-preamble ()
