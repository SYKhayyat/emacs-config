(defun my/insert-rich-footnote-context ()
  \"Insert ConTeXt rich footnote template.\"
  (interactive)
  (insert \"\\\\startRFN
\\\\fnh{1}{Heading}

\\\\startitemize[packed]
\\\\item First
\\\\startitemize[packed]
\\\\item Nested
\\\\stopitemize
\\\\stopitemize

\\\\starttabulate[|l|l|]
\\\\NC A \\\\NC B \\\\NC\\\\NR
\\\\stoptabulate

\\\\startfncode
def f():
    pass
\\\\stopfncode
\\\\stopRFN\")
  (search-backward \"Heading\"))

(defun my/insert-rich-footnote-org ()
  \"Insert Org rich footnote block.\"
  (interactive)
  (let ((id (read-string \"Footnote ID: \" \"1\")))
    (insert (format \"#+BEGIN_RICHFN %s
* Heading

- Item 1
  - Nested

#+CAPTION: My Table
| A | B |
|---+---|
| 1 | 2 |

#+begin_src python
def f():
    pass
#+end_src
#+END_RICHFN

[fn:%s]\" id id))
    (search-backward \"Heading\")))

(defun my/insert-rich-footnote-org-inline ()
  \"Insert auto-detected rich footnote.\"
  (interactive)
  (let ((id (read-string \"Footnote ID: \" \"1\")))
    (insert (format \"[fn:%s]\" id))
    (save-excursion
      (goto-char (point-max))
      (insert (format \"

[fn:%s]
* Heading

- Item

| A | B |
|---+---|
| 1 | 2 |
\" id)))))
#+end_src

