  \"Open dired at seforim root with sidebar.\"
  (interactive)
  (dired seforim-directory)
  (dired-hide-details-mode 1)
  (unless (and (fboundp 'dired-sidebar-showing-sidebar-p)
               (dired-sidebar-showing-sidebar-p))
    (dired-sidebar-toggle-sidebar)))

