  \\\\fnh{1}{Heading}
  
  \\\\begin{fnitemize}
    \\\\item First
    \\\\begin{fnitemize}
      \\\\item Nested
    \\\\end{fnitemize}
  \\\\end{fnitemize}
  
  \\\\begin{fnenumerate}
    \\\\item Numbered
  \\\\end{fnenumerate}
  
  \\\\begin{fntab}{|l|l|}[Caption]
    \\\\hline
