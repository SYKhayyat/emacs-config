\\\\definenote[RFND]
\\\\definenote[RFNE]

\\\\definestartstop[startRFN][commands={\\\\startnote[RFN]},after={\\\\stopnote}]
\\\\definestartstop[startRFNB][commands={\\\\startnote[RFNB]},after={\\\\stopnote}]

% Headings (20 levels)
\\\\define[2]\\\\fnh{%
  \\\\ifnum#1=1 \\\\blank[small]{\\\\bfc #2}\\\\blank[small]\\\\fi
  \\\\ifnum#1=2 \\\\blank[small]{\\\\bfb #2}\\\\blank[small]\\\\fi
  \\\\ifnum#1=3 \\\\blank[small]{\\\\bfa #2}\\\\blank[small]\\\\fi
  \\\\ifnum#1=4 \\\\blank[small]{\\\\bf #2}\\\\blank[small]\\\\fi
  \\\\ifnum#1=5 \\\\blank[small]{\\\\bi #2}\\\\blank[small]\\\\fi
  \\\\ifnum#1=6 \\\\blank[small]{\\\\it #2}\\\\blank[small]\\\\fi
  \\\\ifnum#1=7 \\\\blank[small]{\\\\sc #2}\\\\blank[small]\\\\fi
  \\\\ifnum#1=8 \\\\blank[small]{\\\\underbar{#2}}\\\\blank[small]\\\\fi
  \\\\ifnum#1=9 \\\\blank[small]{\\\\ss\\\\bf\\\\small #2}\\\\blank[small]\\\\fi
  \\\\ifnum#1=10 \\\\blank[small]{\\\\ss\\\\small #2}\\\\blank[small]\\\\fi
  \\\\ifnum#1=11 \\\\blank[small]{\\\\tt\\\\bf\\\\small #2}\\\\blank[small]\\\\fi
  \\\\ifnum#1=12 \\\\blank[small]{\\\\tt\\\\small #2}\\\\blank[small]\\\\fi
  \\\\ifnum#1=13 \\\\blank[small]{--- {\\\\bf #2} ---}\\\\blank[small]\\\\fi
  \\\\ifnum#1=14 \\\\blank[small]{• {\\\\bf #2}}\\\\blank[small]\\\\fi
  \\\\ifnum#1=15 \\\\blank[small]{[{\\\\bf #2}]}\\\\blank[small]\\\\fi
  \\\\ifnum#1=16 \\\\blank[small]{\\\\{{\\\\it #2}\\\\}}\\\\blank[small]\\\\fi
  \\\\ifnum#1=17 \\\\blank[small]{({\\\\small #2})}\\\\blank[small]\\\\fi
  \\\\ifnum#1=18 \\\\blank[small]{▷ #2}\\\\blank[small]\\\\fi
  \\\\ifnum#1=19 \\\\blank[small]{◇ #2}\\\\blank[small]\\\\fi
  \\\\ifnum#1=20 \\\\blank[small]{#2:}\\\\blank[small]\\\\fi
}

% Lists
\\\\setupitemize[each][packed]

% Code
\\\\definetyping[fncode][bodyfont=small\\\\tt,before={\\\\blank[small]},after={\\\\blank[small]}]
\\\\define[1]\\\\fnc{{\\\\tt #1}}
\"
  \"ConTeXt preamble for rich footnotes.\")

