** Org Preprocessor

#+begin_src emacs-lisp
;;; ═══════════════════════════════════════════════════════════════
;;; ORG RICH FOOTNOTES PREPROCESSOR
;;; ═══════════════════════════════════════════════════════════════

(defvar my/richfn-debug nil \"Enable debug messages for rich footnotes.\")

(defun my/richfn--has-rich-content-p (text)
  \"Check if TEXT contains rich org content (headings, lists, tables).\"
  (and text
       (or (string-match-p \"^\\\\*+ \" text)           ; headings
           (string-match-p \"^[ \\t]*[-+*] \" text)    ; unordered lists
           (string-match-p \"^[ \\t]*[0-9]+[.)] \" text) ; ordered lists
           (string-match-p \"^[ \\t]*|\" text)         ; tables
           (string-match-p \"\\\\[fn:\" text))))        ; nested footnotes

(defun my/richfn--parse-rich-blocks ()
  \"Parse #+BEGIN_RICHFN blocks and return alist of (id . content).\"
  (let ((blocks nil))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward \"^#\\\\+BEGIN_RICHFN\\\\s-+\\\\([^\\n]+\\\\)\" nil t)
        (let* ((id (match-string 1))
               (start (point))
               (end (if (re-search-forward \"^#\\\\+END_RICHFN\" nil t)
                        (match-beginning 0)
                      (point-max)))
               (content (buffer-substring-no-properties start end)))
          (push (cons id (string-trim content)) blocks))))
    (nreverse blocks)))

(defun my/richfn--org-to-latex (org-content)
  \"Convert ORG-CONTENT to LaTeX for footnote.\"
  (let* ((processed org-content)
         ;; Convert headings
         (heading-replacements
          '((\"^\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\* \\\\(.*\\\\)$\" . \"\\\\\\\\fnhx{\\\\1}\")
            (\"^\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\* \\\\(.*\\\\)$\" . \"\\\\\\\\fnhix{\\\\1}\")
            (\"^\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\* \\\\(.*\\\\)$\" . \"\\\\\\\\fnhviii{\\\\1}\")
            (\"^\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\* \\\\(.*\\\\)$\" . \"\\\\\\\\fnhvii{\\\\1}\")
            (\"^\\\\*\\\\*\\\\*\\\\*\\\\*\\\\* \\\\(.*\\\\)$\" . \"\\\\\\\\fnhvi{\\\\1}\")
            (\"^\\\\*\\\\*\\\\*\\\\*\\\\* \\\\(.*\\\\)$\" . \"\\\\\\\\fnhv{\\\\1}\")
            (\"^\\\\*\\\\*\\\\*\\\\* \\\\(.*\\\\)$\" . \"\\\\\\\\fnhiv{\\\\1}\")
            (\"^\\\\*\\\\*\\\\* \\\\(.*\\\\)$\" . \"\\\\\\\\fnhiii{\\\\1}\")
            (\"^\\\\*\\\\* \\\\(.*\\\\)$\" . \"\\\\\\\\fnhii{\\\\1}\")
            (\"^\\\\* \\\\(.*\\\\)$\" . \"\\\\\\\\fnhi{\\\\1}\"))))
    ;; Apply heading conversions
    (dolist (repl heading-replacements)
      (setq processed
            (replace-regexp-in-string (car repl) (cdr repl) processed)))
    
    ;; Convert lists
    (setq processed
          (replace-regexp-in-string
           \"^[ \\t]*- \\\\(.*\\\\)$\" \"\\\\\\\\item \\\\1\" processed))
    (setq processed
          (replace-regexp-in-string
           \"^[ \\t]*\\\\+ \\\\(.*\\\\)$\" \"\\\\\\\\item \\\\1\" processed))
    (setq processed
          (replace-regexp-in-string
           \"^[ \\t]*[0-9]+[.)] \\\\(.*\\\\)$\" \"\\\\\\\\item \\\\1\" processed))
    
    ;; Wrap consecutive items in list environment
    (setq processed
          (replace-regexp-in-string
           \"\\\\(\\\\\\\\item [^\\n]*\\n\\\\)+\"
           \"\\\\\\\\begin{fnlist}\\n\\\\&\\\\\\\\end{fnlist}\\n\" processed))
    
    ;; Convert tables (simple conversion)
    (when (string-match-p \"^[ \\t]*|\" processed)
      (setq processed (my/richfn--convert-org-table-to-latex processed)))
    
    ;; Convert nested footnotes
    (setq processed
          (replace-regexp-in-string
           \"\\\\[fn:\\\\([^]]+\\\\)\\\\]\"
           \"\\\\\\\\rfootnoteB{\\\\1}\" processed))
    
    processed))

(defun my/richfn--convert-org-table-to-latex (text)
  \"Convert org table in TEXT to LaTeX fntable.\"
  (with-temp-buffer
    (insert text)
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*|\\\\([^|]*\\\\(?:|[^|]*\\\\)*\\\\)|[ \\t]*$\" nil t)
      (let* ((line (match-string 0))
             (cells (split-string line \"|\" t \"[ \\t]*\"))
             (is-separator (string-match-p \"^-+$\" (car cells))))
        (if is-separator
            (replace-match \"\\\\\\\\hline\" t t)
          (let ((latex-row (mapconcat #'string-trim cells \" & \")))
            (replace-match (concat latex-row \" \\\\\\\\\\\\\\\\\") t t)))))
    ;; Wrap in fntable
    (goto-char (point-min))
    (insert \"\\\\begin{fntable}{|\" (make-string 10 ?l) \"|}\\n\\\\hline\\n\")
    (goto-char (point-max))
    (insert \"\\n\\\\hline\\n\\\\end{fntable}\")
    (buffer-string)))

(defun my/richfn--org-to-typst (org-content)
  \"Convert ORG-CONTENT to Typst for footnote.\"
  (let ((processed org-content))
    ;; Headings: * -> =
    (setq processed
          (replace-regexp-in-string
           \"^\\\\(\\\\*+\\\\) \\\\(.*\\\\)$\"
           (lambda (m)
             (let ((level (length (match-string 1 m)))
                   (text (match-string 2 m)))
               (concat (make-string level ?=) \" \" text)))
           processed))
    
    ;; Lists already work in Typst
    
    ;; Tables
    (when (string-match-p \"^[ \\t]*|\" processed)
      (setq processed (my/richfn--convert-org-table-to-typst processed)))
    
    ;; Nested footnotes
    (setq processed
          (replace-regexp-in-string
           \"\\\\[fn:\\\\([^]]+\\\\)\\\\]\"
           \"#footnote[\\\\1]\" processed))
    
    processed))

(defun my/richfn--convert-org-table-to-typst (text)
  \"Convert org table in TEXT to Typst table.\"
  (with-temp-buffer
    (insert text)
    (goto-char (point-min))
    (let ((rows nil)
          (col-count 0))
      (while (re-search-forward \"^[ \\t]*|\\\\([^|]*\\\\(?:|[^|]*\\\\)*\\\\)|[ \\t]*$\" nil t)
        (let* ((line (match-string 0))
               (cells (split-string line \"|\" t \"[ \\t]*\"))
               (is-separator (and cells (string-match-p \"^-+$\" (car cells)))))
          (unless is-separator
            (setq col-count (max col-count (length cells)))
            (push cells rows))))
      (setq rows (nreverse rows))
      (erase-buffer)
      (insert \"#table(\\n\")
      (insert (format \"  columns: %d,\\n\" col-count))
      (dolist (row rows)
        (dolist (cell row)
          (insert (format \"  [%s],\\n\" (string-trim cell)))))
      (insert \")\")
      (buffer-string))))

(defun my/richfn--org-to-context (org-content)
  \"Convert ORG-CONTENT to ConTeXt for footnote.\"
  (let ((processed org-content))
    ;; Headings
    (setq processed
          (replace-regexp-in-string \"^\\\\* \\\\(.*\\\\)$\" \"\\\\\\\\fnheadi{\\\\1}\" processed))
    (setq processed
          (replace-regexp-in-string \"^\\\\*\\\\* \\\\(.*\\\\)$\" \"\\\\\\\\fnheadii{\\\\1}\" processed))
    (setq processed
          (replace-regexp-in-string \"^\\\\*\\\\*\\\\* \\\\(.*\\\\)$\" \"\\\\\\\\fnheadiii{\\\\1}\" processed))
    
    ;; Lists
    (setq processed
          (replace-regexp-in-string
           \"^[ \\t]*[-+*] \\\\(.*\\\\)$\" \"\\\\\\\\item \\\\1\" processed))
    (setq processed
          (replace-regexp-in-string
           \"\\\\(\\\\\\\\item [^\\n]*\\n\\\\)+\"
           \"\\\\\\\\startitemize\\n\\\\&\\\\\\\\stopitemize\\n\" processed))
    
    ;; Tables
    (when (string-match-p \"^[ \\t]*|\" processed)
      (setq processed (my/richfn--convert-org-table-to-context processed)))
    
    ;; Nested footnotes
    (setq processed
          (replace-regexp-in-string
           \"\\\\[fn:\\\\([^]]+\\\\)\\\\]\"
           \"\\\\\\\\fnB{\\\\1}\" processed))
    
    processed))

(defun my/richfn--convert-org-table-to-context (text)
  \"Convert org table in TEXT to ConTeXt tabulate.\"
  (with-temp-buffer
    (insert text)
    (goto-char (point-min))
    (let ((rows nil))
      (while (re-search-forward \"^[ \\t]*|\\\\([^|]*\\\\(?:|[^|]*\\\\)*\\\\)|[ \\t]*$\" nil t)
        (let* ((line (match-string 0))
               (cells (split-string line \"|\" t \"[ \\t]*\"))
               (is-separator (and cells (string-match-p \"^-+$\" (car cells)))))
          (unless is-separator
            (push cells rows))))
      (setq rows (nreverse rows))
      (erase-buffer)
      (insert \"\\\\starttabulate[|l|l|l|l|l|l|]\\n\")
      (dolist (row rows)
        (insert \"\\\\NC \")
        (insert (mapconcat #'string-trim row \" \\\\NC \"))
        (insert \" \\\\NC\\\\NR\\n\"))
      (insert \"\\\\stoptabulate\")
      (buffer-string))))

(defun my/richfn--org-to-html (org-content)
  \"Convert ORG-CONTENT to HTML for footnote.\"
  (let ((processed org-content))
    ;; Headings
    (dotimes (i 6)
      (let ((stars (make-string (- 6 i) ?*))
            (tag (format \"h%d\" (- 6 i))))
        (setq processed
              (replace-regexp-in-string
               (format \"^%s \\\\(.*\\\\)$\" (regexp-quote stars))
               (format \"<%s>\\\\1</%s>\" tag tag)
               processed))))
    
    ;; Lists
    (setq processed
          (replace-regexp-in-string
           \"^[ \\t]*[-+*] \\\\(.*\\\\)$\" \"<li>\\\\1</li>\" processed))
    (setq processed
          (replace-regexp-in-string
           \"\\\\(<li>.*</li>\\n\\\\)+\"
           \"<ul>\\n\\\\&</ul>\\n\" processed))
    
    ;; Tables
    (when (string-match-p \"^[ \\t]*|\" processed)
      (setq processed (my/richfn--convert-org-table-to-html processed)))
    
    processed))

(defun my/richfn--convert-org-table-to-html (text)
  \"Convert org table in TEXT to HTML table.\"
  (with-temp-buffer
    (insert text)
    (goto-char (point-min))
    (let ((rows nil))
      (while (re-search-forward \"^[ \\t]*|\\\\([^|]*\\\\(?:|[^|]*\\\\)*\\\\)|[ \\t]*$\" nil t)
        (let* ((line (match-string 0))
               (cells (split-string line \"|\" t \"[ \\t]*\"))
               (is-separator (and cells (string-match-p \"^-+$\" (car cells)))))
          (unless is-separator
            (push cells rows))))
      (setq rows (nreverse rows))
      (erase-buffer)
      (insert \"<table>\\n\")
      (dolist (row rows)
        (insert \"  <tr>\")
        (dolist (cell row)
          (insert (format \"<td>%s</td>\" (string-trim cell))))
        (insert \"</tr>\\n\"))
      (insert \"</table>\")
      (buffer-string))))

(defun my/richfn-preprocess-buffer (backend)
  \"Preprocess rich footnotes before export to BACKEND.\"
  (when my/richfn-debug
    (message \"Rich footnotes: preprocessing for %s\" backend))
  
  (let ((rich-blocks (my/richfn--parse-rich-blocks))
        (converter (pcase backend
                     ('latex #'my/richfn--org-to-latex)
                     ('beamer #'my/richfn--org-to-latex)
                     ('typst #'my/richfn--org-to-typst)
                     ('context #'my/richfn--org-to-context)
                     ('html #'my/richfn--org-to-html)
                     ('pandoc #'my/richfn--org-to-latex)  ; Pandoc uses LaTeX for footnotes
                     (_ #'identity))))
    
    ;; Process explicit RICHFN blocks
    (dolist (block rich-blocks)
      (let ((id (car block))
            (content (cdr block)))
        (save-excursion
          (goto-char (point-min))
          ;; Remove the block
          (when (re-search-forward (format \"^#\\\\+BEGIN_RICHFN\\\\s-+%s\" (regexp-quote id)) nil t)
            (let ((start (line-beginning-position)))
              (re-search-forward \"^#\\\\+END_RICHFN\" nil t)
              (delete-region start (1+ (line-end-position)))))
          ;; Insert as footnote
          (goto-char (point-min))
          (let ((converted (funcall converter content)))
            (if (re-search-forward (format \"\\\\[fn:%s\\\\]\" (regexp-quote id)) nil t)
                ;; Reference exists, add definition
                (progn
                  (goto-char (point-max))
                  (insert (format \"\\n[fn:%s] %s\\n\" id converted)))
              ;; Create inline footnote
              (goto-char (point-max))
              (insert (format \"\\n[fn:%s] %s\\n\" id converted)))))))
    
    ;; Auto-detect rich content in existing footnotes
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward \"^\\\\[fn:\\\\([^]]+\\\\)\\\\]\\\\s-*\\\\(.*\\\\(?:\\n[^[].*\\\\)*\\\\)\" nil t)
        (let* ((id (match-string 1))
               (content (match-string 2))
               (start (match-beginning 0))
               (end (match-end 0)))
          (when (my/richfn--has-rich-content-p content)
            (let ((converted (funcall converter content)))
              (delete-region start end)
              (goto-char start)
              (insert (format \"[fn:%s] %s\" id converted)))))))))

;; Register with org export
(with-eval-after-load 'ox
  (add-hook 'org-export-before-processing-hook #'my/richfn-preprocess-buffer))
#+end_src

