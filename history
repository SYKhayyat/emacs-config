    main()" "#!/usr/bin/env python3
\"\"\"
html2org.py — Convert HTML Gemara files to Org mode with a clickable TOC.

Best-of-both-worlds:
- Robust HTML parsing (stdlib html.parser, not regex)
- Generates an in-buffer clickable TOC (using CUSTOM_ID targets)
- Preserves directory structure when writing to an output dir

Usage:
  python3 html2org.py <input_dir> [output_dir]

If output_dir is omitted, writes .org files next to the inputs.
\"\"\"

import re
import sys
from pathlib import Path
from html.parser import HTMLParser


# ─── Small utilities ─────────────────────────────────────────────────────────

_ws_re = re.compile(r\"\\s+\")


def normalize_ws(s: str) -> str:
    return _ws_re.sub(\" \", s).strip()


# ─── Parser ─────────────────────────────────────────────────────────────────

class GemaraHTMLParser(HTMLParser):
    def __init__(self):
        # convert_charrefs=True decodes &amp; etc into real characters
        super().__init__(convert_charrefs=True)
        self.stack = []

        self.out = []  # list[str]
        self.headings = []  # list[dict(level:int, text:str, id:str)]
        self._heading_level = None
        self._heading_buf = []

        self._sec_counter = 0

    # ----- output helpers -----

    def _append(self, s: str):
        if not s:
            return
        self.out.append(s)

    def _append_newlines(self, n: int = 1):
        # Avoid runaway blank lines: cap at 2 in a row in the buffer
        if not self.out:
            self.out.append(\"\\n\" * n)
            return

        tail = self.out[-1]
        existing = 0
        i = len(tail) - 1
        while i >= 0 and tail[i] == \"\\n\":
            existing += 1
            i -= 1

        want = max(0, min(2, n) - min(2, existing))
        if want:
            self.out.append(\"\\n\" * want)

    def _append_text_with_spacing(self, s: str):
        \"\"\"Append text, inserting a space when tags split words.\"\"\"
        if not s:
            return
        if not self.out:
            self.out.append(s)
            return

        prev = self.out[-1]
        prev_last = prev[-1] if prev else \"\"
        next_first = s[0]

        # Insert a space when we likely split tokens across tags:
        # e.g. \"foo<strong>bar</strong>\" => \"foo *bar*\"
        needs_space = (
            prev_last
            and prev_last not in (\" \", \"\\n\", \"\\t\")
            and next_first not in (\" \", \"\\n\", \"\\t\", \".\", \",\", \":\", \";\", \"!\", \"?\", \")\", \"]\")
            and (
                prev_last.isalnum()
                or prev_last in (\"*\", \"/\", \"_\")  # org markers often neighbor words
            )
        )

        if needs_space:
            self.out.append(\" \" + s)
        else:
            self.out.append(s)

    def _inline_markup(self, text: str) -> str:
        \"\"\"Wrap text in org markup based on current tag context.\"\"\"
        # If we're in a <pre>, keep raw (no whitespace normalization / wrapping)
        if \"pre\" in self.stack:
            return text

        bold = any(t in self.stack for t in (\"strong\", \"b\"))
        italic = any(t in self.stack for t in (\"em\", \"i\"))
        underline = \"u\" in self.stack

        prefix = \"\"
        suffix = \"\"

        # Nesting order: bold -> italic -> underline (suffix reversed)
        if bold:
            prefix += \"*\"
            suffix = \"*\" + suffix
        if italic:
            prefix += \"/\"
            suffix = \"/\" + suffix
        if underline:
            prefix += \"_\"
            suffix = \"_\" + suffix

        return f\"{prefix}{text}{suffix}\"

    # ----- TOC helpers -----

    def _next_sec_id(self) -> str:
        self._sec_counter += 1
        return f\"sec-{self._sec_counter:04d}\"

    # ----- HTMLParser callbacks -----

    def handle_starttag(self, tag, attrs):
        tag = tag.lower()
        self.stack.append(tag)

        if tag in (\"script\", \"style\"):
            return

        # Headings: start buffering until endtag
        if tag in (\"h1\", \"h2\", \"h3\", \"h4\", \"h5\", \"h6\"):
            self._heading_level = int(tag[1])
            self._heading_buf = []
            return

        # Line breaks / blocks / simple lists
        if tag == \"br\":
            self._append_newlines(1)
        elif tag in (\"p\",):
            self._append_newlines(2)
        elif tag in (\"div\", \"section\", \"article\"):
            self._append_newlines(1)
        elif tag == \"hr\":
            self._append_newlines(1)
            self._append(\"-----\")
            self._append_newlines(2)
        elif tag == \"li\":
            # indent list items by nesting depth of UL/OL
            depth = sum(1 for t in self.stack if t in (\"ul\", \"ol\")) - 1
            indent = \"  \" * max(depth, 0)
            self._append_newlines(1)
            self._append(f\"{indent}- \")

    def handle_endtag(self, tag):
        tag = tag.lower()

        # Pop stack to this tag (HTML can be messy)
        while self.stack:
            t = self.stack.pop()
            if t == tag:
                break

        if tag in (\"script\", \"style\"):
            return

        # Finish heading
        if tag in (\"h1\", \"h2\", \"h3\", \"h4\", \"h5\", \"h6\") and self._heading_level:
            text = normalize_ws(\"\".join(self._heading_buf))
            level = self._heading_level
            sec_id = self._next_sec_id()

            self.headings.append({\"level\": level, \"text\": text, \"id\": sec_id})

            stars = \"*\" * level
            self._append_newlines(2)
            self._append(f\"{stars} {text}\\n\")
            self._append(\":PROPERTIES:\\n\")
            self._append(f\":CUSTOM_ID: {sec_id}\\n\")
            self._append(\":END:\\n\")
            self._append_newlines(1)

            self._heading_level = None
            self._heading_buf = []
            return

        # Block-ish endings
        if tag in (\"p\",):
            self._append_newlines(2)
        elif tag in (\"div\", \"section\", \"article\", \"blockquote\"):
            self._append_newlines(1)
        elif tag == \"li\":
            self._append_newlines(1)

    def handle_data(self, data):
        if not data:
            return

        # Ignore script/style text
        if any(t in self.stack for t in (\"script\", \"style\")):
            return

        if self._heading_level:
            # Heading text: collect plain text (no org markup inside headings)
            self._heading_buf.append(data)
            return

        if \"pre\" in self.stack:
            self._append(data)
            return

        text = normalize_ws(data)
        if not text:
            return

        text = self._inline_markup(text)
        self._append_text_with_spacing(text)

    # ----- Org assembly -----

    def build_toc(self) -> str:
        if not self.headings:
            return \"\"

        min_level = min(h[\"level\"] for h in self.headings)
        lines = [\"* תוכן עניינים\\n\"]
        for h in self.headings:
            indent = \"  \" * (h[\"level\"] - min_level)
            # CUSTOM_ID links: [[#sec-0001][Heading]]
            lines.append(f\"{indent}- [[#{h['id']}][{h['text']}]]\\n\")
        return \"\".join(lines) + \"\\n\"

    def get_org(self, fallback_title: str = \"\") -> str:
        title = self.headings[0][\"text\"] if self.headings and self.headings[0][\"text\"] else fallback_title

        header = (
            f\"#+TITLE: {title}\\n\"
            f\"#+LANGUAGE: he\\n\"
            f\"#+OPTIONS: toc:nil num:nil\\n\\n\"
        )

        body = \"\".join(self.out)

        # Normalize blank lines
        body = re.sub(r\"\\n{3,}\", \"\\n\\n\", body).strip() + \"\\n\"

        return header + self.build_toc() + body


# ─── Conversion ──────────────────────────────────────────────────────────────

def convert_file(input_path: Path, output_path: Path):
    html = input_path.read_text(encoding=\"utf-8\", errors=\"replace\")
    parser = GemaraHTMLParser()
    parser.feed(html)
    org = parser.get_org(fallback_title=input_path.stem)

    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(org, encoding=\"utf-8\")
    print(f\"  ✔  {input_path}  →  {output_path}\")


def main():
    if len(sys.argv) not in (2, 3):
        print(\"Usage:\\n  python3 html2org.py <input_dir> [output_dir]\")
        sys.exit(1)

    input_dir = Path(sys.argv[1])
    output_dir = Path(sys.argv[2]) if len(sys.argv) == 3 else None

    if not input_dir.is_dir():
        print(f\"Error: '{input_dir}' is not a directory.\")
        sys.exit(1)

    html_files = sorted(list(input_dir.rglob(\"*.html\")) + list(input_dir.rglob(\"*.htm\")))
    if not html_files:
        print(f\"No .html/.htm files found in '{input_dir}'.\")
        sys.exit(0)

    print(f\"Found {len(html_files)} file(s). Converting...\\n\")

    for f in html_files:
        if output_dir:
            out = output_dir / f.relative_to(input_dir).with_suffix(\".org\")
        else:
            out = f.with_suffix(\".org\")
        convert_file(f, out)

    print(f\"\\nDone! {len(html_files)} file(s) converted.\")


