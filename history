** LaTeX Preamble

#+begin_src emacs-lisp
(defvar my/latex-rich-footnotes-preamble
  \"% ══════════════════════════════════════════════════════════════
% RICH FOOTNOTES SYSTEM
% ══════════════════════════════════════════════════════════════

% Base: bigfoot for nesting
\\\\usepackage{bigfoot}
\\\\DeclareNewFootnote{default}
\\\\DeclareNewFootnote{B}
\\\\DeclareNewFootnote{C}
\\\\DeclareNewFootnote{D}
\\\\DeclareNewFootnote{E}
\\\\DeclareNewFootnote{F}
\\\\DeclareNewFootnote{G}
\\\\DeclareNewFootnote{H}
\\\\DeclareNewFootnote{I}
\\\\DeclareNewFootnote{J}

% Tables in footnotes
\\\\usepackage{tabularx}
\\\\usepackage{booktabs}
\\\\usepackage{multirow}
\\\\usepackage{makecell}

% Table environment for footnotes
\\\\newenvironment{fntable}[1][]{%
  \\\\begin{center}%
  \\\\begin{tabular}{#1}%
}{%
  \\\\end{tabular}%
  \\\\end{center}%
}

% Flexible table for footnotes
\\\\newenvironment{fntablex}[1][]{%
  \\\\begin{center}%
  \\\\begin{tabularx}{\\\\linewidth}{#1}%
}{%
  \\\\end{tabularx}%
  \\\\end{center}%
}

% Lists in footnotes (unlimited depth)
\\\\usepackage{enumitem}
\\\\setlistdepth{20}
\\\\renewlist{itemize}{itemize}{20}
\\\\renewlist{enumerate}{enumerate}{20}

% List styles for each level
\\\\setlist[itemize,1]{label=\\\\textbullet}
\\\\setlist[itemize,2]{label=\\\\textendash}
\\\\setlist[itemize,3]{label=\\\\textasteriskcentered}
\\\\setlist[itemize,4]{label=\\\\textperiodcentered}
\\\\setlist[itemize,5]{label=\\\\textbullet}
\\\\setlist[itemize,6]{label=\\\\textendash}
\\\\setlist[itemize,7]{label=\\\\textasteriskcentered}
\\\\setlist[itemize,8]{label=\\\\textperiodcentered}

% Footnote list environment
\\\\newenvironment{fnlist}{\\\\begin{itemize}[nosep,leftmargin=*]}{\\\\end{itemize}}
\\\\newenvironment{fnenum}{\\\\begin{enumerate}[nosep,leftmargin=*]}{\\\\end{enumerate}}

% Headings in footnotes
\\\\newcommand{\\\\fnheading}[1]{\\\\textbf{\\\\large #1}\\\\par\\\\smallskip}
\\\\newcommand{\\\\fnsubheading}[1]{\\\\textbf{#1}\\\\par\\\\smallskip}
\\\\newcommand{\\\\fnsubsubheading}[1]{\\\\textit{\\\\textbf{#1}}\\\\par\\\\smallskip}

% 10 levels of headings in footnotes
\\\\newcommand{\\\\fnhi}[1]{\\\\textbf{\\\\Large #1}\\\\par\\\\medskip}
\\\\newcommand{\\\\fnhii}[1]{\\\\textbf{\\\\large #1}\\\\par\\\\smallskip}
\\\\newcommand{\\\\fnhiii}[1]{\\\\textbf{#1}\\\\par\\\\smallskip}
\\\\newcommand{\\\\fnhiv}[1]{\\\\textbf{\\\\small #1}\\\\par}
\\\\newcommand{\\\\fnhv}[1]{\\\\textit{\\\\textbf{#1}}\\\\par}
\\\\newcommand{\\\\fnhvi}[1]{\\\\textit{#1}\\\\par}
\\\\newcommand{\\\\fnhvii}[1]{\\\\underline{#1}\\\\par}
\\\\newcommand{\\\\fnhviii}[1]{\\\\textsc{#1}\\\\par}
\\\\newcommand{\\\\fnhix}[1]{--- #1 ---\\\\par}
\\\\newcommand{\\\\fnhx}[1]{#1:\\\\par}

% Rich footnote shortcuts (same as regular but clearer intent)
\\\\let\\\\rfootnote\\\\footnote
\\\\let\\\\rfootnoteB\\\\footnoteB
\\\\let\\\\rfootnoteC\\\\footnoteC
\\\\let\\\\rfootnoteD\\\\footnoteD
\\\\let\\\\rfootnoteE\\\\footnoteE
\\\\let\\\\rfootnoteF\\\\footnoteF
\\\\let\\\\rfootnoteG\\\\footnoteG
\\\\let\\\\rfootnoteH\\\\footnoteH
\\\\let\\\\rfootnoteI\\\\footnoteI
\\\\let\\\\rfootnoteJ\\\\footnoteJ

% Marks and texts for nesting
\\\\let\\\\rfootnotemark\\\\footnotemark
\\\\let\\\\rfootnotemarkB\\\\footnotemarkB
\\\\let\\\\rfootnotemarkC\\\\footnotemarkC
\\\\let\\\\rfootnotemarkD\\\\footnotemarkD
\\\\let\\\\rfootnotemarkE\\\\footnotemarkE

\\\\let\\\\rfootnotetext\\\\footnotetext
\\\\let\\\\rfootnotetextB\\\\footnotetextB
\\\\let\\\\rfootnotetextC\\\\footnotetextC
\\\\let\\\\rfootnotetextD\\\\footnotetextD
\\\\let\\\\rfootnotetextE\\\\footnotetextE

% Captioned table in footnote
\\\\newenvironment{fntablecap}[2][]{%
  \\\\begin{center}%
  \\\\textbf{#2}\\\\\\\\[2pt]%
  \\\\begin{tabular}{#1}%
}{%
  \\\\end{tabular}%
  \\\\end{center}%
}
\"
  \"LaTeX preamble for rich footnotes with full document capability.\")
#+end_src

** Typst Preamble

#+begin_src emacs-lisp
(defvar my/typst-rich-footnotes-preamble
  \"#let fn-heading(level, body) = {
  let sizes = (1.4em, 1.2em, 1.1em, 1em, 1em, 0.9em, 0.9em, 0.85em, 0.85em, 0.8em)
  let size = sizes.at(calc.min(level - 1, 9))
  let styles = (
    strong,
    strong,
    strong,
    emph,
    emph,
    it => underline(emph(it)),
    underline,
    smallcaps,
    it => [— #it —],
    it => [#it:],
  )
  let style = styles.at(calc.min(level - 1, 9))
  block(text(size: size, style(body)))
}

#let fn-h1(body) = fn-heading(1, body)
#let fn-h2(body) = fn-heading(2, body)
#let fn-h3(body) = fn-heading(3, body)
#let fn-h4(body) = fn-heading(4, body)
#let fn-h5(body) = fn-heading(5, body)
#let fn-h6(body) = fn-heading(6, body)
#let fn-h7(body) = fn-heading(7, body)
#let fn-h8(body) = fn-heading(8, body)
#let fn-h9(body) = fn-heading(9, body)
#let fn-h10(body) = fn-heading(10, body)

// Rich footnote with full content support
#let rfn(body) = footnote(body)

// Nested footnote counter
#let fn-level = state(\\\"fn-level\\\", 0)

// Table with caption in footnote
#let fn-table-cap(caption, ..args) = {
  block[
    #strong(caption)
    #table(..args)
  ]
}

// Numbered list in footnote
#let fn-enum(..items) = enum(..items)

// Bullet list in footnote  
#let fn-list(..items) = list(..items)
\"
  \"Typst preamble for rich footnotes.\")

(defun my/insert-typst-rich-footnotes-preamble ()
  \"Insert Typst rich footnotes preamble.\"
  (interactive)
  (insert my/typst-rich-footnotes-preamble))
#+end_src

** ConTeXt Preamble

#+begin_src emacs-lisp
(defvar my/context-rich-footnotes-preamble
  \"% ══════════════════════════════════════════════════════════════
% RICH FOOTNOTES SYSTEM FOR CONTEXT
% ══════════════════════════════════════════════════════════════

% Enable nested footnotes
\\\\setupnote[footnote][n=10]
\\\\definenote[fnB][footnote]
\\\\definenote[fnC][footnote]
\\\\definenote[fnD][footnote]
\\\\definenote[fnE][footnote]
\\\\definenote[fnF][footnote]
\\\\definenote[fnG][footnote]
\\\\definenote[fnH][footnote]
\\\\definenote[fnI][footnote]
\\\\definenote[fnJ][footnote]

% Headings in footnotes
\\\\definehead[fnheadi][subject][style=\\\\bfc]
\\\\definehead[fnheadii][subsubject][style=\\\\bfb]
\\\\definehead[fnheadiii][subsubsubject][style=\\\\bf]
\\\\definehead[fnheadiv][paragraph][style=\\\\bf\\\\small]
\\\\definehead[fnheadv][subparagraph][style=\\\\it\\\\bf]
\\\\definehead[fnheadvi][subsubparagraph][style=\\\\it]

% Lists unlimited depth
\\\\setupitemize[each][n=20]

% Tables in footnotes
\\\\definetabulate[fntab][|l|l|l|l|l|l|l|l|l|l|]

% Captioned table helper
\\\\definestartstop[fntablecap][
  before={\\\\startframedtext[width=local]},
  after={\\\\stopframedtext}
]

% Rich footnote environment
\\\\definestartstop[richfootnote][
  before={\\\\startfootnote},
  after={\\\\stopfootnote}
]
\"
  \"ConTeXt preamble for rich footnotes.\")

(defun my/insert-context-rich-footnotes-preamble ()
  \"Insert ConTeXt rich footnotes preamble.\"
  (interactive)
  (insert my/context-rich-footnotes-preamble))
#+end_src

** Org Preprocessor

#+begin_src emacs-lisp
;;; ═══════════════════════════════════════════════════════════════════════════
;;; ORG RICH FOOTNOTES PREPROCESSOR
;;; ═══════════════════════════════════════════════════════════════════════════

(defvar my/richfn-debug nil \"Enable debug messages for rich footnotes.\")

(defun my/richfn--log (fmt &rest args)
  \"Log message if debugging enabled.\"
  (when my/richfn-debug
    (apply #'message (concat \"RichFN: \" fmt) args)))

(defun my/richfn--has-rich-content-p (text)
  \"Check if TEXT contains rich org content.\"
  (and text
       (string-match-p
        (rx (or
             (seq bol (+ \"*\") \" \")
             (seq bol (* space) (any \"-+\") \" \")
             (seq bol (* space) (+ digit) (any \".)\") \" \")
             (seq bol (* space) \"|\")
             (seq bol (* space) \"#+begin_src\")
             (seq bol (* space) \"#+BEGIN_SRC\")
             (seq \"[fn:\")))
        text)))

(defun my/richfn--get-footnote-definitions ()
  \"Get all footnote definitions as alist of (id start end content).\"
  (let ((footnotes nil))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward \"^\\\\[fn:\\\\([^]]+\\\\)\\\\][ \\t]*\" nil t)
        (let* ((id (match-string-no-properties 1))
               (start (match-beginning 0))
               (content-start (point))
               (end (save-excursion
                      (if (re-search-forward \"^\\\\[fn:\\\\|^\\\\*+ \\\\|\\\\'\" nil t)
                          (match-beginning 0)
                        (point-max))))
               (content (string-trim
                         (buffer-substring-no-properties content-start end))))
          (push (list id start end content) footnotes))))
    (nreverse footnotes)))

(defun my/richfn--parse-rich-blocks ()
  \"Parse #+BEGIN_RICHFN blocks. Returns list of (id start end content).\"
  (let ((blocks nil))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward \"^[ \\t]*#\\\\+BEGIN_RICHFN[ \\t]+\\\\([^ \\t\\n]+\\\\)\" nil t)
        (let* ((id (match-string-no-properties 1))
               (block-start (line-beginning-position))
               (content-start (1+ (line-end-position)))
               (depth 1)
               (block-end nil)
               (content-end nil))
          ;; Find matching END_RICHFN (handle nesting)
          (while (and (> depth 0)
                      (re-search-forward \"^[ \\t]*#\\\\+\\\\(BEGIN\\\\|END\\\\)_RICHFN\" nil t))
            (if (string= (match-string 1) \"BEGIN\")
                (setq depth (1+ depth))
              (setq depth (1- depth))
              (when (= depth 0)
                (setq content-end (line-beginning-position))
                (setq block-end (line-end-position)))))
          (when block-end
            (let ((content (string-trim
                            (buffer-substring-no-properties content-start content-end))))
              (push (list id block-start block-end content) blocks))))))
    (nreverse blocks)))

(defun my/richfn--org-to-latex (text)
  \"Convert org TEXT to LaTeX for footnote.\"
  (with-temp-buffer
    (insert text)
    
    ;; Process nested RICHFN blocks first (recursive)
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+BEGIN_RICHFN[ \\t]+\\\\([^ \\t\\n]+\\\\)\" nil t)
      (let* ((nested-id (match-string-no-properties 1))
             (nested-start (line-beginning-position))
             (content-start (1+ (line-end-position)))
             (depth 1)
             (nested-end nil)
             (content-end nil))
        (while (and (> depth 0)
                    (re-search-forward \"^[ \\t]*#\\\\+\\\\(BEGIN\\\\|END\\\\)_RICHFN\" nil t))
          (if (string= (match-string 1) \"BEGIN\")
              (setq depth (1+ depth))
            (setq depth (1- depth))
            (when (= depth 0)
              (setq content-end (line-beginning-position))
              (setq nested-end (1+ (line-end-position))))))
        (when nested-end
          (let* ((nested-content (buffer-substring-no-properties content-start content-end))
                 (converted (my/richfn--org-to-latex nested-content)))
            (delete-region nested-start nested-end)
            (goto-char nested-start)
            (insert (format \"\\\\rfnmark{B}\\\\rfntext{B}{%s}\" converted))))))
    
    ;; Convert headings (20 levels)
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\(\\\\*+\\\\) \\\\(.*\\\\)$\" nil t)
      (let ((level (min 20 (length (match-string 1))))
            (title (match-string 2)))
        (replace-match (format \"\\\\\\\\fnh{%d}{%s}\" level title) t t)))
    
    ;; Convert description lists
    (goto-char (point-min))
    (let ((in-desc nil)
          (desc-regions nil))
      (while (re-search-forward \"^\\\\([ \\t]*\\\\)- \\\\([^:\\n]+\\\\) :: \\\\(.*\\\\)$\" nil t)
        (let ((indent (match-string 1))
              (term (match-string 2))
              (desc (match-string 3))
              (start (match-beginning 0)))
          (unless in-desc
            (setq in-desc start))
          (replace-match (format \"%s\\\\\\\\item[%s] %s\" indent term desc) t t)))
      ;; Wrap description items
      (goto-char (point-min))
      (while (re-search-forward \"\\\\(\\\\\\\\item\\\\[[^]]*\\\\].*\\n\\\\)+\" nil t)
        (let ((items (match-string 0))
              (start (match-beginning 0))
              (end (match-end 0)))
          (delete-region start end)
          (goto-char start)
          (insert \"\\\\begin{fndescription}\\n\" items \"\\\\end{fndescription}\\n\"))))
    
    ;; Convert unordered lists
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\([ \\t]*\\\\)[-+] \\\\(.*\\\\)$\" nil t)
      (let ((indent (match-string 1))
            (content (match-string 2)))
        (replace-match (format \"%s\\\\\\\\item %s\" indent content) t t)))
    
    ;; Convert ordered lists
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\([ \\t]*\\\\)[0-9]+[.)] \\\\(.*\\\\)$\" nil t)
      (let ((indent (match-string 1))
            (content (match-string 2)))
        (replace-match (format \"%s\\\\\\\\itemenum %s\" indent content) t t)))
    
    ;; Wrap unordered items
    (goto-char (point-min))
    (while (re-search-forward \"\\\\(^[ \\t]*\\\\\\\\item [^\\n]*\\n\\\\)+\" nil t)
      (let ((items (match-string 0))
            (start (match-beginning 0))
            (end (match-end 0)))
        (delete-region start end)
        (goto-char start)
        (insert \"\\\\begin{fnitemize}\\n\" items \"\\\\end{fnitemize}\\n\")))
    
    ;; Wrap ordered items
    (goto-char (point-min))
    (while (re-search-forward \"\\\\(^[ \\t]*\\\\\\\\itemenum [^\\n]*\\n\\\\)+\" nil t)
      (let ((items (replace-regexp-in-string \"\\\\\\\\itemenum\" \"\\\\\\\\item\" (match-string 0)))
            (start (match-beginning 0))
            (end (match-end 0)))
        (delete-region start end)
        (goto-char start)
        (insert \"\\\\begin{fnenumerate}\\n\" items \"\\\\end{fnenumerate}\\n\")))
    
    ;; Convert tables
    (goto-char (point-min))
    (my/richfn--convert-org-tables-latex)
    
    ;; Convert code blocks
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+\\\\(begin_src\\\\|BEGIN_SRC\\\\)\\\\(?: \\\\([^ \\t\\n]+\\\\)\\\\)?[^\\n]*\\n\\\\(\\\\(?:.*\\n\\\\)*?\\\\)[ \\t]*#\\\\+\\\\(end_src\\\\|END_SRC\\\\)\" nil t)
      (let ((lang (or (match-string 2) \"\"))
            (code (match-string 3)))
        (replace-match (format \"\\\\\\\\begin{fncode}[%s]\\n%s\\\\\\\\end{fncode}\" lang code) t t)))
    
    ;; Convert inline code
    (goto-char (point-min))
    (while (re-search-forward \"~\\\\([^~\\n]+\\\\)~\" nil t)
      (replace-match \"\\\\\\\\fnc{\\\\1}\" t nil))
    (goto-char (point-min))
    (while (re-search-forward \"=\\\\([^=\\n]+\\\\)=\" nil t)
      (replace-match \"\\\\\\\\fnc{\\\\1}\" t nil))
    
    ;; Convert footnote references
    (goto-char (point-min))
    (while (re-search-forward \"\\\\[fn:\\\\([^]]+\\\\)\\\\]\" nil t)
      (replace-match \"\\\\\\\\rfnmark{B}\" t t))
    
    (buffer-string)))

(defun my/richfn--convert-org-tables-latex ()
  \"Convert all org tables in buffer to LaTeX.\"
  (goto-char (point-min))
  (while (re-search-forward \"^[ \\t]*|\" nil t)
    (let ((table-start (line-beginning-position))
          (rows nil)
          (col-count 0)
          (caption nil))
      ;; Check for caption above table
      (save-excursion
        (forward-line -1)
        (when (looking-at \"^[ \\t]*#\\\\+\\\\(CAPTION\\\\|caption\\\\):[ \\t]*\\\\(.*\\\\)$\")
          (setq caption (match-string 2))
          (setq table-start (line-beginning-position))))
      ;; Parse table rows
      (goto-char table-start)
      (when caption (forward-line 1))
      (while (looking-at \"^[ \\t]*|\\\\(.*\\\\)|[ \\t]*$\")
        (let* ((line (match-string 1))
               (cells (split-string line \"|\"))
               (is-sep (and cells (string-match-p \"^[-+]+$\" (string-trim (car cells))))))
          (unless is-sep
            (setq col-count (max col-count (length cells)))
            (push (mapcar #'string-trim cells) rows)))
        (forward-line 1))
      (let ((table-end (point)))
        (setq rows (nreverse rows))
        ;; Build LaTeX table
        (let ((latex
               (concat
                (if caption
                    (format \"\\\\begin{fntab}{|%s|}[%s]\\n\"
                            (mapconcat (lambda (_) \"l\") (number-sequence 1 col-count) \"|\")
                            caption)
                  (format \"\\\\begin{fntab}{|%s|}\\n\"
                          (mapconcat (lambda (_) \"l\") (number-sequence 1 col-count) \"|\")))
                \"\\\\hline\\n\"
                (mapconcat
                 (lambda (row)
                   (concat (mapconcat #'identity row \" & \") \" \\\\\\\\\"))
                 rows
                 \"\\n\")
                \"\\n\\\\hline\\n\\\\end{fntab}\\n\")))
          (delete-region table-start table-end)
          (goto-char table-start)
          (insert latex))))))

(defun my/richfn--org-to-typst (text)
  \"Convert org TEXT to Typst for footnote.\"
  (with-temp-buffer
    (insert text)
    
    ;; Process nested RICHFN blocks
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+BEGIN_RICHFN[ \\t]+\\\\([^ \\t\\n]+\\\\)\" nil t)
      (let* ((nested-start (line-beginning-position))
             (content-start (1+ (line-end-position)))
             (depth 1)
             (nested-end nil)
             (content-end nil))
        (while (and (> depth 0)
                    (re-search-forward \"^[ \\t]*#\\\\+\\\\(BEGIN\\\\|END\\\\)_RICHFN\" nil t))
          (if (string= (match-string 1) \"BEGIN\")
              (setq depth (1+ depth))
            (setq depth (1- depth))
            (when (= depth 0)
              (setq content-end (line-beginning-position))
              (setq nested-end (1+ (line-end-position))))))
        (when nested-end
          (let* ((nested-content (buffer-substring-no-properties content-start content-end))
                 (converted (my/richfn--org-to-typst nested-content)))
            (delete-region nested-start nested-end)
            (goto-char nested-start)
            (insert (format \"#footnote[%s]\" converted))))))
    
    ;; Convert headings
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\(\\\\*+\\\\) \\\\(.*\\\\)$\" nil t)
      (let ((level (min 20 (length (match-string 1))))
            (title (match-string 2)))
        (replace-match (format \"#fnh(%d)[%s]\" level title) t t)))
    
    ;; Lists work natively in Typst
    
    ;; Convert tables
    (goto-char (point-min))
    (my/richfn--convert-org-tables-typst)
    
    ;; Convert code blocks
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+\\\\(begin_src\\\\|BEGIN_SRC\\\\)\\\\(?: \\\\([^ \\t\\n]+\\\\)\\\\)?[^\\n]*\\n\\\\(\\\\(?:.*\\n\\\\)*?\\\\)[ \\t]*#\\\\+\\\\(end_src\\\\|END_SRC\\\\)\" nil t)
      (let ((lang (or (match-string 2) \"\"))
            (code (string-trim-right (match-string 3))))
        (if (string= lang \"\")
            (replace-match (format \"#fn-code[```\\n%s```]\" code) t t)
          (replace-match (format \"#fn-code(lang: \\\"%s\\\")[```%s\\n%s```]\" lang lang code) t t))))
    
    ;; Convert inline code
    (goto-char (point-min))
    (while (re-search-forward \"~\\\\([^~\\n]+\\\\)~\" nil t)
      (replace-match \"`\\\\1`\" t nil))
    (goto-char (point-min))
    (while (re-search-forward \"=\\\\([^=\\n]+\\\\)=\" nil t)
      (replace-match \"`\\\\1`\" t nil))
    
    ;; Convert footnote references
    (goto-char (point-min))
    (while (re-search-forward \"\\\\[fn:\\\\([^]]+\\\\)\\\\]\" nil t)
      (replace-match \"#footnote[]\" t t))
    
    (buffer-string)))

(defun my/richfn--convert-org-tables-typst ()
  \"Convert all org tables in buffer to Typst.\"
  (goto-char (point-min))
  (while (re-search-forward \"^[ \\t]*|\" nil t)
    (let ((table-start (line-beginning-position))
          (rows nil)
          (col-count 0)
          (caption nil))
      ;; Check for caption
      (save-excursion
        (forward-line -1)
        (when (looking-at \"^[ \\t]*#\\\\+\\\\(CAPTION\\\\|caption\\\\):[ \\t]*\\\\(.*\\\\)$\")
          (setq caption (match-string 2))
          (setq table-start (line-beginning-position))))
      ;; Parse rows
      (goto-char table-start)
      (when caption (forward-line 1))
      (while (looking-at \"^[ \\t]*|\\\\(.*\\\\)|[ \\t]*$\")
        (let* ((line (match-string 1))
               (cells (split-string line \"|\"))
               (is-sep (and cells (string-match-p \"^[-+]+$\" (string-trim (car cells))))))
          (unless is-sep
            (setq col-count (max col-count (length cells)))
            (push (mapcar #'string-trim cells) rows)))
        (forward-line 1))
      (let ((table-end (point)))
        (setq rows (nreverse rows))
        (let ((typst
               (concat
                (if caption
                    (format \"#fn-table(caption: \\\"%s\\\",\\n  columns: %d,\\n\" caption col-count)
                  (format \"#fn-table(\\n  columns: %d,\\n\" col-count))
                (mapconcat
                 (lambda (row)
                   (mapconcat (lambda (cell) (format \"  [%s],\" cell)) row \"\\n\"))
                 rows
                 \"\\n\")
                \"\\n)\\n\")))
          (delete-region table-start table-end)
          (goto-char table-start)
          (insert typst))))))

(defun my/richfn--org-to-context (text)
  \"Convert org TEXT to ConTeXt for footnote.\"
  (with-temp-buffer
    (insert text)
    
    ;; Process nested RICHFN blocks
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+BEGIN_RICHFN[ \\t]+\\\\([^ \\t\\n]+\\\\)\" nil t)
      (let* ((nested-start (line-beginning-position))
             (content-start (1+ (line-end-position)))
             (depth 1)
             (nested-end nil)
             (content-end nil))
        (while (and (> depth 0)
                    (re-search-forward \"^[ \\t]*#\\\\+\\\\(BEGIN\\\\|END\\\\)_RICHFN\" nil t))
          (if (string= (match-string 1) \"BEGIN\")
              (setq depth (1+ depth))
            (setq depth (1- depth))
            (when (= depth 0)
              (setq content-end (line-beginning-position))
              (setq nested-end (1+ (line-end-position))))))
        (when nested-end
          (let* ((nested-content (buffer-substring-no-properties content-start content-end))
                 (converted (my/richfn--org-to-context nested-content)))
            (delete-region nested-start nested-end)
            (goto-char nested-start)
            (insert (format \"\\\\startRFNB %s \\\\stopRFNB\" converted))))))
    
    ;; Convert headings
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\(\\\\*+\\\\) \\\\(.*\\\\)$\" nil t)
      (let ((level (min 20 (length (match-string 1))))
            (title (match-string 2)))
        (replace-match (format \"\\\\\\\\fnh{%d}{%s}\" level title) t t)))
    
    ;; Convert lists
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\([ \\t]*\\\\)[-+] \\\\(.*\\\\)$\" nil t)
      (replace-match \"\\\\1\\\\\\\\item \\\\2\" t nil))
    
    ;; Wrap items
    (goto-char (point-min))
    (while (re-search-forward \"\\\\(^[ \\t]*\\\\\\\\item [^\\n]*\\n\\\\)+\" nil t)
      (let ((items (match-string 0))
            (start (match-beginning 0))
            (end (match-end 0)))
        (delete-region start end)
        (goto-char start)
        (insert \"\\\\startitemize[packed]\\n\" items \"\\\\stopitemize\\n\")))
    
    ;; Convert tables
    (goto-char (point-min))
    (my/richfn--convert-org-tables-context)
    
    ;; Convert code blocks
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+\\\\(begin_src\\\\|BEGIN_SRC\\\\)\\\\(?: \\\\([^ \\t\\n]+\\\\)\\\\)?[^\\n]*\\n\\\\(\\\\(?:.*\\n\\\\)*?\\\\)[ \\t]*#\\\\+\\\\(end_src\\\\|END_SRC\\\\)\" nil t)
      (let ((code (match-string 3)))
        (replace-match (format \"\\\\\\\\startfncode\\n%s\\\\\\\\stopfncode\" code) t t)))
    
    ;; Convert inline code
    (goto-char (point-min))
    (while (re-search-forward \"~\\\\([^~\\n]+\\\\)~\" nil t)
      (replace-match \"\\\\\\\\fnc{\\\\1}\" t nil))
    (goto-char (point-min))
    (while (re-search-forward \"=\\\\([^=\\n]+\\\\)=\" nil t)
      (replace-match \"\\\\\\\\fnc{\\\\1}\" t nil))
    
    ;; Convert footnote references
    (goto-char (point-min))
    (while (re-search-forward \"\\\\[fn:\\\\([^]]+\\\\)\\\\]\" nil t)
      (replace-match \"\\\\\\\\RFNB{}\" t t))
    
    (buffer-string)))

(defun my/richfn--convert-org-tables-context ()
  \"Convert all org tables in buffer to ConTeXt.\"
  (goto-char (point-min))
  (while (re-search-forward \"^[ \\t]*|\" nil t)
    (let ((table-start (line-beginning-position))
          (rows nil)
          (col-count 0)
          (caption nil))
      ;; Check for caption
      (save-excursion
        (forward-line -1)
        (when (looking-at \"^[ \\t]*#\\\\+\\\\(CAPTION\\\\|caption\\\\):[ \\t]*\\\\(.*\\\\)$\")
          (setq caption (match-string 2))
          (setq table-start (line-beginning-position))))
      ;; Parse rows
      (goto-char table-start)
      (when caption (forward-line 1))
      (while (looking-at \"^[ \\t]*|\\\\(.*\\\\)|[ \\t]*$\")
        (let* ((line (match-string 1))
               (cells (split-string line \"|\"))
               (is-sep (and cells (string-match-p \"^[-+]+$\" (string-trim (car cells))))))
          (unless is-sep
            (setq col-count (max col-count (length cells)))
            (push (mapcar #'string-trim cells) rows)))
        (forward-line 1))
      (let ((table-end (point)))
        (setq rows (nreverse rows))
        (let ((context
               (concat
                (when caption (format \"{\\\\bf %s}\\\\blank[small]\\n\" caption))
                (format \"\\\\starttabulate[|%s|]\\n\"
                        (mapconcat (lambda (_) \"l\") (number-sequence 1 col-count) \"|\"))
                (mapconcat
                 (lambda (row)
                   (concat \"\\\\NC \" (mapconcat #'identity row \" \\\\NC \") \" \\\\NC\\\\NR\"))
                 rows
                 \"\\n\")
                \"\\n\\\\stoptabulate\\n\")))
          (delete-region table-start table-end)
          (goto-char table-start)
          (insert context))))))

(defun my/richfn--org-to-html (text)
  \"Convert org TEXT to HTML for footnote.\"
  (with-temp-buffer
    (insert text)
    
    ;; Process nested RICHFN blocks
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+BEGIN_RICHFN[ \\t]+\\\\([^ \\t\\n]+\\\\)\" nil t)
      (let* ((nested-start (line-beginning-position))
             (content-start (1+ (line-end-position)))
             (depth 1)
             (nested-end nil)
             (content-end nil))
        (while (and (> depth 0)
                    (re-search-forward \"^[ \\t]*#\\\\+\\\\(BEGIN\\\\|END\\\\)_RICHFN\" nil t))
          (if (string= (match-string 1) \"BEGIN\")
              (setq depth (1+ depth))
            (setq depth (1- depth))
            (when (= depth 0)
              (setq content-end (line-beginning-position))
              (setq nested-end (1+ (line-end-position))))))
        (when nested-end
          (let* ((nested-content (buffer-substring-no-properties content-start content-end))
                 (converted (my/richfn--org-to-html nested-content)))
            (delete-region nested-start nested-end)
            (goto-char nested-start)
            (insert (format \"<span class=\\\"nested-footnote\\\">%s</span>\" converted))))))
    
    ;; Convert headings
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\(\\\\*+\\\\) \\\\(.*\\\\)$\" nil t)
      (let ((level (min 6 (length (match-string 1))))
            (title (match-string 2)))
        (replace-match (format \"<h%d>%s</h%d>\" level title level) t t)))
    
    ;; Convert lists
    (goto-char (point-min))
    (while (re-search-forward \"^\\\\([ \\t]*\\\\)[-+] \\\\(.*\\\\)$\" nil t)
      (replace-match \"\\\\1<li>\\\\2</li>\" t nil))
    
    (goto-char (point-min))
    (while (re-search-forward \"\\\\(<li>.*</li>\\n\\\\)+\" nil t)
      (let ((items (match-string 0))
            (start (match-beginning 0))
            (end (match-end 0)))
        (delete-region start end)
        (goto-char start)
        (insert \"<ul>\\n\" items \"</ul>\\n\")))
    
    ;; Convert tables
    (goto-char (point-min))
    (my/richfn--convert-org-tables-html)
    
    ;; Convert code blocks
    (goto-char (point-min))
    (while (re-search-forward \"^[ \\t]*#\\\\+\\\\(begin_src\\\\|BEGIN_SRC\\\\)\\\\(?: \\\\([^ \\t\\n]+\\\\)\\\\)?[^\\n]*\\n\\\\(\\\\(?:.*\\n\\\\)*?\\\\)[ \\t]*#\\\\+\\\\(end_src\\\\|END_SRC\\\\)\" nil t)
      (let ((lang (or (match-string 2) \"\"))
            (code (match-string 3)))
        (replace-match (format \"<pre><code class=\\\"language-%s\\\">%s</code></pre>\" lang code) t t)))
    
    ;; Convert inline code
    (goto-char (point-min))
    (while (re-search-forward \"~\\\\([^~\\n]+\\\\)~\" nil t)
      (replace-match \"<code>\\\\1</code>\" t nil))
    (goto-char (point-min))
    (while (re-search-forward \"=\\\\([^=\\n]+\\\\)=\" nil t)
      (replace-match \"<code>\\\\1</code>\" t nil))
    
    (buffer-string)))

(defun my/richfn--convert-org-tables-html ()
  \"Convert all org tables in buffer to HTML.\"
  (goto-char (point-min))
  (while (re-search-forward \"^[ \\t]*|\" nil t)
    (let ((table-start (line-beginning-position))
          (rows nil)
          (caption nil))
      ;; Check for caption
      (save-excursion
        (forward-line -1)
        (when (looking-at \"^[ \\t]*#\\\\+\\\\(CAPTION\\\\|caption\\\\):[ \\t]*\\\\(.*\\\\)$\")
          (setq caption (match-string 2))
          (setq table-start (line-beginning-position))))
      ;; Parse rows
      (goto-char table-start)
      (when caption (forward-line 1))
      (while (looking-at \"^[ \\t]*|\\\\(.*\\\\)|[ \\t]*$\")
        (let* ((line (match-string 1))
               (cells (split-string line \"|\"))
               (is-sep (and cells (string-match-p \"^[-+]+$\" (string-trim (car cells))))))
          (unless is-sep
            (push (mapcar #'string-trim cells) rows)))
        (forward-line 1))
      (let ((table-end (point)))
        (setq rows (nreverse rows))
        (let ((html
               (concat
                \"<table>\\n\"
                (when caption (format \"<caption>%s</caption>\\n\" caption))
                (mapconcat
                 (lambda (row)
                   (concat \"<tr>\"
                           (mapconcat (lambda (cell) (format \"<td>%s</td>\" cell)) row \"\")
                           \"</tr>\"))
                 rows
                 \"\\n\")
                \"\\n</table>\\n\")))
          (delete-region table-start table-end)
          (goto-char table-start)
          (insert html))))))

(defun my/richfn--get-converter (backend)
  \"Get converter function for BACKEND.\"
  (pcase backend
    ((or 'latex 'beamer) #'my/richfn--org-to-latex)
    ('html #'my/richfn--org-to-html)
    (_ #'my/richfn--org-to-latex)))

(defun my/richfn-preprocess-buffer (backend)
  \"Preprocess rich footnotes before export to BACKEND.\"
  (my/richfn--log \"Preprocessing for backend: %s\" backend)
  
  (let ((converter (my/richfn--get-converter backend)))
    
    ;; Process explicit RICHFN blocks
    (let ((blocks (my/richfn--parse-rich-blocks)))
      (my/richfn--log \"Found %d RICHFN blocks\" (length blocks))
      (dolist (block (nreverse blocks))
        (let ((id (nth 0 block))
              (start (nth 1 block))
              (end (nth 2 block))
              (content (nth 3 block)))
          (my/richfn--log \"Processing block: %s\" id)
          (let ((converted (funcall converter content)))
            (delete-region start (1+ end))
            (save-excursion
              (goto-char (point-max))
              (insert (format \"\\n[fn:%s] %s\\n\" id converted)))))))
    
    ;; Auto-detect rich content in footnotes
    (let ((footnotes (my/richfn--get-footnote-definitions)))
      (my/richfn--log \"Checking %d footnotes\" (length footnotes))
      (dolist (fn (nreverse footnotes))
        (let ((id (nth 0 fn))
              (start (nth 1 fn))
              (end (nth 2 fn))
              (content (nth 3 fn)))
          (when (my/richfn--has-rich-content-p content)
            (my/richfn--log \"Converting footnote: %s\" id)
            (let ((converted (funcall converter content)))
              (delete-region start end)
              (goto-char start)
              (insert (format \"[fn:%s] %s\\n\" id converted)))))))))

;; Register with org export
(with-eval-after-load 'ox
  (add-hook 'org-export-before-processing-hook #'my/richfn-preprocess-buffer))
#+end_src

