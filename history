% ──────────────────────────────────────────────────────────────────────────────
\\\\setupitemize[each][margin=0pt, inbetween={}, before={}, after={}]

\\\\definestartstop[fnitemize][
  before={\\\\startitemize[packed]},
  after={\\\\stopitemize}
