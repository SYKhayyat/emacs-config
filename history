** Typst Preamble

#+begin_src emacs-lisp
(defvar my/typst-rich-footnotes-preamble
  \"// ══════════════════════════════════════════════════════════════════════════════
// RICH FOOTNOTES SYSTEM - Full document capability in footnotes
// ══════════════════════════════════════════════════════════════════════════════

// ──────────────────────────────────────────────────────────────────────────────
// HEADINGS IN FOOTNOTES (20 levels)
// ──────────────────────────────────────────────────────────────────────────────
#let fnh(level, body) = {
  let configs = (
    (size: 1.3em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 1.2em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 1.1em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 1em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 1em, weight: \\\"bold\\\", style: \\\"italic\\\"),
    (size: 1em, weight: \\\"regular\\\", style: \\\"italic\\\"),
    (size: 0.95em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 0.95em, weight: \\\"regular\\\", style: \\\"normal\\\"),
    (size: 0.9em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 0.9em, weight: \\\"regular\\\", style: \\\"italic\\\"),
    (size: 0.85em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 0.85em, weight: \\\"regular\\\", style: \\\"normal\\\"),
    (size: 0.8em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 0.8em, weight: \\\"regular\\\", style: \\\"normal\\\"),
    (size: 0.75em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 0.75em, weight: \\\"regular\\\", style: \\\"normal\\\"),
    (size: 0.7em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 0.7em, weight: \\\"regular\\\", style: \\\"normal\\\"),
    (size: 0.65em, weight: \\\"bold\\\", style: \\\"normal\\\"),
    (size: 0.65em, weight: \\\"regular\\\", style: \\\"normal\\\"),
  )
  let idx = calc.min(level - 1, 19)
  let cfg = configs.at(idx)
  block(text(size: cfg.size, weight: cfg.weight, style: cfg.style, body))
}

// Shortcuts
#let fnh1(body) = fnh(1, body)
#let fnh2(body) = fnh(2, body)
#let fnh3(body) = fnh(3, body)
#let fnh4(body) = fnh(4, body)
#let fnh5(body) = fnh(5, body)
#let fnh6(body) = fnh(6, body)
#let fnh7(body) = fnh(7, body)
#let fnh8(body) = fnh(8, body)
#let fnh9(body) = fnh(9, body)
#let fnh10(body) = fnh(10, body)

// ──────────────────────────────────────────────────────────────────────────────
// RICH FOOTNOTE (alias for clarity)
// ──────────────────────────────────────────────────────────────────────────────
#let rfn(body) = footnote(body)

// ──────────────────────────────────────────────────────────────────────────────
// TABLES WITH CAPTION IN FOOTNOTES
// ──────────────────────────────────────────────────────────────────────────────
#let fn-table-counter = counter(\\\"fn-table\\\")

#let fn-table(caption: none, ..args) = {
  fn-table-counter.step()
  block[
    #if caption != none [
      #strong[Table #fn-table-counter.display():] #caption
      #v(0.3em)
    ]
    #table(..args)
  ]
}

// ──────────────────────────────────────────────────────────────────────────────
// CODE BLOCKS IN FOOTNOTES
// ──────────────────────────────────────────────────────────────────────────────
#let fn-code(lang: none, body) = {
  block(
    fill: luma(245),
    inset: 4pt,
    radius: 2pt,
    width: 100%,
    if lang != none {
      raw(body, lang: lang, block: true)
    } else {
      raw(body, block: true)
    }
  )
}

// Inline code
#let fnc(body) = raw(body)

// ──────────────────────────────────────────────────────────────────────────────
// DESCRIPTION LIST
// ──────────────────────────────────────────────────────────────────────────────
#let fn-desc(..items) = {
  for (term, desc) in items.pos() {
    block[#strong(term): #desc]
  }
}
\"
  \"Typst preamble for rich footnotes.\")

(defun my/insert-typst-rich-footnotes-preamble ()
  \"Insert Typst rich footnotes preamble.\"
  (interactive)
  (insert my/typst-rich-footnotes-preamble)
  (message \"Typst rich footnotes preamble inserted.\"))
#+end_src

