#+begin_src emacs-lisp
  ;; Speed up rendering
  (setq auto-window-vscroll nil)
  (setq fast-but-imprecise-scrolling t)
  (setq jit-lock-defer-time 0)

  ;; Handle long lines better
  (setq-default so-long-threshold 400)
