;;; init.el --- Load modular configuration -*- lexical-binding: t; -*-

;; Add modules directory to load-path
(add-to-list 'load-path (expand-file-name "modules" user-emacs-directory))

;; Load all compiled module files in order
(let ((module-dir (expand-file-name "modules" user-emacs-directory))
      (modules '("00-core"
                 "01-ui"
                 "02-hebrew"
                 "03-completion"
                 "04-editing"
                 "05-navigation"
                 "06-org"
                 "07-org-roam"
                 "08-latex"
                 "09-typst"
                 "10-pdf"
                 "11-programming"
                 "12-magit"
                 "13-seforim"
                 "14-rich-footnotes"
                 "15-hydras"
                 "16-utils")))
  (dolist (module modules)
    (condition-case err
        (require (intern module))
      (error (message "Failed to load %s: %s" module err)))))

(message "Emacs configuration loaded!")

;;; init.el ends here
